# Environment for E2E tests (Playwright).
#
# Copy to .env.test.local and fill in real values, or export the same
# keys in CI. Do NOT commit real secrets.
#
# CLAUDE.md §22: seeded dev users follow `<role>@dev.studymind`. Passwords
# are documented in 1Password vault "StudyMind CRM Dev".

# Where Playwright points the browser. Defaults to localhost when unset.
E2E_BASE_URL=http://localhost:3000

# Skip Playwright's webServer if you already have `pnpm dev` running.
# E2E_REUSE_SERVER=1

# Seeded Clerk dev user used by the signedInPage fixture.
E2E_USER_EMAIL=agent@dev.studymind
E2E_USER_PASSWORD=

# Clerk dev instance keys (must match the seeded user's instance).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database used by the dev server during E2E. Local docker-compose default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studymind_e2e
