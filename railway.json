{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": [
    {
      "name": "web",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile",
        "buildCommand": "pnpm build --filter=web"
      },
      "deploy": {
        "startCommand": "pnpm --filter @studymind/db prisma migrate deploy && pnpm --filter web start",
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 30
      }
    },
    {
      "name": "worker",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile",
        "buildCommand": "pnpm build --filter=@studymind/jobs"
      },
      "deploy": {
        "startCommand": "pnpm --filter @studymind/jobs start"
      }
    }
  ]
}
