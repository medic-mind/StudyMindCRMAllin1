{
  "name": "studymind-crm",
  "version": "0.1.0",
  "private": true,
  "description": "StudyMind All in One CRM",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:worker": "turbo run dev:worker --filter=@studymind/jobs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:ai-live": "vitest run packages/ai/evals --config vitest.ai-live.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "pnpm --filter @studymind/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @studymind/db exec prisma db seed",
    "db:reset": "pnpm --filter @studymind/db exec prisma migrate reset --force",
    "db:studio": "pnpm --filter @studymind/db exec prisma studio",
    "db:generate": "pnpm --filter @studymind/db exec prisma generate",
    "dr": "tsx scripts/dr/run-dr.ts",
    "dr:stripe": "tsx scripts/dr/reconnect-stripe.ts",
    "dr:gocardless": "tsx scripts/dr/reconnect-gocardless.ts",
    "dr:aircall": "tsx scripts/dr/reconnect-aircall.ts",
    "dr:trengo": "tsx scripts/dr/reconnect-trengo.ts",
    "dr:slack": "tsx scripts/dr/reconnect-slack.ts",
    "dr:asana": "tsx scripts/dr/reconnect-asana.ts",
    "dr:gmail": "tsx scripts/dr/reconnect-gmail.ts",
    "dr:booking": "tsx scripts/dr/reconnect-booking.ts",
    "dr:replay": "tsx scripts/dr/replay-provider-events.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "^3.658.0",
    "@eslint/js": "^9.13.0",
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.48.0",
    "@types/archiver": "^6.0.0",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^2.1.5",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "stripe": "^17.4.0",
    "tsx": "^4.19.2",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^2.1.5",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@studymind/ai": "workspace:*",
    "@studymind/core": "workspace:*",
    "@studymind/jobs": "workspace:*"
  }
}
