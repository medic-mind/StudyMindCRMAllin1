{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "autoCompactEnabled": false,
  "skillListingBudgetFraction": 0.005,
  "skillListingMaxDescChars": 256,
  "fileCheckpointingEnabled": true,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "spinnerTipsEnabled": false,
  "autoCompactEnabled": false,
  "fileCheckpointingEnabled": true,
  "skillListingBudgetFraction": 0.005,
  "skillListingMaxDescChars": 256,
  "verbose": false,
  "env": {
    "MAX_THINKING_TOKENS": "4000",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16000",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git stash*)",
      "Bash(git config --get*)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(date*)",
      "Bash(echo*)",
      "Bash(test*)",
      "Bash(mkdir -p*)",
      "Bash(rmdir*)",
      "Bash(wc*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find*)",
      "Bash(touch*)",
      "Bash(cp -r*)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(diff*)",
      "Bash(jq*)",
      "Bash(node -v)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(pnpm install*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm format*)",
      "Bash(npx prisma*)",
      "Bash(prisma*)",
      "Bash(npx tsc*)",
      "Bash(tsc --noEmit*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
