// StudyMind CRM Prisma schema.
// See CLAUDE.md Section 19 for conventions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum FamilyState {
  lead
  trial
  active
  at_risk
  churned
}

enum BillingParty {
  family
  local_authority
}

enum SubscriptionState {
  trialing
  active
  past_due
  canceled
  unpaid
  paused
  incomplete
  incomplete_expired
  unknown
}

enum MandateState {
  pending_submission
  submitted
  active
  failed
  cancelled
  expired
  replaced
}

enum BookingState {
  tentative
  confirmed
  delivered
  no_show
  cancelled
}

enum SafeguardingFlagState {
  none
  concern_logged
  restricted_access
}

enum SafeguardingUrgency {
  routine
  urgent
  immediate
}

enum InteractionType {
  email
  call
  message
  note
  task
  payment
  booking
  ai_insight
  family_state_changed
  family_billing_contact_changed
  safeguarding_concern_raised
  safeguarding_la_referral
  slack_summary
  tender_state_changed
  system
  // Trengo ticket lifecycle (CLAUDE.md §11). Calls reuse `call`; messages
  // reuse `message`; tickets and labels get explicit values so the timeline
  // can filter on lifecycle without unpacking JSONB.
  ticket_assigned
  ticket_closed
  ticket_reopened
  label_added
  label_removed
}

enum ContactKind {
  parent
  student
  tutor
  la_caseworker
  other
}

enum UserRole {
  admin
  ops_manager
  agent
  finance
  dsl
  read_only
}

enum RefundIntentStatus {
  pending
  pending_review
  succeeded
  failed
}

enum ReconciliationCategory {
  hours_mismatch
  payment_unallocated
  late_failure
  late_failure_pending_action
  churned_with_active_subscription
  ap_review_overdue
  other
}

enum TenderState {
  identified
  drafting
  submitted
  shortlisted
  awarded
  rejected
  withdrawn
}

enum TaskStatus {
  open
  in_progress
  blocked
  done
  cancelled
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id          String  @id
  clerkUserId String  @unique
  email       String  @unique
  name        String?
  isActive    Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  roleAssignments RoleAssignment[]

  @@index([email])
}

model RoleAssignment {
  id     String   @id
  userId String
  role   UserRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

// -----------------------------------------------------------------------------
// Contacts and Families
// -----------------------------------------------------------------------------

model Contact {
  id          String      @id
  kind        ContactKind
  firstName   String?
  lastName    String?
  email       String?
  phoneE164   String?
  dateOfBirth DateTime?
  isMinor     Boolean     @default(false)
  notes       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  familyMembers     FamilyMember[]
  billingForFamily  Family[]           @relation("BillingContact")
  interactions      Interaction[]      @relation("ContactInteractions")
  safeguardingFlags SafeguardingFlag[]
  encryptedFields   EncryptedField[]

  @@index([email])
  @@index([phoneE164])
  @@index([kind])
}

model Family {
  id               String       @id
  name             String?
  state            FamilyState  @default(lead)
  billingParty     BillingParty @default(family)
  billingContactId String?
  laContractId     String?
  churnScore       Float?
  lastBookingSyncAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  billingContact   Contact?                    @relation("BillingContact", fields: [billingContactId], references: [id])
  laContract       LAContract?                 @relation(fields: [laContractId], references: [id])
  members          FamilyMember[]
  financialAccount FinancialAccount?
  interactions     Interaction[]               @relation("FamilyInteractions")
  bookings         Booking[]
  subscriptions    StripeSubscription[]
  stripeCustomers  StripeCustomer[]
  mandates         GcMandate[]
  invoices         Invoice[]
  payments         Payment[]
  discrepancies    ReconciliationDiscrepancy[]
  tasks            Task[]

  @@index([state])
  @@index([billingContactId])
  @@index([laContractId])
}

model FamilyMember {
  id        String @id
  familyId  String
  contactId String
  role      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([familyId, contactId])
  @@index([contactId])
}

model FinancialAccount {
  id       String @id
  familyId String @unique
  status   String @default("ok")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Interactions (the timeline)
// -----------------------------------------------------------------------------

model Interaction {
  id         String          @id
  type       InteractionType
  contactId  String?
  familyId   String?
  occurredAt DateTime
  summary    String?
  payload    Json

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contact Contact? @relation("ContactInteractions", fields: [contactId], references: [id])
  family  Family?  @relation("FamilyInteractions", fields: [familyId], references: [id])

  @@index([contactId, occurredAt])
  @@index([familyId, occurredAt])
  @@index([type, occurredAt])
}

// -----------------------------------------------------------------------------
// Provider events and audit
// -----------------------------------------------------------------------------

model ProviderEvent {
  id          String    @id
  provider    String
  eventId     String
  type        String
  raw         Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([provider, type])
}

model AuditLogEntry {
  id         String   @id
  action     String
  actorId    String?
  targetType String
  targetId   String
  requestId  String?
  purpose    String?
  before     Json?
  after      Json?
  occurredAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
}

model RetentionPolicy {
  id            String  @id
  scope         String
  retentionDays Int
  contractId    String?
  notes         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// Safeguarding
// -----------------------------------------------------------------------------

model SafeguardingFlag {
  id         String                @id
  contactId  String
  state      SafeguardingFlagState @default(concern_logged)
  urgency    SafeguardingUrgency   @default(routine)
  dslUserId  String?
  raisedById String?
  closedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([state])
  @@index([dslUserId])
}

model EncryptedField {
  id            String @id
  contactId     String
  column        String
  ciphertext    Bytes
  iv            Bytes
  dekCiphertext Bytes
  aad           Bytes
  keyVersion    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, column])
}

// -----------------------------------------------------------------------------
// Bookings
// -----------------------------------------------------------------------------

model Booking {
  id              String       @id
  familyId        String
  externalId      String       @unique
  state           BookingState @default(tentative)
  contractedHours Int          @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sessions    BookingSession[]
  allocations Allocation[]

  @@index([familyId])
  @@index([state])
}

model BookingSession {
  id              String       @id
  bookingId       String
  externalId      String       @unique
  scheduledAt     DateTime
  state           BookingState @default(tentative)
  hours           Int          @default(0)
  contractedHours Int          @default(0)
  scheduledHours  Int          @default(0)
  deliveredHours  Int          @default(0)
  correctedById   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  correctedBy BookingSession?  @relation("Correction", fields: [correctedById], references: [id])
  corrections BookingSession[] @relation("Correction")

  @@index([bookingId, scheduledAt])
  @@index([state])
}

// -----------------------------------------------------------------------------
// Finance
// -----------------------------------------------------------------------------

model StripeCustomer {
  id               String @id
  familyId         String
  stripeCustomerId String @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model StripeSubscription {
  id               String            @id
  familyId         String
  stripeId         String            @unique
  state            SubscriptionState @default(unknown)
  currentPeriodEnd DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([state])
}

model GcMandate {
  id           String       @id
  familyId     String
  gcMandateId  String       @unique
  state        MandateState @default(pending_submission)
  replacedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  replacedBy GcMandate?  @relation("MandateChain", fields: [replacedById], references: [id])
  replaces   GcMandate[] @relation("MandateChain")

  @@index([familyId])
  @@index([state])
}

model Invoice {
  id          String    @id
  familyId    String
  externalId  String    @unique
  amountMinor Int
  currency    String    @default("GBP")
  issuedAt    DateTime
  dueAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([familyId])
}

model Payment {
  id          String    @id
  familyId    String
  invoiceId   String?
  externalId  String    @unique
  provider    String
  amountMinor Int
  currency    String    @default("GBP")
  receivedAt  DateTime
  confirmedAt DateTime?
  reverted    Boolean   @default(false)
  revertedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  allocations   Allocation[]
  refundIntents RefundIntent[]

  @@index([familyId])
  @@index([provider])
}

model Allocation {
  id          String @id
  paymentId   String
  bookingId   String
  amountMinor Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([bookingId])
}

model RefundIntent {
  id             String             @id
  paymentId      String
  amountMinor    Int
  reasonCode     String
  status         RefundIntentStatus @default(pending)
  idempotencyKey String             @unique
  externalId     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model ReconciliationDiscrepancy {
  id           String                 @id
  familyId     String
  category     ReconciliationCategory
  summary      String
  payload      Json
  contextHash  String
  resolvedAt   DateTime?
  resolvedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, category, contextHash])
  @@index([familyId])
  @@index([category])
  @@index([resolvedAt])
}

// -----------------------------------------------------------------------------
// Leads, tasks, tenders, LA
// -----------------------------------------------------------------------------

model Lead {
  id                   String  @id
  source               String
  rawPayload           Json
  email                String?
  phoneE164            String?
  name                 String?
  convertedToContactId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([email])
  @@index([phoneE164])
}

model Task {
  id          String     @id
  title       String
  description String?
  status      TaskStatus @default(open)
  assigneeId  String?
  familyId    String?
  dueAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family? @relation(fields: [familyId], references: [id])

  @@index([assigneeId, status])
  @@index([familyId])
}

model Tender {
  id                 String      @id
  name               String
  laName             String
  state              TenderState @default(identified)
  ownerUserId        String?
  contractValueMinor Int?
  submittedAt        DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contracts LAContract[]

  @@index([state])
}

model LAContract {
  id                 String    @id
  tenderId           String?
  laName             String
  reference          String    @unique
  contractValueMinor Int
  startDate          DateTime
  endDate            DateTime?
  hoursEnvelope      Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  tender   Tender?     @relation(fields: [tenderId], references: [id])
  families Family[]
  invoices LAInvoice[]

  @@index([laName])
}

model LAInvoice {
  id          String    @id
  contractId  String
  reference   String    @unique
  amountMinor Int
  issuedAt    DateTime
  paidAt      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contract LAContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

// -----------------------------------------------------------------------------
// GoCardless mandate creation flow
// -----------------------------------------------------------------------------

model MandateIntent {
  id                 String  @id
  familyId           String
  billingContactId   String
  idempotencyKey     String  @unique
  redirectFlowId     String?
  redirectUrl        String?
  status             String  @default("pending")
  // Resolved GoCardless mandate id once the redirect flow completes.
  gcMandateId        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([billingContactId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Trengo per-agent OAuth tokens (CLAUDE.md §11).
// Each agent's outbound goes through their own Trengo API token, KMS-
// encrypted at rest. Expiry is enforced fail-closed in outbound.ts.
// -----------------------------------------------------------------------------

model TrengoToken {
  /// Clerk user id (== User.id). One token per agent.
  agentId         String   @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Feature flags
// -----------------------------------------------------------------------------

model FeatureFlag {
  id          String  @id
  key         String  @unique
  enabled     Boolean @default(false)
  description String?
  payload     Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// DSL rota (CLAUDE.md §42).
// One primary + one deputy per ISO week; raiseConcern resolves the on-duty
// DSL from this table at runtime. Empty rota → DEFAULT_DSL_USER_ID env.
// -----------------------------------------------------------------------------

enum DslRotaRole {
  primary
  deputy
}

model DslRota {
  id        String      @id
  userId    String
  weekStart DateTime
  weekEnd   DateTime
  role      DslRotaRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([weekStart, role])
  @@index([userId])
}
