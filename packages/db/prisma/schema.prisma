  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([familyId])
}

model Payment {
  id          String    @id
  familyId    String
  invoiceId   String?
  externalId  String    @unique
  provider    String
  amountMinor Int
  currency    String    @default("GBP")
  receivedAt  DateTime
