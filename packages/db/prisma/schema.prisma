// Teams — internal ops squads. Tasks can be assigned to a team in addition
// to (or instead of) a person. CEO + Senior Manager manage membership.
// -----------------------------------------------------------------------------

model Team {
  id          String  @id
  name        String  @unique
  color       String?
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  members TeamMember[]
  tasks   Task[]

  @@index([archivedAt])
}

model TeamMember {
  id        String @id
  teamId    String
  userId    String

  createdAt   DateTime @default(now())
  createdById String?

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Forwarding rules — configurable "Forward to <team>" quick actions on a
// contact. Each rule defines the recipients (to/cc/bcc) and the subject + body
// templates. Manager+ manages the catalogue; Sales Executive+ triggers sends.
// CLAUDE.md §20.1.
// -----------------------------------------------------------------------------

model ForwardingRule {
  id              String   @id
  // Stable identifier surfaced to code paths that need to refer to a rule by
  // name (defaults are seeded with keys like `ap_team`, `ceos`, `schools`).
  key             String   @unique
  label           String
  description     String?
  toAddresses     String[]
  ccAddresses     String[] @default([])
  bccAddresses    String[] @default([])
  subjectTemplate String
  bodyTemplate    String
  sortOrder       Int      @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  @@index([archivedAt])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// Call summary templates — admin-managed prefill templates for the contact
// page Call Summary panel (UCAT call, Medical Interview call, Dental
// Interview call, etc). Optionally carries an attached PDF (stored inline
// as bytes, same trade-off as ContactDocument / BrandingSetting per
// CLAUDE.md §4) which the caller can open while running the script. Manager+
// manages the catalogue; everyone reads.
// -----------------------------------------------------------------------------

model CallSummaryTemplate {
  id          String   @id
  name        String   @unique
  description String?
  /// The body shown in the textarea when the agent picks this template.
  /// Free-form markdown-ish text — same shape as the existing hardcoded
  /// quick-start fragments.
  body        String
  sortOrder   Int      @default(0)

  // Optional attached PDF. Same byte-storage approach as ContactDocument
  // and BrandingSetting — keeps self-hosted deploys S3-free. `pdfData` is
  // null when there's no attachment; the four fields are written together.
  pdfFileName    String?
  pdfContentType String?
  pdfByteSize    Int?
  pdfData        Bytes?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  @@index([archivedAt])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// B2B accounts — schools and partnership organisations we work with. Tracked
// as first-class records (name, contact info, lifecycle status, address,
// notes) with a many-to-many to Contact so each touch-point on the account
// (head teacher, SENCo, finance lead, partner manager…) lives as a normal
// Contact and surfaces on the account detail page.
//
// Mirrors the shape of `Company` (sister-brand tag) but for outward-facing
// B2B relationships. Manager+ manages the catalogue; everyone can view.
// -----------------------------------------------------------------------------

enum BusinessAccountKind {
  school
  partnership
}

enum BusinessAccountStatus {
  prospect
  active
  paused
  churned
}

model BusinessAccount {
  id          String              @id
  kind        BusinessAccountKind
  name        String
  /// URL-safe handle (e.g. `oakwood-primary`, `acme-tutors`). Unique per kind.
  slug        String
  /// #RRGGBB. Drives the chip + dot in the UI.
  color       String?
  description String?
  status      BusinessAccountStatus @default(prospect)

  // B2B coordinates — optional; the account may exist before we have full
  // contact details. Email + phone are the primary org-level points; for
  // per-person details, link a Contact via BusinessAccountContact.
  contactEmail String?
  contactPhone String?
  website      String?

  // Address — same shape as Contact for consistency.
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  country      String?

  notes String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  contacts         BusinessAccountContact[]
  students         BusinessAccountStudent[]
  uploadedInvoices UploadedInvoice[]
  companies        BusinessAccountCompany[]
  /// Mirror of customers on the B2B Invoices Platform (b2b.studymind.co.uk)
  /// that correlate to this account (schools, partnerships, AP/council).
  invoicingCustomers InvoicingCustomer[]

  @@unique([kind, slug])
  @@index([kind])
  @@index([status])
  @@index([archivedAt])
}

/// Many-to-many: BusinessAccount ↔ Company (sister-brand tag). Mirrors
/// the ContactCompany shape so a school / partnership can be tagged with
/// every brand it works under (Medic Mind + Oxbridge Mind, etc).
model BusinessAccountCompany {
  accountId String
  companyId String

  createdAt   DateTime @default(now())
  createdById String?

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([accountId, companyId])
  @@index([companyId])
}

/// Many-to-many join: BusinessAccount ↔ Contact. The optional `role` text is
/// the contact's role at the account (e.g. "Head teacher", "SENCo",
/// "Finance contact", "Programme lead"). One row per link.
model BusinessAccountContact {
  accountId String
  contactId String
  role      String?

  createdAt   DateTime @default(now())
  createdById String?

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([accountId, contactId])
  @@index([contactId])
}

/// Students enrolled at a BusinessAccount (school / partnership) — what
/// they're getting from us. Each row is one (account, student-name) pair,
/// not a CRM Contact, so accounts can track cohorts without dragging every
/// pupil into the contact database. Hours are split into `contracted` and
/// `delivered`; the delivered figure is the column the booking site sync
/// will write into when wired (see `bookingStudentId` / `bookingLastSyncAt`).
model BusinessAccountStudent {
  id        String @id
  accountId String

  firstName  String
  lastName   String?
  yearGroup  String?
  dateOfBirth DateTime?

  /// What the student is getting — free-form text (e.g. "UCAT prep — 10
  /// sessions", "Medical interview package", "Maths weekly tutoring").
  program            String?
  /// Hours contracted under the current programme.
  hoursContracted    Int?
  /// Hours delivered — synced from booking.studymind.co.uk when the
  /// integration is live. Manually editable until then.
  hoursDelivered     Int?
  startDate          DateTime?
  endDate            DateTime?
  status             BusinessAccountStudentStatus @default(active)

  /// Free-form text. Subjects + notes for at-a-glance triage.
  subjects String?
  notes    String?

  /// Booking site cross-reference. Populated once we hook up the
  /// booking.studymind.co.uk pull (CLAUDE.md §15). Sync writes
  /// `hoursDelivered` + `bookingLastSyncAt`; manual edits remain possible.
  bookingStudentId   String?
  bookingLastSyncAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([archivedAt])
  @@index([bookingStudentId])
}

enum BusinessAccountStudentStatus {
  active
  paused
  completed
  withdrawn
}

// -----------------------------------------------------------------------------
// Uploaded invoices — manually uploaded invoice files attached to a
// BusinessAccount (B2B / Schools / Partners) OR a Family (normal customer)
// OR a Contact (lead / one-off). Different from the auto-mirrored `Invoice`
// table above which tracks Stripe / GoCardless reconciliation rows.
//
// The file lives inline as bytes (same trade-off as ContactDocument and
// CallSummaryTemplate per CLAUDE.md §4 — self-hosted installs need no S3).
// Cross-app connectivity with b2b.studymind.co.uk is a future extension;
// today this is the canonical place to drop a PDF and tag it.
// -----------------------------------------------------------------------------

enum UploadedInvoiceStatus {
  draft
  sent
  paid
  overdue
  void
}

model UploadedInvoice {
  id String @id

  // Polymorphic owner — exactly one of the three FKs is set. A DB check
  // constraint enforces that in the migration; the tRPC layer enforces
  // it at write time.
  businessAccountId String?
  contactId         String?
  familyId          String?

  invoiceNumber String?
  amountMinor   Int?
  currency      String                @default("GBP")
  issuedAt      DateTime?
  dueAt         DateTime?
  status        UploadedInvoiceStatus @default(draft)
  notes         String?

  // File payload — required.
  fileName    String
  contentType String
  byteSize    Int
  data        Bytes

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  businessAccount BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  family          Family?          @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([businessAccountId])
  @@index([contactId])
  @@index([familyId])
  @@index([status])
  @@index([archivedAt])
}

// -----------------------------------------------------------------------------
// GoCardless mandate creation flow
// -----------------------------------------------------------------------------

model MandateIntent {
  id               String  @id
  familyId         String
  billingContactId String
  idempotencyKey   String  @unique
  redirectFlowId   String?
  redirectUrl      String?
  status           String  @default("pending")
  // Resolved GoCardless mandate id once the redirect flow completes.
  gcMandateId      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([billingContactId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Trengo per-agent OAuth tokens (CLAUDE.md §11).
// Each agent's outbound goes through their own Trengo API token, KMS-
// encrypted at rest. Expiry is enforced fail-closed in outbound.ts.
// -----------------------------------------------------------------------------

model TrengoToken {
  /// User.id. One Trengo token per agent. (Pre-ADR-0010 this was a Clerk id.)
  agentId         String   @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Feature flags
// -----------------------------------------------------------------------------

model FeatureFlag {
  id          String  @id
  key         String  @unique
  enabled     Boolean @default(false)
  description String?
  payload     Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// Branding (CLAUDE.md §4). Optional custom logo, stored in Postgres so a
// self-hosted install needs no AWS/S3. Singleton row, id = "branding". The
// inline SVG brand mark stays as the fallback when no row exists.
// -----------------------------------------------------------------------------

model BrandingSetting {
  id              String  @id
  logoData        Bytes
  logoContentType String
  logoFileName    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// DSL rota (CLAUDE.md §42).
// One primary + one deputy per ISO week; raiseConcern resolves the on-duty
// DSL from this table at runtime. Empty rota → DEFAULT_DSL_USER_ID env.
// -----------------------------------------------------------------------------

enum DslRotaRole {
  primary
  deputy
}

model DslRota {
  id        String      @id
  userId    String
  weekStart DateTime
  weekEnd   DateTime
  role      DslRotaRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([weekStart, role])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Slice 7: Slack summary triage, Slack outbound idempotency, Asana webhook
// secrets, Gmail mailbox watch lifecycle, Gmail per-agent OAuth tokens.
// CLAUDE.md §12, §13, §14.
// -----------------------------------------------------------------------------

model UnassignedSummary {
  id           String    @id
  /// Slack message id (the `ts` field in a message event).
  slackTs      String
  channelId    String
  /// Output of the slack-summary AI prompt.
  parsed       Json
  confidence   Float
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@unique([slackTs, channelId])
  @@index([resolvedAt])
}

model SlackPost {
  /// Outbound idempotency key (CLAUDE.md §17). Repeat sends with the same
  /// key return the existing slackTs rather than double-posting.
  idempotencyKey String   @id
  slackTs        String
  channelId      String
  postedAt       DateTime @default(now())

  @@index([postedAt])
}

model AsanaWebhook {
  id            String @id
  projectId     String
  /// Secret Asana sends in the X-Hook-Secret header on creation; we echo it
  /// back to complete the handshake and store it for subsequent payload
  /// signature verification (CLAUDE.md §13).
  webhookSecret String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([projectId])
}

model GmailMailbox {
  /// cuid2. Multiple mailboxes can be connected per agent.
  id             String    @id
  /// User.id of the owning agent.
  agentId        String
  address        String    @unique
  historyId      String?
  watchExpiresAt DateTime?
  topicName      String?
  /// One mailbox per agent is the default outbound + drives Trengo/board
  /// senders. Only one row per agentId can be true at a time (app-level).
  isDefault      Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([agentId])
  @@index([watchExpiresAt])
}

// -----------------------------------------------------------------------------
// Slice 8: AI features — status summary, churn score, drift sampling.
// CLAUDE.md §18.
// -----------------------------------------------------------------------------

/// Two-line "Current Status" header for a Contact, refreshed every 30 min
/// for changed contacts. CLAUDE.md §17.1, §18. One row per contact.
model ContactStatusSummary {
  contactId     String   @id
  headerLine    String
  bodyLine      String
  generatedAt   DateTime @default(now())
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([generatedAt])
}

/// Family churn score, regenerated nightly by ai/score-churn-risk after
/// finance/reconcile.completed (CLAUDE.md §17.3). Score ∈ [0,1].
model ChurnScore {
  id            String   @id
  familyId      String
  score         Float
  drivers       Json
  rationale     String
  scoredAt      DateTime @default(now())
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, scoredAt])
}

/// 1% production sample of AI inputs/outputs for drift triage.
/// CLAUDE.md §18.3 — reviewed weekly; never store unredacted minor names
/// or full email addresses without clear need.
model DriftSample {
  id            String   @id
  task          String
  model         String
  promptVersion String
  input         Json
  output        Json
  costUsd       Float
  sampledAt     DateTime @default(now())
  reviewed      Boolean  @default(false)
  reviewerNote  String?

  @@index([task, sampledAt])
  @@index([reviewed])
}

// Audit-B2 Chunk 5: outbound Gmail send idempotency. CLAUDE.md §14.
// One row per outbound Gmail send. The unique key is (threadId, requestId)
// — replaying the same tRPC mutation must not send twice.
model OutboundEmailIntent {
  id             String   @id
  agentId        String
  threadId       String
  requestId      String
  gmailMessageId String?
  subject        String
  toAddresses    String[] @default([])
  ccAddresses    String[] @default([])
  bccAddresses   String[] @default([])
  /// pending | sent | failed
  status         String   @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([threadId, requestId])
  @@index([agentId])
  @@index([gmailMessageId])
}

// -----------------------------------------------------------------------------
// Comprehensive customer view + 90-day historic backfill (ADR 0017).
// One row per (provider, agentId) initial-connect backfill so the UI can
// surface progress, and so an idempotent re-run is safe to attempt.
// -----------------------------------------------------------------------------

enum BackfillProvider {
  gmail
  aircall
  trengo
  slack
}

enum BackfillJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

model BackfillJob {
  id              String            @id
  provider        BackfillProvider
  /// Null for shared-token providers (Aircall, Slack). For per-agent
  /// providers (Gmail, Trengo) this is the User.id whose token drives the
  /// backfill.
  agentId         String?
  windowFrom      DateTime
  windowTo        DateTime
  status          BackfillJobStatus @default(pending)
  /// Optional grand-total (set by the worker once it has a count from the
  /// provider — `null` while we are still discovering pages).
  totalCount      Int?
  processedCount  Int               @default(0)
  matchedCount    Int               @default(0)
  skippedCount    Int               @default(0)
  /// Provider-side cursor for resumability across step retries.
  lastEventId     String?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  @@index([provider, agentId, status])
  @@index([status, createdAt])
}

model GmailToken {
  /// User.id. Legacy refresh-token table; ADR 0012 migrated active rows to
  /// EncryptedField via User.gmailRefreshTokenCipherId. Kept for fallback.
  agentId         String    @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
}

// -----------------------------------------------------------------------------
// B2B Invoices Platform sync (b2b.studymind.co.uk). Live two-way mirror.
//
// We push writes via REST and receive changes via webhooks + SSE + a nightly
// events-feed reconcile. Every mirror row dedupes on the invoicing-side id
// (`invoicingId`) so all three inbound channels converge idempotently
// (CLAUDE.md §2 idempotency, §6 correlation, §19 money in minor units).
// -----------------------------------------------------------------------------

/// Customer categories on the invoicing platform ("partners" table). CRM
/// schools/partnerships map to `b2b`, individuals to `b2c`, AP/council to
/// `alt_provision`. Unknown values fail closed to `unknown` (CLAUDE.md §8).
enum InvoicingCustomerCategory {
  b2b
  b2c
  alt_provision
  unknown
}

enum InvoicingCustomerStatus {
  active
  on_hold
  archived
  unknown
}

enum InvoicingInvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
  unknown
}

enum InvoicingClientType {
  uk_b2b
  school
  summer_school
  international
  unknown
}

/// Mirror of a customer on the invoicing platform. `invoicingId` is the dedup
/// key for every inbound channel. CRM correlation is via an optional
/// BusinessAccount (schools/partnerships/AP) or Contact (B2C individuals).
model InvoicingCustomer {
  id          String @id
  invoicingId String @unique

  category       InvoicingCustomerCategory @default(unknown)
  status         InvoicingCustomerStatus   @default(unknown)
  companyName    String
  contactName    String?
  contactEmail   String?
  contactEmailCc String?
  phone          String?
  address        String?
  country        String?
  vatNumber      String?
  service        String?
  tags           String[] @default([])
  notes          String?

  /// CRM correlation — at most one is set. Set on lookup-or-create so the two
  /// sides stay linked (CLAUDE.md task: persist the invoicing id on the row).
  businessAccountId String?
  contactId         String?

  /// Observability: when we last applied an event and what caused it
  /// (api | app | system). Helps debug echo-loop suppression.
  lastSyncedAt    DateTime?
  lastEventSource String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  businessAccount BusinessAccount?   @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  invoices        InvoicingInvoice[]

  @@index([businessAccountId])
  @@index([contactId])
  @@index([category])
  @@index([status])
}

/// Mirror of an invoice on the invoicing platform. Money is integer minor
/// units (pence) — the API's decimal strings/numbers are converted on the way
/// in and back out (CLAUDE.md §19, never floats for money).
model InvoicingInvoice {
  id            String  @id
  invoicingId   String  @unique
  /// Server-generated human number ("INV-1000"); persisted for correlation.
  invoiceNumber String?

  /// FK to our mirror customer plus the raw partner id, so an invoice that
  /// arrives before its customer still resolves once the customer syncs.
  customerId         String?
  invoicingPartnerId String?

  status     InvoicingInvoiceStatus @default(unknown)
  clientType InvoicingClientType    @default(unknown)
  currency   String                 @default("GBP")

  // Server-computed totals, mirrored in minor units.
  subtotalMinor   Int @default(0)
  vatTotalMinor   Int @default(0)
  grandTotalMinor Int @default(0)
  /// Sum of recorded payments in minor units (derived from payments[]).
  paidMinor       Int @default(0)

  pricesIncludeVat Boolean?
  issueDate        DateTime?
  dueDate          DateTime?
  paymentTerms     String?
  poNumber         String?
  paymentReference String?
  billToName       String?
  fromEmail        String?
  notes            String?
  internalNotes    String?
  lastEmailedAt    DateTime?

  lastSyncedAt    DateTime?
  lastEventSource String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  customer  InvoicingCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineItems InvoicingLineItem[]
  payments  InvoicingPayment[]

  @@index([customerId])
  @@index([invoicingPartnerId])
  @@index([status])
  @@index([invoiceNumber])
}

/// Mirror of an invoice line item. `quantity` is kept as the raw decimal
/// string (hours can be fractional) to avoid float drift; `unitPriceMinor`
/// is money in pence.
model InvoicingLineItem {
  id          String @id
  /// Invoicing-side line id when present; else a deterministic
  /// `<invoiceInvoicingId>:<position>` composite so re-sync is idempotent.
  invoicingId String @unique
  invoiceId   String

  description    String
  quantity       String
  unitPriceMinor Int
  /// VAT rate as a percentage integer (e.g. 20). Null when not provided.
  vatRate        Int?
  position       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice InvoicingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Mirror of a payment recorded against an invoice. Dedupes on the
/// invoicing-side payment id so a webhook + our own POST never double-count
/// (CLAUDE.md acceptance: no double-payment).
model InvoicingPayment {
  id          String @id
  invoicingId String @unique
  invoiceId   String

  amountMinor Int
  currency    String  @default("GBP")
  method      String?
  reference   String?
  paidAt      DateTime?

  lastEventSource String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  invoice InvoicingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Singleton config for the invoicing integration. API key + webhook secret
/// are envelope-encrypted at rest (CLAUDE.md §21). Cursors let the SSE stream
/// and the nightly events-feed reconcile resume without gaps.
model InvoicingSetting {
  /// Always the literal "default" — single-tenant singleton.
  id String @id @default("default")

  /// Base URL of the invoicing API. Override only for staging.
  baseUrl String @default("https://b2b.studymind.co.uk")

  // Envelope-encrypted API key (sk_live_…). Null until configured.
  apiKeyCiphertext    Bytes?
  apiKeyIv            Bytes?
  apiKeyDekCiphertext Bytes?
  apiKeyAad           Bytes?
  apiKeyKeyVersion    Int?
  /// Last 4 chars of the key for the UI ("…a1b2"). Never the whole key.
  apiKeyLast4         String?

  // Envelope-encrypted webhook secret (whsec_…).
  webhookSecretCiphertext    Bytes?
  webhookSecretIv            Bytes?
  webhookSecretDekCiphertext Bytes?
  webhookSecretAad           Bytes?
  webhookSecretKeyVersion    Int?

  /// Events-feed cursor (GET /api/v1/events?since=). Persisted as we process.
  eventsCursor String?
  /// Highest SSE event id processed (GET /api/v1/stream?since=).
  streamCursor String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}
