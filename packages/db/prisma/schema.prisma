model Allocation {
  id          String  @id
  paymentId   String
  bookingId   String
  amountMinor Int
  /// Manual override rationale (CLAUDE.md §6.3, §9). Auto-allocations leave
  /// this null; agent-driven overrides require a short reason captured at
  /// upsert time and surfaced in the audit row.
  reason      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  /// Soft-delete only — historical allocations stay queryable. Hard-delete
  /// happens via the retention engine (CLAUDE.md §21).
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([bookingId])
}

// Audit-B2: agent-initiated Stripe Payment Link. CLAUDE.md §8.
// Persisted BEFORE the Stripe API call so the request is recoverable across
// crashes; idempotencyKey on Stripe binds to PaymentLinkIntent.id.
model PaymentLinkIntent {
  id                  String  @id
  familyId            String
  contactId           String?
  agentId             String
  amountMinor         Int
  currency            String  @default("gbp")
  reason              String
  stripePaymentLinkId String?
  url                 String?
  /// pending | created | completed | expired | cancelled
  status              String  @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([agentId])
  @@index([stripePaymentLinkId])
}

model RefundIntent {
  id             String             @id
  paymentId      String
  amountMinor    Int
  reasonCode     String
  status         RefundIntentStatus @default(pending)
  idempotencyKey String             @unique
  externalId     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model ReconciliationDiscrepancy {
  id           String                 @id
  familyId     String
  category     ReconciliationCategory
  summary      String
  payload      Json
  contextHash  String
  resolvedAt   DateTime?
  resolvedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, category, contextHash])
  @@index([familyId])
  @@index([category])
  @@index([resolvedAt])
}

// -----------------------------------------------------------------------------
// Leads, tasks, tenders, LA
// -----------------------------------------------------------------------------

model Lead {
  id                   String    @id
  source               String
  rawPayload           Json
  email                String?
  phoneE164            String?
  name                 String?
  convertedToContactId String?
  /// Conversion timestamp — when the lead became a Contact. Marketing leads
  /// that did not convert age out after 12 months (CLAUDE.md §21).
  convertedAt          DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// CLAUDE.md §21 retention. Soft-delete sets `softDeletedAt`; the row is
  /// hard-deleted after `pendingHardDeleteAt` elapses (default 30d grace).
  softDeletedAt       DateTime?
  pendingHardDeleteAt DateTime?

  @@index([email])
  @@index([phoneE164])
  @@index([pendingHardDeleteAt])
}

model Task {
  id            String     @id
  title         String
  description   String?
  status        TaskStatus @default(open)
  assigneeId    String?
  /// Optional Team ownership so tasks can be scoped per ops squad as well
  /// as per assignee.
  teamId        String?
  familyId      String?
  /// Optional Contact linkage (CLAUDE.md §13 — Asana sync stores the CRM
  /// contact id in the `crm_contact_id` custom field on the Asana task).
  contactId     String?
  dueAt         DateTime?
  /// Asana task linkage (CLAUDE.md §13). Unique when set.
  asanaTaskId   String?
  /// Last writer attribution: "crm", "asana", or a user id. Used to avoid
  /// echo loops when both sides update the same field in quick succession.
  lastWrittenBy String?
  lastWrittenAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family? @relation(fields: [familyId], references: [id])
  team   Team?   @relation(fields: [teamId], references: [id])

  @@unique([asanaTaskId])
  @@index([assigneeId, status])
  @@index([familyId])
  @@index([contactId])
  @@index([teamId, status])
}

