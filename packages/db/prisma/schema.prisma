// StudyMind CRM Prisma schema.
// See CLAUDE.md Section 19 for conventions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum FamilyState {
  lead
  trial
  active
  at_risk
  churned
}

enum BillingParty {
  family
  local_authority
}

enum SubscriptionState {
  trialing
  active
  past_due
  canceled
  unpaid
  paused
  incomplete
  incomplete_expired
  unknown
}

enum MandateState {
  pending_submission
  submitted
  active
  failed
  cancelled
  expired
  replaced
}

enum BookingState {
  tentative
  confirmed
  delivered
  no_show
  cancelled
}

enum SafeguardingFlagState {
  none
  concern_logged
  restricted_access
}

enum SafeguardingUrgency {
  routine
  urgent
  immediate
}

enum InteractionType {
  email
  call
  message
  note
  task
  payment
  booking
  ai_insight
  family_state_changed
  // ADR 0015: dynamic pipeline. Emitted by `moveFamily` when an operator
  // moves a Family from one PipelineStage to another. Legacy
  // `family_state_changed` is also written when the new stage name maps
  // back to a legacy FamilyState value.
  family_pipeline_moved
  family_billing_contact_changed
  safeguarding_concern_raised
  safeguarding_la_referral
  slack_summary
  tender_state_changed
  system
  // Trengo ticket lifecycle (CLAUDE.md §11). Calls reuse `call`; messages
  // reuse `message`; tickets and labels get explicit values so the timeline
  // can filter on lifecycle without unpacking JSONB.
  ticket_assigned
  ticket_closed
  ticket_reopened
  label_added
  label_removed
  // Slice 7: Gmail (CLAUDE.md §14) and Asana (CLAUDE.md §13).
  // Underscored variants — Postgres enums cannot contain dots; the
  // dotted event name (Section 45) lives in Interaction.payload.event.
  email_received
  email_sent
  task_created
  task_updated
  task_completed
  // Slice 10: Tender pipeline + LA contract workflow (CLAUDE.md §43).
  tender_draft_signed_off
  lacontract_created
  lacontract_invoice_generated
  lacontract_invoice_sent
  lacontract_invoice_paid
  lacontract_progress_report_signed
  ap_review_overdue
  tutor_session_note
  // ADR 0018: multi-board cards. Emitted by `moveCard` when an operator
  // moves a Card between stages on a board.
  card_moved
  // Card detail modal: comment thread + inline description edit. Comments and
  // description changes persist as Interactions on the backing Contact so they
  // appear in the customer's history.
  card_comment
  card_description_changed
  // Universal task comment thread (slice B).
  task_comment
  // Call summary on a board card: an agent records the outcome of a call and
  // can fan it out to Slack / Trengo / email. Both the summary and the send
  // persist as Interactions on the backing Contact so they appear in the
  // customer's history.
  call_summary
  call_summary_sent
}

enum ContactKind {
  parent
  student
  tutor
  la_caseworker
  other
}

enum UserRole {
  // Canonical sales-CRM roles (ADR 0014). New code uses these values.
  ceo
  senior_manager
  manager
  sales_executive
  virtual_assistant
  // Legacy values retained per CLAUDE.md §19 forward-only schema.
  // pickPrimaryRole normalises any straggler legacy assignment at read time
  // until the bulk data migration runs in every environment.
  admin
  ops_manager
  agent
  finance
  dsl
  read_only
  super_admin
}

enum UserInviteStatus {
  pending
  accepted
  cancelled
  expired
}

enum RefundIntentStatus {
  pending
  pending_review
  succeeded
  failed
}

enum ReconciliationCategory {
  hours_mismatch
  payment_unallocated
  late_failure
  late_failure_pending_action
  churned_with_active_subscription
  la_family_with_card_subscription
  // Slice B: a family that has defaulted on a Direct Debit / instalment scheme.
  // Raised by the nightly finance/flag-dd-defaulters job (forward-only enum
  // add per CLAUDE.md §19).
  direct_debit_default
  other
}

enum TaskStatus {
  open
  in_progress
  blocked
  done
  cancelled
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id          String  @id
  // Slice 14: clerkUserId is now optional so seeded super-admins can exist
  // pre-signup. The Clerk webhook reconciles on first sign-up.
  // ADR 0010: Clerk has been excised; this column is retained for the
  // Slice 14 migration history but is no longer written to.
  clerkUserId String? @unique
  email       String  @unique
  name        String?
  isActive    Boolean @default(true)

  // Slice 14: deactivation (CLAUDE.md §20, ADR 0009).
  deactivatedAt      DateTime?
  deactivationReason String?

  // ADR 0010: self-hosted auth columns. Password hash is bcrypt cost 12.
  // mfaSecretCipherId references EncryptedField.id but is not enforced as a
  // foreign key — keeping the migration simple, and the EncryptedField row
  // is created/dropped in lock-step with mfaEnabled.
  passwordHash         String?
  emailVerifiedAt      DateTime?
  mustResetPassword    Boolean   @default(false)
  mfaSecretCipherId    String?
  mfaEnabled           Boolean   @default(false)
  // Audit-A2 / ADR 0010: TOTP MFA. The encrypted secret lives in
  // EncryptedField (KMS envelope; ownerType='User'). totpEnabledAt is the
  // single source of truth for "MFA on" — the middleware enrolment gate
  // and the credentials authorize callback both read it.
  totpSecretCipherId   String?
  totpEnabledAt        DateTime?
  lastSignInAt         DateTime?
  lastSignInIp         String?
  lastSignInUa         String?
  failedSignInAttempts Int       @default(0)
  lockedUntil          DateTime?

  // ADR 0012: per-agent Gmail OAuth. Status is free text (see migration).
  // gmailRefreshTokenCipherId references EncryptedField.id, not enforced as
  // a foreign key — lifecycle is lock-stepped in the OAuth route handlers.
  gmailConnectionStatus     String?
  gmailRefreshTokenCipherId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  roleAssignments         RoleAssignment[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthStates             OAuthState[]
  totpRecoveryCodes       TotpRecoveryCode[]

  @@index([email])
}

// Audit-A2: TOTP recovery codes. 10 codes generated at MFA enrolment time;
// each one is single-use (`usedAt` is set when consumed). Codes are stored
// as sha256 hashes — the plaintext is shown to the user once at setup and
// never again.
model TotpRecoveryCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// ADR 0010: server-side session table. The cookie is JWT, but we keep a row
// per active session so we can list and revoke ("sign out other sessions").
// The token in the cookie is hashed (sha256) before storage; we never store
// the plaintext token.
model Session {
  id               String   @id
  userId           String
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  ipAddress        String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, time-bound email verification token. The plaintext is emailed;
// only the sha256 hash is stored.
model EmailVerificationToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, time-bound password reset token. Same hashing rule as above.
model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// CSRF-style nonce for OAuth flows (Gmail today; Google Calendar later).
// The state parameter is unique and time-bound. Bound to the user that
// initiated the flow so a cross-account replay is rejected. ADR 0012.
model OAuthState {
  id        String   @id
  userId    String
  provider  String
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model UserInvite {
  id                String           @id
  email             String
  firstName         String?
  lastName          String?
  // Roles requested for the invitee. Stored as JSON for flexibility.
  rolesJson         Json
  clerkInvitationId String?
  status            UserInviteStatus @default(pending)
  invitedById       String
  acceptedAt        DateTime?
  acceptedUserId    String?
  cancelledAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([email])
  @@index([status])
}

// Slice 14: Cron heartbeat for the watchdog. CLAUDE.md §17, §25.
model CronRun {
  id         String   @id
  functionId String
  success    Boolean
  durationMs Int
  startedAt  DateTime @default(now())
  finishedAt DateTime
  errorCode  String?

  @@index([functionId, finishedAt])
}

model RoleAssignment {
  id     String   @id
  userId String
  role   UserRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

// -----------------------------------------------------------------------------
// Contacts and Families
// -----------------------------------------------------------------------------

model Contact {
  id          String      @id
  kind        ContactKind
  firstName   String?
  lastName    String?
  email       String?
  phoneE164   String?
  dateOfBirth DateTime?
  isMinor     Boolean     @default(false)
  notes       String?

  // Extended profile fields (additive, all optional) so we can capture
  // enough on a contact to be useful in education ops (CLAUDE.md §2).
  addressLine1   String?
  addressLine2   String?
  city           String?
  postcode       String?
  country        String?
  schoolName     String?
  yearGroup      String?
  sendStatus     ContactSendStatus?
  jobTitle       String?
  pronouns       String?
  mailchimpEmail String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  familyMembers     FamilyMember[]
  billingForFamily  Family[]           @relation("BillingContact")
  interactions      Interaction[]      @relation("ContactInteractions")
  safeguardingFlags SafeguardingFlag[]
  encryptedFields   EncryptedField[]
  cards             Card[]
  linksFrom         ContactLink[]      @relation("ContactLinkFrom")
  linksTo           ContactLink[]      @relation("ContactLinkTo")
  documents         ContactDocument[]

  @@index([email])
  @@index([phoneE164])
  @@index([kind])
}

// Small files attached to a contact (EHCPs, school letters, evidence). Bytes
// live in Postgres so a self-hosted install needs no S3 — same trade-off as
// the branding logo. Capped at a reasonable size at the boundary.
model ContactDocument {
  id          String  @id
  contactId   String
  fileName    String
  contentType String
  byteSize    Int
  data        Bytes
  description String?

  createdAt   DateTime @default(now())
  createdById String?

  contact Contact @relation(fields: [contactId], references: [id])

  @@index([contactId, createdAt(sort: Desc)])
}

enum ContactSendStatus {
  none
  send_support
  ehcp_in_place
  ehcp_in_progress
  other
}

enum ContactLinkRelation {
  parent_of
  child_of
  guardian_of
  sibling_of
  spouse_of
  partner_of
  caseworker_for
  tutor_of
  student_of
  other
}

// Free-form many-to-many between contacts (parent/child, sibling, caseworker,
// tutor, etc). Both sides are first-class so a list of "linked contacts"
// reads either direction. Reciprocal links are an application concern; the
// router writes the inverse where appropriate.
model ContactLink {
  id            String              @id
  fromContactId String
  toContactId   String
  relation      ContactLinkRelation
  notes         String?

  createdAt   DateTime @default(now())
  createdById String?

  fromContact Contact @relation("ContactLinkFrom", fields: [fromContactId], references: [id])
  toContact   Contact @relation("ContactLinkTo", fields: [toContactId], references: [id])

  @@unique([fromContactId, toContactId, relation])
  @@index([toContactId])
}

model Family {
  id                String       @id
  name              String?
  /// Legacy lifecycle enum. Retained per CLAUDE.md §19 forward-only rule.
  /// The canonical pipeline assignment is `stageId` (ADR 0015); this column
  /// is mirrored on a best-effort basis by `moveFamily` for backward
  /// compatibility with consumers that still read `state` (at-risk derivation,
  /// reconciliation, churn-score job).
  state             FamilyState  @default(lead)
  /// Dynamic pipeline stage (ADR 0015). Replaces the hardcoded `state`
  /// enum as the source of truth for pipeline position.
  stageId           String?
  billingParty      BillingParty @default(family)
  billingContactId  String?
  churnScore        Float?
  lastBookingSyncAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  billingContact   Contact?                    @relation("BillingContact", fields: [billingContactId], references: [id])
  stage            PipelineStage?              @relation(fields: [stageId], references: [id], onDelete: SetNull)
  members          FamilyMember[]
  financialAccount FinancialAccount?
  interactions     Interaction[]               @relation("FamilyInteractions")
  bookings         Booking[]
  subscriptions    StripeSubscription[]
  stripeCustomers  StripeCustomer[]
  mandates         GcMandate[]
  invoices         Invoice[]
  payments         Payment[]
  discrepancies    ReconciliationDiscrepancy[]
  tasks            Task[]

  @@index([state])
  @@index([stageId])
  @@index([billingContactId])
}

/// Operator-managed sales pipeline stage. ADR 0015. CEO and Senior Manager
/// can create, rename, reorder, and archive stages; all roles see the
/// current stage list. The legacy `Family.state` enum is mirrored on a
/// best-effort basis when a stage name matches an old enum value so
/// downstream consumers keep working during the transition.
model PipelineStage {
  id          String    @id
  name        String
  /// 1-based order. Only unique among non-archived stages per board — enforced
  /// by a partial unique index on (boardId, position) WHERE archivedAt IS NULL
  /// in the migration (ADR 0018).
  position    Int
  /// Tailwind token name (e.g. `blue-500`) or hex string. Rendered as the
  /// column accent (border + dot/badge) on the pipeline kanban.
  color       String
  /// Closed stages are terminal (the family has left the funnel). Rendered
  /// muted on the kanban with a "Closed" pill.
  isClosed    Boolean   @default(false)
  /// Board this stage belongs to (ADR 0018 multi-board). Nullable for
  /// backward compatibility; the data migration assigns all existing stages
  /// to the default board.
  boardId     String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  board    Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  families Family[]
  cards    Card[]

  @@index([archivedAt])
  @@index([boardId])
}

/// Operator-managed board (ADR 0018). Each board owns its own set of
/// PipelineStages and Cards. The single legacy pipeline (ADR 0015) becomes
/// the default board. Board management is CEO + Senior Manager only.
model Board {
  id          String  @id
  name        String
  description String?
  /// 1-based ordering among active (non-archived) boards. Partial unique
  /// index on (position) WHERE archivedAt IS NULL in the migration.
  position    Int
  /// Exactly one board may be the default. Enforced in app logic
  /// (ensureSingleDefault), not by a DB constraint, so swaps are atomic.
  isDefault   Boolean @default(false)
  /// Target stage for the per-board "tick" quick action (e.g. mark answered →
  /// move to Active). Configured per board in settings.
  tickActionStageId String?
  /// Target stage for the per-board "x" quick action (e.g. no answer →
  /// move to Not answered).
  xActionStageId    String?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  stages PipelineStage[]
  cards  Card[]

  @@index([archivedAt])
}

/// A card on a board (ADR 0018). Backed by a Contact (lighter than a Family,
/// which remains the billing unit). Lives in exactly one stage of one board.
model Card {
  id          String    @id
  boardId     String
  stageId     String
  contactId   String
  subjectId   String?
  /// Free-text card description, editable inline from the card modal
  /// (sales_executive+). A change writes a `card_description_changed`
  /// Interaction on the backing Contact.
  description String?
  /// 1-based order within (boardId, stageId).
  position    Int
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  board   Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  subject Subject?      @relation(fields: [subjectId], references: [id])
  labels  CardLabel[]

  @@index([boardId, stageId, position])
  @@index([contactId])
}

/// Coloured label that can be attached to cards (ADR 0018). Three defaults
/// seeded: B2C, B2B, Summer Camp.
model Label {
  id        String   @id
  name      String   @unique
  /// Tailwind token name, e.g. `blue-600`.
  color     String
  createdAt DateTime @default(now())

  cards CardLabel[]
}

/// Many-to-many junction between Card and Label (ADR 0018).
model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

/// Tutoring subject attached to a card (ADR 0018). Dynamically created via
/// pick-existing-or-create; `lastUsedAt` orders the picker.
model Subject {
  id          String    @id
  name        String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  cards Card[]
}

model FamilyMember {
  id        String @id
  familyId  String
  contactId String
  role      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([familyId, contactId])
  @@index([contactId])
}

model FinancialAccount {
  id       String @id
  familyId String @unique
  status   String @default("ok")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Interactions (the timeline)
// -----------------------------------------------------------------------------

model Interaction {
  id           String          @id
  type         InteractionType
  contactId    String?
  familyId     String?
  occurredAt   DateTime
  summary      String?
  payload      Json

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// CLAUDE.md §21 retention. Soft-delete sets `softDeletedAt`; the row is
  /// then hard-deleted after `pendingHardDeleteAt` elapses (default 30d).
  softDeletedAt       DateTime?
  pendingHardDeleteAt DateTime?

  contact    Contact?    @relation("ContactInteractions", fields: [contactId], references: [id])
  family     Family?     @relation("FamilyInteractions", fields: [familyId], references: [id])

  @@index([contactId, occurredAt])
  @@index([familyId, occurredAt])
  @@index([type, occurredAt])
  @@index([pendingHardDeleteAt])
}

// -----------------------------------------------------------------------------
// Provider events and audit
// -----------------------------------------------------------------------------

model ProviderEvent {
  id          String    @id
  provider    String
  eventId     String
  type        String
  raw         Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([provider, type])
}

model AuditLogEntry {
  id           String    @id
  action       String
  actorId      String?
  targetType   String
  targetId     String
  requestId    String?
  purpose      String?
  before       Json?
  after        Json?
  occurredAt   DateTime  @default(now())
  archivedAt   DateTime?
  archiveS3Key String?

  @@index([targetType, targetId])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([archivedAt, occurredAt])
}

model RetentionPolicy {
  id            String  @id
  scope         String
  retentionDays Int
  contractId    String?
  notes         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// Safeguarding
// -----------------------------------------------------------------------------

model SafeguardingFlag {
  id                String                @id
  contactId         String
  state             SafeguardingFlagState @default(concern_logged)
  urgency           SafeguardingUrgency   @default(routine)
  dslUserId         String?
  raisedById        String?
  closedAt          DateTime?
  /// CLAUDE.md §42.2 — DSL acknowledgement / SLA tracking. `acknowledgedAt`
  /// is set when the assigned DSL takes any triage action that moves the
  /// flag out of `concern_logged`. Used by `safeguarding/sla-escalator`.
  acknowledgedAt    DateTime?
  /// SLA breach escalation: set once when the flag has been re-paged and
  /// reassigned to the current deputy DSL. Idempotency guard.
  escalatedAt       DateTime?
  escalatedToUserId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([state])
  @@index([dslUserId])
  @@index([escalatedAt])
}

model EncryptedField {
  id            String @id
  contactId     String
  column        String
  ciphertext    Bytes
  iv            Bytes
  dekCiphertext Bytes
  aad           Bytes
  keyVersion    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, column])
}

// -----------------------------------------------------------------------------
// Bookings
// -----------------------------------------------------------------------------

model Booking {
  id              String       @id
  familyId        String
  externalId      String       @unique
  state           BookingState @default(tentative)
  contractedHours Int          @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sessions    BookingSession[]
  allocations Allocation[]

  @@index([familyId])
  @@index([state])
}

model BookingSession {
  id              String       @id
  bookingId       String
  externalId      String       @unique
  scheduledAt     DateTime
  state           BookingState @default(tentative)
  hours           Int          @default(0)
  contractedHours Int          @default(0)
  scheduledHours  Int          @default(0)
  deliveredHours  Int          @default(0)
  correctedById   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  correctedBy BookingSession?  @relation("Correction", fields: [correctedById], references: [id])
  corrections BookingSession[] @relation("Correction")

  @@index([bookingId, scheduledAt])
  @@index([state])
}

// -----------------------------------------------------------------------------
// Finance
// -----------------------------------------------------------------------------

model StripeCustomer {
  id               String @id
  familyId         String
  stripeCustomerId String @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model StripeSubscription {
  id               String            @id
  familyId         String
  stripeId         String            @unique
  state            SubscriptionState @default(unknown)
  currentPeriodEnd DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([state])
}

model GcMandate {
  id           String       @id
  familyId     String
  gcMandateId  String       @unique
  state        MandateState @default(pending_submission)
  replacedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  replacedBy GcMandate?  @relation("MandateChain", fields: [replacedById], references: [id])
  replaces   GcMandate[] @relation("MandateChain")

  @@index([familyId])
  @@index([state])
}

model Invoice {
  id          String    @id
  familyId    String
  externalId  String    @unique
  amountMinor Int
  currency    String    @default("GBP")
  issuedAt    DateTime
  dueAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([familyId])
}

model Payment {
  id          String    @id
  familyId    String
  invoiceId   String?
  externalId  String    @unique
  provider    String
  amountMinor Int
  currency    String    @default("GBP")
  receivedAt  DateTime
  confirmedAt DateTime?
  reverted    Boolean   @default(false)
  revertedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  allocations   Allocation[]
  refundIntents RefundIntent[]

  @@index([familyId])
  @@index([provider])
}

model Allocation {
  id          String  @id
  paymentId   String
  bookingId   String
  amountMinor Int
  /// Manual override rationale (CLAUDE.md §6.3, §9). Auto-allocations leave
  /// this null; agent-driven overrides require a short reason captured at
  /// upsert time and surfaced in the audit row.
  reason      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  /// Soft-delete only — historical allocations stay queryable. Hard-delete
  /// happens via the retention engine (CLAUDE.md §21).
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([bookingId])
}

// Audit-B2: agent-initiated Stripe Payment Link. CLAUDE.md §8.
// Persisted BEFORE the Stripe API call so the request is recoverable across
// crashes; idempotencyKey on Stripe binds to PaymentLinkIntent.id.
model PaymentLinkIntent {
  id                  String  @id
  familyId            String
  contactId           String?
  agentId             String
  amountMinor         Int
  currency            String  @default("gbp")
  reason              String
  stripePaymentLinkId String?
  url                 String?
  /// pending | created | completed | expired | cancelled
  status              String  @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([agentId])
  @@index([stripePaymentLinkId])
}

model RefundIntent {
  id             String             @id
  paymentId      String
  amountMinor    Int
  reasonCode     String
  status         RefundIntentStatus @default(pending)
  idempotencyKey String             @unique
  externalId     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model ReconciliationDiscrepancy {
  id           String                 @id
  familyId     String
  category     ReconciliationCategory
  summary      String
  payload      Json
  contextHash  String
  resolvedAt   DateTime?
  resolvedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, category, contextHash])
  @@index([familyId])
  @@index([category])
  @@index([resolvedAt])
}

// -----------------------------------------------------------------------------
// Leads, tasks, tenders, LA
// -----------------------------------------------------------------------------

model Lead {
  id                   String    @id
  source               String
  rawPayload           Json
  email                String?
  phoneE164            String?
  name                 String?
  convertedToContactId String?
  /// Conversion timestamp — when the lead became a Contact. Marketing leads
  /// that did not convert age out after 12 months (CLAUDE.md §21).
  convertedAt          DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// CLAUDE.md §21 retention. Soft-delete sets `softDeletedAt`; the row is
  /// hard-deleted after `pendingHardDeleteAt` elapses (default 30d grace).
  softDeletedAt       DateTime?
  pendingHardDeleteAt DateTime?

  @@index([email])
  @@index([phoneE164])
  @@index([pendingHardDeleteAt])
}

model Task {
  id            String     @id
  title         String
  description   String?
  status        TaskStatus @default(open)
  assigneeId    String?
  /// Optional Team ownership so tasks can be scoped per ops squad as well
  /// as per assignee.
  teamId        String?
  familyId      String?
  /// Optional Contact linkage (CLAUDE.md §13 — Asana sync stores the CRM
  /// contact id in the `crm_contact_id` custom field on the Asana task).
  contactId     String?
  dueAt         DateTime?
  /// Asana task linkage (CLAUDE.md §13). Unique when set.
  asanaTaskId   String?
  /// Last writer attribution: "crm", "asana", or a user id. Used to avoid
  /// echo loops when both sides update the same field in quick succession.
  lastWrittenBy String?
  lastWrittenAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family? @relation(fields: [familyId], references: [id])
  team   Team?   @relation(fields: [teamId], references: [id])

  @@unique([asanaTaskId])
  @@index([assigneeId, status])
  @@index([familyId])
  @@index([contactId])
  @@index([teamId, status])
}

// -----------------------------------------------------------------------------
// Teams — internal ops squads. Tasks can be assigned to a team in addition
// to (or instead of) a person. CEO + Senior Manager manage membership.
// -----------------------------------------------------------------------------

model Team {
  id          String  @id
  name        String  @unique
  color       String?
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  members TeamMember[]
  tasks   Task[]

  @@index([archivedAt])
}

model TeamMember {
  id        String @id
  teamId    String
  userId    String

  createdAt   DateTime @default(now())
  createdById String?

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// GoCardless mandate creation flow
// -----------------------------------------------------------------------------

model MandateIntent {
  id               String  @id
  familyId         String
  billingContactId String
  idempotencyKey   String  @unique
  redirectFlowId   String?
  redirectUrl      String?
  status           String  @default("pending")
  // Resolved GoCardless mandate id once the redirect flow completes.
  gcMandateId      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([billingContactId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Trengo per-agent OAuth tokens (CLAUDE.md §11).
// Each agent's outbound goes through their own Trengo API token, KMS-
// encrypted at rest. Expiry is enforced fail-closed in outbound.ts.
// -----------------------------------------------------------------------------

model TrengoToken {
  /// User.id. One Trengo token per agent. (Pre-ADR-0010 this was a Clerk id.)
  agentId         String   @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Feature flags
// -----------------------------------------------------------------------------

model FeatureFlag {
  id          String  @id
  key         String  @unique
  enabled     Boolean @default(false)
  description String?
  payload     Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// Branding (CLAUDE.md §4). Optional custom logo, stored in Postgres so a
// self-hosted install needs no AWS/S3. Singleton row, id = "branding". The
// inline SVG brand mark stays as the fallback when no row exists.
// -----------------------------------------------------------------------------

model BrandingSetting {
  id              String  @id
  logoData        Bytes
  logoContentType String
  logoFileName    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// DSL rota (CLAUDE.md §42).
// One primary + one deputy per ISO week; raiseConcern resolves the on-duty
// DSL from this table at runtime. Empty rota → DEFAULT_DSL_USER_ID env.
// -----------------------------------------------------------------------------

enum DslRotaRole {
  primary
  deputy
}

model DslRota {
  id        String      @id
  userId    String
  weekStart DateTime
  weekEnd   DateTime
  role      DslRotaRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([weekStart, role])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Slice 7: Slack summary triage, Slack outbound idempotency, Asana webhook
// secrets, Gmail mailbox watch lifecycle, Gmail per-agent OAuth tokens.
// CLAUDE.md §12, §13, §14.
// -----------------------------------------------------------------------------

model UnassignedSummary {
  id           String    @id
  /// Slack message id (the `ts` field in a message event).
  slackTs      String
  channelId    String
  /// Output of the slack-summary AI prompt.
  parsed       Json
  confidence   Float
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@unique([slackTs, channelId])
  @@index([resolvedAt])
}

model SlackPost {
  /// Outbound idempotency key (CLAUDE.md §17). Repeat sends with the same
  /// key return the existing slackTs rather than double-posting.
  idempotencyKey String   @id
  slackTs        String
  channelId      String
  postedAt       DateTime @default(now())

  @@index([postedAt])
}

model AsanaWebhook {
  id            String @id
  projectId     String
  /// Secret Asana sends in the X-Hook-Secret header on creation; we echo it
  /// back to complete the handshake and store it for subsequent payload
  /// signature verification (CLAUDE.md §13).
  webhookSecret String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([projectId])
}

model GmailMailbox {
  /// User.id. One mailbox watch per agent. (Pre-ADR-0010 this was a Clerk id.)
  agentId        String    @id
  address        String    @unique
  historyId      String?
  watchExpiresAt DateTime?
  topicName      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([watchExpiresAt])
}

// -----------------------------------------------------------------------------
// Slice 8: AI features — status summary, churn score, drift sampling.
// CLAUDE.md §18.
// -----------------------------------------------------------------------------

/// Two-line "Current Status" header for a Contact, refreshed every 30 min
/// for changed contacts. CLAUDE.md §17.1, §18. One row per contact.
model ContactStatusSummary {
  contactId     String   @id
  headerLine    String
  bodyLine      String
  generatedAt   DateTime @default(now())
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([generatedAt])
}

/// Family churn score, regenerated nightly by ai/score-churn-risk after
/// finance/reconcile.completed (CLAUDE.md §17.3). Score ∈ [0,1].
model ChurnScore {
  id            String   @id
  familyId      String
  score         Float
  drivers       Json
  rationale     String
  scoredAt      DateTime @default(now())
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, scoredAt])
}

/// 1% production sample of AI inputs/outputs for drift triage.
/// CLAUDE.md §18.3 — reviewed weekly; never store unredacted minor names
/// or full email addresses without clear need.
model DriftSample {
  id            String   @id
  task          String
  model         String
  promptVersion String
  input         Json
  output        Json
  costUsd       Float
  sampledAt     DateTime @default(now())
  reviewed      Boolean  @default(false)
  reviewerNote  String?

  @@index([task, sampledAt])
  @@index([reviewed])
}

// Audit-B2 Chunk 5: outbound Gmail send idempotency. CLAUDE.md §14.
// One row per outbound Gmail send. The unique key is (threadId, requestId)
// — replaying the same tRPC mutation must not send twice.
model OutboundEmailIntent {
  id             String   @id
  agentId        String
  threadId       String
  requestId      String
  gmailMessageId String?
  subject        String
  toAddresses    String[] @default([])
  ccAddresses    String[] @default([])
  bccAddresses   String[] @default([])
  /// pending | sent | failed
  status         String   @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([threadId, requestId])
  @@index([agentId])
  @@index([gmailMessageId])
}

// -----------------------------------------------------------------------------
// Comprehensive customer view + 90-day historic backfill (ADR 0017).
// One row per (provider, agentId) initial-connect backfill so the UI can
// surface progress, and so an idempotent re-run is safe to attempt.
// -----------------------------------------------------------------------------

enum BackfillProvider {
  gmail
  aircall
  trengo
  slack
}

enum BackfillJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

model BackfillJob {
  id              String            @id
  provider        BackfillProvider
  /// Null for shared-token providers (Aircall, Slack). For per-agent
  /// providers (Gmail, Trengo) this is the User.id whose token drives the
  /// backfill.
  agentId         String?
  windowFrom      DateTime
  windowTo        DateTime
  status          BackfillJobStatus @default(pending)
  /// Optional grand-total (set by the worker once it has a count from the
  /// provider — `null` while we are still discovering pages).
  totalCount      Int?
  processedCount  Int               @default(0)
  matchedCount    Int               @default(0)
  skippedCount    Int               @default(0)
  /// Provider-side cursor for resumability across step retries.
  lastEventId     String?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  @@index([provider, agentId, status])
  @@index([status, createdAt])
}

model GmailToken {
  /// User.id. Legacy refresh-token table; ADR 0012 migrated active rows to
  /// EncryptedField via User.gmailRefreshTokenCipherId. Kept for fallback.
  agentId         String    @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
}
