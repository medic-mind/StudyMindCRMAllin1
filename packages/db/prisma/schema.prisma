// StudyMind CRM Prisma schema.
// See CLAUDE.md Section 19 for conventions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum FamilyState {
  lead
  trial
  active
  at_risk
  churned
}

enum BillingParty {
  family
  local_authority
}

enum SubscriptionState {
  trialing
  active
  past_due
  canceled
  unpaid
  paused
  incomplete
  incomplete_expired
  unknown
}

enum MandateState {
  pending_submission
  submitted
  active
  failed
  cancelled
  expired
  replaced
}

enum BookingState {
  tentative
  confirmed
  delivered
  no_show
  cancelled
}

enum SafeguardingFlagState {
  none
  concern_logged
  restricted_access
}

enum SafeguardingUrgency {
  routine
  urgent
  immediate
}

enum InteractionType {
  email
  call
  message
  note
  task
  payment
  booking
  ai_insight
  family_state_changed
  family_billing_contact_changed
  safeguarding_concern_raised
  safeguarding_la_referral
  slack_summary
  tender_state_changed
  system
  // Trengo ticket lifecycle (CLAUDE.md §11). Calls reuse `call`; messages
  // reuse `message`; tickets and labels get explicit values so the timeline
  // can filter on lifecycle without unpacking JSONB.
  ticket_assigned
  ticket_closed
  ticket_reopened
  label_added
  label_removed
  // Slice 7: Gmail (CLAUDE.md §14) and Asana (CLAUDE.md §13).
  // Underscored variants — Postgres enums cannot contain dots; the
  // dotted event name (Section 45) lives in Interaction.payload.event.
  email_received
  email_sent
  task_created
  task_updated
  task_completed
  // Slice 10: Tender pipeline + LA contract workflow (CLAUDE.md §43).
  tender_draft_signed_off
  lacontract_created
  lacontract_invoice_generated
  lacontract_invoice_sent
  lacontract_invoice_paid
  lacontract_progress_report_signed
  ap_review_overdue
  tutor_session_note
}

enum ContactKind {
  parent
  student
  tutor
  la_caseworker
  other
}

enum UserRole {
  admin
  ops_manager
  agent
  finance
  dsl
  read_only
  super_admin
}

enum UserInviteStatus {
  pending
  accepted
  cancelled
  expired
}

enum RefundIntentStatus {
  pending
  pending_review
  succeeded
  failed
}

enum ReconciliationCategory {
  hours_mismatch
  payment_unallocated
  late_failure
  late_failure_pending_action
  churned_with_active_subscription
  ap_review_overdue
  la_family_with_card_subscription
  other
}

enum TenderState {
  identified
  drafting
  submitted
  shortlisted
  awarded
  rejected
  withdrawn
}

enum TaskStatus {
  open
  in_progress
  blocked
  done
  cancelled
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id          String  @id
  // Slice 14: clerkUserId is now optional so seeded super-admins can exist
  // pre-signup. The Clerk webhook reconciles on first sign-up.
  // ADR 0010: Clerk has been excised; this column is retained for the
  // Slice 14 migration history but is no longer written to.
  clerkUserId String? @unique
  email       String  @unique
  name        String?
  isActive    Boolean @default(true)

  // Slice 14: deactivation (CLAUDE.md §20, ADR 0009).
  deactivatedAt       DateTime?
  deactivationReason  String?

  // ADR 0010: self-hosted auth columns. Password hash is bcrypt cost 12.
  // mfaSecretCipherId references EncryptedField.id but is not enforced as a
  // foreign key — keeping the migration simple, and the EncryptedField row
  // is created/dropped in lock-step with mfaEnabled.
  passwordHash         String?
  emailVerifiedAt      DateTime?
  mustResetPassword    Boolean   @default(false)
  mfaSecretCipherId    String?
  mfaEnabled           Boolean   @default(false)
  // Audit-A2 / ADR 0010: TOTP MFA. The encrypted secret lives in
  // EncryptedField (KMS envelope; ownerType='User'). totpEnabledAt is the
  // single source of truth for "MFA on" — the middleware enrolment gate
  // and the credentials authorize callback both read it.
  totpSecretCipherId   String?
  totpEnabledAt        DateTime?
  lastSignInAt         DateTime?
  lastSignInIp         String?
  lastSignInUa         String?
  failedSignInAttempts Int       @default(0)
  lockedUntil          DateTime?

  // ADR 0012: per-agent Gmail OAuth. Status is free text (see migration).
  // gmailRefreshTokenCipherId references EncryptedField.id, not enforced as
  // a foreign key — lifecycle is lock-stepped in the OAuth route handlers.
  gmailConnectionStatus     String?
  gmailRefreshTokenCipherId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  roleAssignments         RoleAssignment[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthStates             OAuthState[]
  totpRecoveryCodes       TotpRecoveryCode[]

  @@index([email])
}

// Audit-A2: TOTP recovery codes. 10 codes generated at MFA enrolment time;
// each one is single-use (`usedAt` is set when consumed). Codes are stored
// as sha256 hashes — the plaintext is shown to the user once at setup and
// never again.
model TotpRecoveryCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// ADR 0010: server-side session table. The cookie is JWT, but we keep a row
// per active session so we can list and revoke ("sign out other sessions").
// The token in the cookie is hashed (sha256) before storage; we never store
// the plaintext token.
model Session {
  id               String   @id
  userId           String
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  ipAddress        String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, time-bound email verification token. The plaintext is emailed;
// only the sha256 hash is stored.
model EmailVerificationToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, time-bound password reset token. Same hashing rule as above.
model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// CSRF-style nonce for OAuth flows (Gmail today; Google Calendar later).
// The state parameter is unique and time-bound. Bound to the user that
// initiated the flow so a cross-account replay is rejected. ADR 0012.
model OAuthState {
  id        String   @id
  userId    String
  provider  String
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model UserInvite {
  id                String           @id
  email             String
  firstName         String?
  lastName          String?
  // Roles requested for the invitee. Stored as JSON for flexibility.
  rolesJson         Json
  clerkInvitationId String?
  status            UserInviteStatus @default(pending)
  invitedById       String
  acceptedAt        DateTime?
  acceptedUserId    String?
  cancelledAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([email])
  @@index([status])
}

// Slice 14: Cron heartbeat for the watchdog. CLAUDE.md §17, §25.
model CronRun {
  id         String   @id
  functionId String
  success    Boolean
  durationMs Int
  startedAt  DateTime @default(now())
  finishedAt DateTime
  errorCode  String?

  @@index([functionId, finishedAt])
}

model RoleAssignment {
  id     String   @id
  userId String
  role   UserRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

// -----------------------------------------------------------------------------
// Contacts and Families
// -----------------------------------------------------------------------------

model Contact {
  id          String      @id
  kind        ContactKind
  firstName   String?
  lastName    String?
  email       String?
  phoneE164   String?
  dateOfBirth DateTime?
  isMinor     Boolean     @default(false)
  notes       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  familyMembers     FamilyMember[]
  billingForFamily  Family[]           @relation("BillingContact")
  interactions      Interaction[]      @relation("ContactInteractions")
  safeguardingFlags SafeguardingFlag[]
  encryptedFields   EncryptedField[]

  @@index([email])
  @@index([phoneE164])
  @@index([kind])
}

model Family {
  id               String       @id
  name             String?
  state            FamilyState  @default(lead)
  billingParty     BillingParty @default(family)
  billingContactId String?
  laContractId     String?
  churnScore       Float?
  lastBookingSyncAt DateTime?
  /// AP (Section 19) placement summary. Mirrors `APPlacement` for fast UI
  /// reads; CLAUDE.md §43.4. Nullable for non-AP families.
  apPlacement      Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  billingContact   Contact?                    @relation("BillingContact", fields: [billingContactId], references: [id])
  laContract       LAContract?                 @relation(fields: [laContractId], references: [id])
  members          FamilyMember[]
  financialAccount FinancialAccount?
  interactions     Interaction[]               @relation("FamilyInteractions")
  bookings         Booking[]
  subscriptions    StripeSubscription[]
  stripeCustomers  StripeCustomer[]
  mandates         GcMandate[]
  invoices         Invoice[]
  payments         Payment[]
  discrepancies    ReconciliationDiscrepancy[]
  tasks            Task[]

  @@index([state])
  @@index([billingContactId])
  @@index([laContractId])
}

model FamilyMember {
  id        String @id
  familyId  String
  contactId String
  role      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([familyId, contactId])
  @@index([contactId])
}

model FinancialAccount {
  id       String @id
  familyId String @unique
  status   String @default("ok")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Interactions (the timeline)
// -----------------------------------------------------------------------------

model Interaction {
  id         String          @id
  type       InteractionType
  contactId  String?
  familyId   String?
  /// Interactions originating on a Tender (which pre-dates the Family). See
  /// CLAUDE.md §43.1.
  tenderId   String?
  /// Interactions originating on an LAContract. CLAUDE.md §43.2.
  laContractId String?
  occurredAt DateTime
  summary    String?
  payload    Json

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// CLAUDE.md §21 retention. Soft-delete sets `softDeletedAt`; the row is
  /// then hard-deleted after `pendingHardDeleteAt` elapses (default 30d).
  softDeletedAt        DateTime?
  pendingHardDeleteAt  DateTime?

  contact    Contact?    @relation("ContactInteractions", fields: [contactId], references: [id])
  family     Family?     @relation("FamilyInteractions", fields: [familyId], references: [id])
  tender     Tender?     @relation("TenderInteractions", fields: [tenderId], references: [id])
  laContract LAContract? @relation("LAContractInteractions", fields: [laContractId], references: [id])

  @@index([contactId, occurredAt])
  @@index([familyId, occurredAt])
  @@index([tenderId, occurredAt])
  @@index([laContractId, occurredAt])
  @@index([type, occurredAt])
  @@index([pendingHardDeleteAt])
}

// -----------------------------------------------------------------------------
// Provider events and audit
// -----------------------------------------------------------------------------

model ProviderEvent {
  id          String    @id
  provider    String
  eventId     String
  type        String
  raw         Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([provider, type])
}

model AuditLogEntry {
  id           String    @id
  action       String
  actorId      String?
  targetType   String
  targetId     String
  requestId    String?
  purpose      String?
  before       Json?
  after        Json?
  occurredAt   DateTime  @default(now())
  archivedAt   DateTime?
  archiveS3Key String?

  @@index([targetType, targetId])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([archivedAt, occurredAt])
}

model RetentionPolicy {
  id            String  @id
  scope         String
  retentionDays Int
  contractId    String?
  notes         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// Safeguarding
// -----------------------------------------------------------------------------

model SafeguardingFlag {
  id         String                @id
  contactId  String
  state      SafeguardingFlagState @default(concern_logged)
  urgency    SafeguardingUrgency   @default(routine)
  dslUserId  String?
  raisedById String?
  closedAt   DateTime?
  /// CLAUDE.md §42.2 — DSL acknowledgement / SLA tracking. `acknowledgedAt`
  /// is set when the assigned DSL takes any triage action that moves the
  /// flag out of `concern_logged`. Used by `safeguarding/sla-escalator`.
  acknowledgedAt    DateTime?
  /// SLA breach escalation: set once when the flag has been re-paged and
  /// reassigned to the current deputy DSL. Idempotency guard.
  escalatedAt       DateTime?
  escalatedToUserId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([state])
  @@index([dslUserId])
  @@index([escalatedAt])
}

model EncryptedField {
  id            String @id
  contactId     String
  column        String
  ciphertext    Bytes
  iv            Bytes
  dekCiphertext Bytes
  aad           Bytes
  keyVersion    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, column])
}

// -----------------------------------------------------------------------------
// Bookings
// -----------------------------------------------------------------------------

model Booking {
  id              String       @id
  familyId        String
  externalId      String       @unique
  state           BookingState @default(tentative)
  contractedHours Int          @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sessions    BookingSession[]
  allocations Allocation[]

  @@index([familyId])
  @@index([state])
}

model BookingSession {
  id              String       @id
  bookingId       String
  externalId      String       @unique
  scheduledAt     DateTime
  state           BookingState @default(tentative)
  hours           Int          @default(0)
  contractedHours Int          @default(0)
  scheduledHours  Int          @default(0)
  deliveredHours  Int          @default(0)
  correctedById   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  correctedBy BookingSession?  @relation("Correction", fields: [correctedById], references: [id])
  corrections BookingSession[] @relation("Correction")

  @@index([bookingId, scheduledAt])
  @@index([state])
}

// -----------------------------------------------------------------------------
// Finance
// -----------------------------------------------------------------------------

model StripeCustomer {
  id               String @id
  familyId         String
  stripeCustomerId String @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model StripeSubscription {
  id               String            @id
  familyId         String
  stripeId         String            @unique
  state            SubscriptionState @default(unknown)
  currentPeriodEnd DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([state])
}

model GcMandate {
  id           String       @id
  familyId     String
  gcMandateId  String       @unique
  state        MandateState @default(pending_submission)
  replacedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  replacedBy GcMandate?  @relation("MandateChain", fields: [replacedById], references: [id])
  replaces   GcMandate[] @relation("MandateChain")

  @@index([familyId])
  @@index([state])
}

model Invoice {
  id          String    @id
  familyId    String
  externalId  String    @unique
  amountMinor Int
  currency    String    @default("GBP")
  issuedAt    DateTime
  dueAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([familyId])
}

model Payment {
  id          String    @id
  familyId    String
  invoiceId   String?
  externalId  String    @unique
  provider    String
  amountMinor Int
  currency    String    @default("GBP")
  receivedAt  DateTime
  confirmedAt DateTime?
  reverted    Boolean   @default(false)
  revertedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  allocations   Allocation[]
  refundIntents RefundIntent[]

  @@index([familyId])
  @@index([provider])
}

model Allocation {
  id          String  @id
  paymentId   String
  bookingId   String
  amountMinor Int
  /// Manual override rationale (CLAUDE.md §6.3, §9). Auto-allocations leave
  /// this null; agent-driven overrides require a short reason captured at
  /// upsert time and surfaced in the audit row.
  reason      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  /// Soft-delete only — historical allocations stay queryable. Hard-delete
  /// happens via the retention engine (CLAUDE.md §21).
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([bookingId])
}

// Audit-B2: agent-initiated Stripe Payment Link. CLAUDE.md §8.
// Persisted BEFORE the Stripe API call so the request is recoverable across
// crashes; idempotencyKey on Stripe binds to PaymentLinkIntent.id.
model PaymentLinkIntent {
  id                  String  @id
  familyId            String
  contactId           String?
  agentId             String
  amountMinor         Int
  currency            String  @default("gbp")
  reason              String
  stripePaymentLinkId String?
  url                 String?
  /// pending | created | completed | expired | cancelled
  status              String  @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([agentId])
  @@index([stripePaymentLinkId])
}

model RefundIntent {
  id             String             @id
  paymentId      String
  amountMinor    Int
  reasonCode     String
  status         RefundIntentStatus @default(pending)
  idempotencyKey String             @unique
  externalId     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model ReconciliationDiscrepancy {
  id           String                 @id
  familyId     String
  category     ReconciliationCategory
  summary      String
  payload      Json
  contextHash  String
  resolvedAt   DateTime?
  resolvedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, category, contextHash])
  @@index([familyId])
  @@index([category])
  @@index([resolvedAt])
}

// -----------------------------------------------------------------------------
// Leads, tasks, tenders, LA
// -----------------------------------------------------------------------------

model Lead {
  id                   String  @id
  source               String
  rawPayload           Json
  email                String?
  phoneE164            String?
  name                 String?
  convertedToContactId String?
  /// Conversion timestamp — when the lead became a Contact. Marketing leads
  /// that did not convert age out after 12 months (CLAUDE.md §21).
  convertedAt          DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// CLAUDE.md §21 retention. Soft-delete sets `softDeletedAt`; the row is
  /// hard-deleted after `pendingHardDeleteAt` elapses (default 30d grace).
  softDeletedAt        DateTime?
  pendingHardDeleteAt  DateTime?

  @@index([email])
  @@index([phoneE164])
  @@index([pendingHardDeleteAt])
}

model Task {
  id          String     @id
  title       String
  description String?
  status      TaskStatus @default(open)
  assigneeId  String?
  familyId    String?
  /// Optional Contact linkage (CLAUDE.md §13 — Asana sync stores the CRM
  /// contact id in the `crm_contact_id` custom field on the Asana task).
  contactId   String?
  dueAt       DateTime?
  /// Asana task linkage (CLAUDE.md §13). Unique when set.
  asanaTaskId String?
  /// Last writer attribution: "crm", "asana", or a user id. Used to avoid
  /// echo loops when both sides update the same field in quick succession.
  lastWrittenBy String?
  lastWrittenAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family? @relation(fields: [familyId], references: [id])

  @@unique([asanaTaskId])
  @@index([assigneeId, status])
  @@index([familyId])
  @@index([contactId])
}

model Tender {
  id                 String      @id
  name               String
  laName             String
  /// LA commissioner / contracting authority name (e.g. "London Borough of X
  /// — Inclusion Service"). Distinct from `laName` which may abbreviate.
  commissioner       String?
  /// Provider-supplied opportunity reference (Find a Tender / Contracts Finder).
  opportunityRef     String?
  state              TenderState @default(identified)
  ownerUserId        String?
  /// Account lead user id (CLAUDE.md §43.1). Same role as ownerUserId today;
  /// retained for clarity.
  accountLeadId      String?
  contractValueMinor Int?
  /// Bid submission deadline.
  dueAt              DateTime?
  submittedAt        DateTime?
  /// True for tenders flagged SEMH or EHCP-heavy. DSL signoff is required
  /// before submission — see packages/core/src/tender/signoff.ts.
  isSemhOrEhcpHeavy  Boolean     @default(false)
  /// Outcome captured on terminal-state transitions.
  outcome            String?
  outcomeReason      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contracts    LAContract[]
  interactions Interaction[]    @relation("TenderInteractions")
  draftRequests TenderDraftRequest[]

  @@index([state])
  @@index([accountLeadId])
}

model TenderDraftRequest {
  id              String   @id
  tenderId        String
  brief           String
  sectionsToDraft String[] @default([])
  draftText       String
  promptVersion   String
  /// Signoff state: pending | account_lead_approved | dsl_approved | approved
  /// | request_changes | rejected. `approved` is terminal and locks the
  /// draft for editing. `account_lead_approved` requires a follow-up DSL
  /// signoff for SEMH/EHCP-heavy tenders.
  signoffState    String   @default("pending")
  requesterId     String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([signoffState])
}

model LAContract {
  id                 String    @id
  tenderId           String?
  laName             String
  commissioner       String?
  reference          String    @unique
  contractValueMinor Int
  startDate          DateTime
  endDate            DateTime?
  hoursEnvelope      Int?
  /// monthly | termly | per_session
  billingCadence     String    @default("monthly")
  /// monthly | termly
  reportingCadence   String    @default("monthly")
  /// Account lead user id.
  accountLeadId      String?
  /// Optional retention policy override (CLAUDE.md §21, §43.2).
  retentionPolicyId  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  tender       Tender?              @relation(fields: [tenderId], references: [id])
  families     Family[]
  invoices     LAInvoice[]
  reports      LAProgressReport[]
  interactions Interaction[]        @relation("LAContractInteractions")

  @@index([laName])
  @@index([retentionPolicyId])
}

model LAInvoice {
  id              String    @id
  contractId      String
  /// Invoice covers a learner-Family for a given period.
  familyId        String?
  reference       String    @unique
  /// draft | sent | paid | disputed | written_off
  state           String    @default("draft")
  amountMinor     Int
  /// Period the invoice covers.
  periodStart     DateTime?
  periodEnd       DateTime?
  /// LA purchase order number captured at send time.
  poNumber        String?
  /// LA payment reference captured at paid time.
  paymentReference String?
  issuedAt        DateTime
  sentAt          DateTime?
  paidAt          DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contract LAContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([familyId])
  @@index([state])
}

model LAProgressReport {
  id            String    @id
  contractId    String
  familyId      String
  periodStart   DateTime
  periodEnd     DateTime
  draftText     String
  promptVersion String
  /// draft | signed | rejected
  state         String    @default("draft")
  signedById    String?
  signedAt      DateTime?
  pdfS3Key      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  contract LAContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, familyId, periodStart, periodEnd])
  @@index([state])
  @@index([familyId])
}

model APPlacement {
  id              String    @id
  familyId        String    @unique
  apStartDate     DateTime
  apReviewDate    DateTime
  apEndDate       DateTime?
  statutoryReason String
  /// pending | overdue | completed
  reviewStatus    String    @default("pending")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([reviewStatus])
  @@index([apReviewDate])
}

// -----------------------------------------------------------------------------
// GoCardless mandate creation flow
// -----------------------------------------------------------------------------

model MandateIntent {
  id                 String  @id
  familyId           String
  billingContactId   String
  idempotencyKey     String  @unique
  redirectFlowId     String?
  redirectUrl        String?
  status             String  @default("pending")
  // Resolved GoCardless mandate id once the redirect flow completes.
  gcMandateId        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([billingContactId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Trengo per-agent OAuth tokens (CLAUDE.md §11).
// Each agent's outbound goes through their own Trengo API token, KMS-
// encrypted at rest. Expiry is enforced fail-closed in outbound.ts.
// -----------------------------------------------------------------------------

model TrengoToken {
  /// User.id. One Trengo token per agent. (Pre-ADR-0010 this was a Clerk id.)
  agentId         String   @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Feature flags
// -----------------------------------------------------------------------------

model FeatureFlag {
  id          String  @id
  key         String  @unique
  enabled     Boolean @default(false)
  description String?
  payload     Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// DSL rota (CLAUDE.md §42).
// One primary + one deputy per ISO week; raiseConcern resolves the on-duty
// DSL from this table at runtime. Empty rota → DEFAULT_DSL_USER_ID env.
// -----------------------------------------------------------------------------

enum DslRotaRole {
  primary
  deputy
}

model DslRota {
  id        String      @id
  userId    String
  weekStart DateTime
  weekEnd   DateTime
  role      DslRotaRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([weekStart, role])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Slice 7: Slack summary triage, Slack outbound idempotency, Asana webhook
// secrets, Gmail mailbox watch lifecycle, Gmail per-agent OAuth tokens.
// CLAUDE.md §12, §13, §14.
// -----------------------------------------------------------------------------

model UnassignedSummary {
  id           String    @id
  /// Slack message id (the `ts` field in a message event).
  slackTs      String
  channelId    String
  /// Output of the slack-summary AI prompt.
  parsed       Json
  confidence   Float
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@unique([slackTs, channelId])
  @@index([resolvedAt])
}

model SlackPost {
  /// Outbound idempotency key (CLAUDE.md §17). Repeat sends with the same
  /// key return the existing slackTs rather than double-posting.
  idempotencyKey String   @id
  slackTs        String
  channelId      String
  postedAt       DateTime @default(now())

  @@index([postedAt])
}

model AsanaWebhook {
  id            String   @id
  projectId     String
  /// Secret Asana sends in the X-Hook-Secret header on creation; we echo it
  /// back to complete the handshake and store it for subsequent payload
  /// signature verification (CLAUDE.md §13).
  webhookSecret String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([projectId])
}

model GmailMailbox {
  /// User.id. One mailbox watch per agent. (Pre-ADR-0010 this was a Clerk id.)
  agentId        String    @id
  address        String    @unique
  historyId      String?
  watchExpiresAt DateTime?
  topicName      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([watchExpiresAt])
}

// -----------------------------------------------------------------------------
// Slice 8: AI features — status summary, churn score, drift sampling.
// CLAUDE.md §18.
// -----------------------------------------------------------------------------

/// Two-line "Current Status" header for a Contact, refreshed every 30 min
/// for changed contacts. CLAUDE.md §17.1, §18. One row per contact.
model ContactStatusSummary {
  contactId     String   @id
  headerLine    String
  bodyLine      String
  generatedAt   DateTime @default(now())
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([generatedAt])
}

/// Family churn score, regenerated nightly by ai/score-churn-risk after
/// finance/reconcile.completed (CLAUDE.md §17.3). Score ∈ [0,1].
model ChurnScore {
  id            String   @id
  familyId      String
  score         Float
  drivers       Json
  rationale     String
  scoredAt      DateTime @default(now())
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, scoredAt])
}

/// 1% production sample of AI inputs/outputs for drift triage.
/// CLAUDE.md §18.3 — reviewed weekly; never store unredacted minor names
/// or full email addresses without clear need.
model DriftSample {
  id            String   @id
  task          String
  model         String
  promptVersion String
  input         Json
  output        Json
  costUsd       Float
  sampledAt     DateTime @default(now())
  reviewed      Boolean  @default(false)
  reviewerNote  String?

  @@index([task, sampledAt])
  @@index([reviewed])
}

model GmailToken {
  /// User.id. Legacy refresh-token table; ADR 0012 migrated active rows to
  /// EncryptedField via User.gmailRefreshTokenCipherId. Kept for fallback.
  agentId         String   @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
}
