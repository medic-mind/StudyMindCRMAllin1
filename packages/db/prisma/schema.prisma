// StudyMind CRM Prisma schema.
// See CLAUDE.md Section 19 for conventions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum FamilyState {
  lead
  trial
  active
  at_risk
  churned
}

enum BillingParty {
  family
  local_authority
}

enum SubscriptionState {
  trialing
  active
  past_due
  canceled
  unpaid
  paused
  incomplete
  incomplete_expired
  unknown
}

enum MandateState {
  pending_submission
  submitted
  active
  failed
  cancelled
  expired
  replaced
}

/// GoCardless subscription lifecycle, mirrored verbatim (ADR 0038).
/// Unknown provider values fail closed to `unknown` (CLAUDE.md §8).
enum GcSubscriptionState {
  pending_customer_approval
  customer_approval_denied
  active
  finished
  cancelled
  paused
  unknown
}

/// GoCardless payment lifecycle, mirrored verbatim (ADR 0038).
enum GcPaymentState {
  pending_customer_approval
  pending_submission
  submitted
  confirmed
  paid_out
  cancelled
  customer_approval_denied
  failed
  charged_back
  unknown
}

enum BookingState {
  tentative
  confirmed
  delivered
  no_show
  cancelled
}

enum SafeguardingFlagState {
  none
  concern_logged
  restricted_access
}

enum SafeguardingUrgency {
  routine
  urgent
  immediate
}

enum InteractionType {
  email
  call
  message
  note
  task
  payment
  booking
  ai_insight
  family_state_changed
  // ADR 0015: dynamic pipeline. Emitted by `moveFamily` when an operator
  // moves a Family from one PipelineStage to another. Legacy
  // `family_state_changed` is also written when the new stage name maps
  // back to a legacy FamilyState value.
  family_pipeline_moved
  family_billing_contact_changed
  safeguarding_concern_raised
  safeguarding_la_referral
  slack_summary
  tender_state_changed
  system
  // Trengo ticket lifecycle (CLAUDE.md §11). Calls reuse `call`; messages
  // reuse `message`; tickets and labels get explicit values so the timeline
  // can filter on lifecycle without unpacking JSONB.
  ticket_assigned
  ticket_closed
  ticket_reopened
  label_added
  label_removed
  // Slice 7: Gmail (CLAUDE.md §14) and Asana (CLAUDE.md §13).
  // Underscored variants — Postgres enums cannot contain dots; the
  // dotted event name (Section 45) lives in Interaction.payload.event.
  email_received
  email_sent
  task_created
  task_updated
  task_completed
  // Slice 10: Tender pipeline + LA contract workflow (CLAUDE.md §43).
  tender_draft_signed_off
  lacontract_created
  lacontract_invoice_generated
  lacontract_invoice_sent
  lacontract_invoice_paid
  lacontract_progress_report_signed
  ap_review_overdue
  tutor_session_note
  // ADR 0018: multi-board cards. Emitted by `moveCard` when an operator
  // moves a Card between stages on a board.
  card_moved
  // Card detail modal: comment thread + inline description edit. Comments and
  // description changes persist as Interactions on the backing Contact so they
  // appear in the customer's history.
  card_comment
  card_description_changed
  // Universal task comment thread (slice B).
  task_comment
  // Call summary on a board card: an agent records the outcome of a call and
  // can fan it out to Slack / Trengo / email. Both the summary and the send
  // persist as Interactions on the backing Contact so they appear in the
  // customer's history.
  call_summary
  call_summary_sent
  // Forwarding (Settings → Forwarding): a configurable rule lets an agent
  // forward a query about a contact to an internal address (e.g. AP team,
  // CEOs, schools, partnerships). The send is recorded here so the
  // contact's timeline shows it.
  email_forwarded
  // ADR 0023: a web enquiry captured via the universal /api/leads endpoint.
  // First contact and every re-enquiry land on the contact's timeline so the
  // page shows how many times they have reached out.
  lead_enquiry
}

enum ContactKind {
  parent
  student
  tutor
  la_caseworker
  other
  unclassified
}

enum UserRole {
  // Canonical sales-CRM roles (ADR 0014). New code uses these values.
  ceo
  senior_manager
  manager
  sales_executive
  virtual_assistant
  // Legacy values retained per CLAUDE.md §19 forward-only schema.
  // pickPrimaryRole normalises any straggler legacy assignment at read time
  // until the bulk data migration runs in every environment.
  admin
  ops_manager
  agent
  finance
  dsl
  read_only
  super_admin
}

enum UserInviteStatus {
  pending
  accepted
  cancelled
  expired
}

enum RefundIntentStatus {
  pending
  pending_review
  succeeded
  failed
}

enum ReconciliationCategory {
  hours_mismatch
  payment_unallocated
  late_failure
  late_failure_pending_action
  churned_with_active_subscription
  la_family_with_card_subscription
  // Slice B: a family that has defaulted on a Direct Debit / instalment scheme.
  // Raised by the nightly finance/flag-dd-defaulters job (forward-only enum
  // add per CLAUDE.md §19).
  direct_debit_default
  other
}

enum TaskStatus {
  open
  in_progress
  blocked
  done
  cancelled
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id          String  @id
  // Slice 14: clerkUserId is now optional so seeded super-admins can exist
  // pre-signup. The Clerk webhook reconciles on first sign-up.
  // ADR 0010: Clerk has been excised; this column is retained for the
  // Slice 14 migration history but is no longer written to.
  clerkUserId String? @unique
  email       String  @unique
  name        String?
  isActive    Boolean @default(true)

  // Slice 14: deactivation (CLAUDE.md §20, ADR 0009).
  deactivatedAt      DateTime?
  deactivationReason String?

  // ADR 0010: self-hosted auth columns. Password hash is bcrypt cost 12.
  // mfaSecretCipherId references EncryptedField.id but is not enforced as a
  // foreign key — keeping the migration simple, and the EncryptedField row
  // is created/dropped in lock-step with mfaEnabled.
  passwordHash         String?
  emailVerifiedAt      DateTime?
  mustResetPassword    Boolean   @default(false)
  mfaSecretCipherId    String?
  mfaEnabled           Boolean   @default(false)
  // Audit-A2 / ADR 0010: TOTP MFA. The encrypted secret lives in
  // EncryptedField (KMS envelope; ownerType='User'). totpEnabledAt is the
  // single source of truth for "MFA on" — the middleware enrolment gate
  // and the credentials authorize callback both read it.
  totpSecretCipherId   String?
  totpEnabledAt        DateTime?
  lastSignInAt         DateTime?
  lastSignInIp         String?
  lastSignInUa         String?
  failedSignInAttempts Int       @default(0)
  lockedUntil          DateTime?

  /// ADR 0020 Phase 5 — when the user last opened the notifications bell.
  /// Rows in AuditLogEntry newer than this with this user as the target are
  /// counted as unread. Null means "never opened" (everything unread).
  notificationsSeenAt DateTime?

  /// ADR 0020 Phase 6 — the user's numeric id on Trengo. Resolved from
  /// `/me` at token-connect time and used to map the `assignee_id` on
  /// `ticket.assigned` webhooks to the CRM `User`. Nullable: a user without
  /// a connected token has no Trengo identity to map. The unique index is
  /// partial (PG default for nullable `@unique`) so multiple users without
  /// the mapping coexist.
  trengoUserId Int? @unique

  // ADR 0012: per-agent Gmail OAuth. Status is free text (see migration).
  // gmailRefreshTokenCipherId references EncryptedField.id, not enforced as
  // a foreign key — lifecycle is lock-stepped in the OAuth route handlers.
  gmailConnectionStatus     String?
  gmailRefreshTokenCipherId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  roleAssignments         RoleAssignment[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthStates             OAuthState[]
  totpRecoveryCodes       TotpRecoveryCode[]
  permissions             UserPermission[]
  assignedCards           Card[]                   @relation("CardAssignee")

  @@index([email])
}

// Grantable per-user capabilities that sit ON TOP of the role matrix
// (CLAUDE.md §20, ADR 0021). Today the only value is `user.manage` — the
// right to edit details / change email / reset another user's password —
// which CEO, Senior Manager and Manager can hand to any individual so a
// trusted Sales Executive can help run the team without a role change.
// Account CREATION, role grants and deactivation stay role-gated.
model UserPermission {
  id          String   @id
  userId      String
  // One of GRANTABLE_ACTIONS in packages/core/src/auth/policies.ts. Stored as
  // text (forward-only, §19) and validated by Zod at the procedure boundary.
  permission  String
  createdAt   DateTime @default(now())
  createdById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

// Audit-A2: TOTP recovery codes. 10 codes generated at MFA enrolment time;
// each one is single-use (`usedAt` is set when consumed). Codes are stored
// as sha256 hashes — the plaintext is shown to the user once at setup and
// never again.
model TotpRecoveryCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// ADR 0010: server-side session table. The cookie is JWT, but we keep a row
// per active session so we can list and revoke ("sign out other sessions").
// The token in the cookie is hashed (sha256) before storage; we never store
// the plaintext token.
model Session {
  id               String   @id
  userId           String
  sessionTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  ipAddress        String?
  userAgent        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, time-bound email verification token. The plaintext is emailed;
// only the sha256 hash is stored.
model EmailVerificationToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, time-bound password reset token. Same hashing rule as above.
model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// CSRF-style nonce for OAuth flows (Gmail today; Google Calendar later).
// The state parameter is unique and time-bound. Bound to the user that
// initiated the flow so a cross-account replay is rejected. ADR 0012.
model OAuthState {
  id        String   @id
  userId    String
  provider  String
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model UserInvite {
  id                String           @id
  email             String
  firstName         String?
  lastName          String?
  // Roles requested for the invitee. Stored as JSON for flexibility.
  rolesJson         Json
  clerkInvitationId String?
  status            UserInviteStatus @default(pending)
  invitedById       String
  acceptedAt        DateTime?
  acceptedUserId    String?
  cancelledAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([email])
  @@index([status])
}

// Slice 14: Cron heartbeat for the watchdog. CLAUDE.md §17, §25.
model CronRun {
  id         String   @id
  functionId String
  success    Boolean
  durationMs Int
  startedAt  DateTime @default(now())
  finishedAt DateTime
  errorCode  String?

  @@index([functionId, finishedAt])
}

model RoleAssignment {
  id     String   @id
  userId String
  role   UserRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

// -----------------------------------------------------------------------------
// Contacts and Families
// -----------------------------------------------------------------------------

model Contact {
  id          String      @id
  kind        ContactKind
  firstName   String?
  lastName    String?
  email       String?
  phoneE164   String?
  dateOfBirth DateTime?
  isMinor     Boolean     @default(false)
  notes       String?

  // Extended profile fields (additive, all optional) so we can capture
  // enough on a contact to be useful in education ops (CLAUDE.md §2).
  addressLine1   String?
  addressLine2   String?
  city           String?
  postcode       String?
  country        String?
  schoolName     String?
  yearGroup      String?
  sendStatus     ContactSendStatus?
  jobTitle       String?
  pronouns       String?
  mailchimpEmail String?

  /// Preferred channel for follow-up — drives the suggested send route on
  /// templated outreach.
  preferredContactMethod ContactPreferredContactMethod?
  /// IANA timezone or free-text fallback ("Europe/London", "GMT+1"). Used to
  /// pick humane call/send times.
  timezone               String?
  /// Where the lead came from — Google, word-of-mouth, booking site, etc.
  referralSource         String?
  /// "GCSE Year 11 Maths", "A-Level Biology", "11+ English"…
  examTarget             String?

  /// Booking lifecycle on booking.studymind.co.uk (CLAUDE.md §15). Defaults
  /// to `lead` for every new contact — the booking site puller is the only
  /// writer that flips it to `registered_no_hours` (account created, no
  /// sessions booked yet) or `registered_with_hours` (account created and
  /// has at least one upcoming or delivered session). The CRM list filters
  /// on this column so the sales team can split fresh leads from the rest.
  bookingStatus       ContactBookingStatus @default(lead)
  /// External id on booking.studymind.co.uk once the contact has signed up
  /// there. Populated by the booking puller; null for pure CRM-only leads.
  bookingContactId    String?
  /// Most recent successful sync from booking.studymind.co.uk. Mirrors the
  /// `bookingLastSyncAt` pattern on BusinessAccountStudent.
  bookingLastSyncAt   DateTime?
  /// Booking-derived engagement metrics, written per-contact by the
  /// booking.studymind.co.uk sync (CLAUDE.md §15). Kept directly on Contact
  /// — not rolled up through Family — so the Contacts table reads them in a
  /// single query and a contact carries its own figures regardless of any
  /// parent/guardian link. Null until the booking sync first runs for the
  /// contact; the list renders "—" for nulls.
  hoursBooked         Int?
  hoursDelivered      Int?
  /// Timestamp of the contact's most recent delivered lesson on the booking
  /// site. Drives the "Last lesson" column + filter.
  lastLessonAt        DateTime?
  /// Total confirmed spend in pence (CLAUDE.md §19 — money is integer minor
  /// units, never floats). Written by the booking/finance sync per-contact.
  amountSpentMinor    Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  familyMembers      FamilyMember[]
  billingForFamily   Family[]                 @relation("BillingContact")
  interactions       Interaction[]            @relation("ContactInteractions")
  /// Conversation heads (ADR 0020) — first-class Trengo tickets reaching
  /// this contact. The bodies of each message still live in `interactions`.
  conversations      Conversation[]           @relation("ContactConversations")
  /// Pending field-edit suggestions from external sources (Trengo
  /// `contact.updated`, Gmail signature parsing, …). ADR 0020 Phase 6c —
  /// surfaced for human confirmation; we never silent-merge (CLAUDE.md §3).
  fieldSuggestions   ContactFieldSuggestion[]
  safeguardingFlags  SafeguardingFlag[]
  encryptedFields    EncryptedField[]
  cards              Card[]
  linksFrom          ContactLink[]            @relation("ContactLinkFrom")
  linksTo            ContactLink[]            @relation("ContactLinkTo")
  documents          ContactDocument[]
  /// Many-to-many: a contact can be tagged with multiple sister-brand
  /// companies (Medic Mind, Oxbridge Mind, Study Mind, anything admins add).
  companies          ContactCompany[]
  /// Many-to-many: shared custom labels (the AccountLabel catalogue, applied
  /// to customers as well as B2B accounts).
  labels             ContactLabel[]
  /// Many-to-many: academic subjects this contact is interested in
  /// (Maths, Biology, etc). Reuses the existing Subject table that boards
  /// already populate.
  subjects           ContactSubject[]
  /// Many-to-many: B2B accounts (schools, partnerships) this contact is
  /// linked to with a role (e.g. "Head teacher", "SENCo", "Programme lead").
  businessAccounts   BusinessAccountContact[]
  /// Manually uploaded invoice files attached to this contact (different
  /// from the finance-mirrored Invoice rows, which live under Family).
  uploadedInvoices   UploadedInvoice[]
  /// Mirror of customers on the B2B Invoices Platform (b2b.studymind.co.uk)
  /// that correlate to this contact (B2C individuals). See InvoicingCustomer.
  invoicingCustomers InvoicingCustomer[]

  /// Booking-site mirror (ADR 0029). A student on booking.studymind.co.uk maps
  /// to this Contact; the satellite rows below hang off it so the hot Contact
  /// row stays lean. Written read-only by the booking sync.
  bookingProfile            ContactBookingProfile?
  bookingLessons            BookingLesson[]
  bookingHoursTransactions  BookingHoursTransaction[]
  bookingCreditTransactions BookingCreditTransaction[]

  /// Manual hours-risk triage state (the at-risk customers system). One per
  /// contact; null when never reviewed.
  riskReview ContactRiskReview?

  /// Weekly-webinar enrolments (the auto-enrollment system). A contact created
  /// from a Stripe subscription is matched to a WebinarClass and surfaced here.
  webinarEnrollments WebinarEnrollment[]
  complaints         Complaint[]

  /// GoCardless customers linked to this contact (ADR 0038). Linked by
  /// unambiguous email match at import or manually in the DD workspace.
  gcCustomers GcCustomer[]
  /// Durable Direct Debit sign-up links issued to this contact.
  mandateSetupLinks MandateSetupLink[]

  @@index([email])
  @@index([phoneE164])
  @@index([kind])
  @@index([bookingStatus])
  @@index([bookingContactId])
}

/// Manual triage state for the hours-risk system (CLAUDE.md §6.4 — the *risk*
/// itself is derived/never stored; this row records the human's decision about
/// it). A customer surfaces on the at-risk dashboard from `deriveHoursRisk`;
/// staff can then **flag** (acknowledge / being-handled) or **dismiss** (not a
/// real risk), which persists across re-derivation and filters the dashboard.
/// One row per contact, upserted. Sales Executive+ writes; audited.
model ContactRiskReview {
  contactId String   @id
  /// `flagged` = actively watched / being chased; `dismissed` = reviewed and
  /// judged not a concern (hidden from the default at-risk view).
  status    String
  note      String?
  /// Snapshot of the derived level at review time, for context in the list.
  levelAtReview String?
  reviewedById  String?
  reviewedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Customisable "peak times" windows for the Aircall analytics (CLAUDE.md §10).
/// Each row marks a recurring season (month/day → month/day, wrapping the
/// year-end when start > end), a set of weekdays, and an hour band as "peak".
/// `year` null = applies every year ("any year"); set it to pin a window to one
/// calendar year. Read by `reports.aircall.summary`; managed by Manager+ on the
/// Aircall report. Classified on the Europe/London clock (UK time).
model CallPeakWindow {
  id   String @id
  name String
  /// Season bounds as month (1-12) + day (1-31). When start > end the window
  /// wraps the year-end (e.g. Nov 1 → Feb 28).
  startMonth Int
  startDay   Int
  endMonth   Int
  endDay     Int
  /// Peak weekdays: 0 = Monday … 6 = Sunday.
  daysOfWeek Int[] @default([])
  /// Peak hour band on a 24h clock: [startHour, endHour). e.g. 16–20 = 4pm–8pm.
  startHour Int
  endHour   Int
  /// null = recurs every year; set = applies only to this calendar year.
  year Int?
  /// Display colour token (e.g. `amber-500`) for the heatmap overlay + chips.
  color String @default("amber-500")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  @@index([archivedAt])
  @@index([year])
}

/// Manual triage state for the missed-calls workspace (CLAUDE.md §10). The
/// "called back" status itself is *derived* (a later outbound call to the same
/// number) and never stored; this row records only a human override —
/// `actioned` (handled another way) or `dismissed` (spam / ignore) — so it
/// survives re-derivation and drives the missed-calls filters. Keyed on the
/// Aircall call id (stringified). Sales Executive+ writes; read by all staff.
model MissedCallReview {
  aircallCallId String   @id
  /// `actioned` = manually marked handled; `dismissed` = spam / not worth a call.
  status        String
  note          String?
  reviewedById  String?
  reviewedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

/// Booking lifecycle for a Contact relative to booking.studymind.co.uk.
/// Default for every new contact is `lead` — the booking site sync flips
/// it once a registration / lesson is observed. CLAUDE.md §15.
enum ContactBookingStatus {
  /// Default state: no booking-site account or no signal yet.
  lead
  /// Has a booking-site account but no sessions booked.
  registered_no_hours
  /// Has a booking-site account and at least one upcoming or delivered session.
  registered_with_hours
}

/// Preferred contact channel (CLAUDE.md §11, §14). 'any' means agent picks.
enum ContactPreferredContactMethod {
  email
  phone
  whatsapp
  any
}

/// Many-to-many join: Contact ↔ Company (a contact can belong to multiple
/// sister brands).
model ContactCompany {
  contactId   String
  companyId   String
  createdAt   DateTime @default(now())
  createdById String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([contactId, companyId])
  @@index([companyId])
}

/// Many-to-many join: Contact ↔ Subject (tutoring subjects).
model ContactSubject {
  contactId   String
  subjectId   String
  createdAt   DateTime @default(now())
  createdById String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([contactId, subjectId])
  @@index([subjectId])
}

// Small files attached to a contact (EHCPs, school letters, evidence). Bytes
// live in Postgres so a self-hosted install needs no S3 — same trade-off as
// the branding logo. Capped at a reasonable size at the boundary.
model ContactDocument {
  id          String  @id
  contactId   String
  fileName    String
  contentType String
  byteSize    Int
  data        Bytes
  description String?

  createdAt   DateTime @default(now())
  createdById String?

  contact Contact @relation(fields: [contactId], references: [id])

  @@index([contactId, createdAt(sort: Desc)])
}

enum ContactSendStatus {
  none
  send_support
  ehcp_in_place
  ehcp_in_progress
  other
}

/// Sister-brand container (Medic Mind, Oxbridge Mind, Study Mind, plus
/// anything the team adds later from Settings → Companies). CLAUDE.md §4.
/// Created at runtime — the previous fixed enum is gone.
model Company {
  id          String    @id
  name        String
  /// URL-safe handle used in filters (e.g. ?company=medic-mind).
  slug        String    @unique
  /// #RRGGBB. Drives the brand chip + dot in the UI.
  color       String?
  description String?
  archivedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  contacts         ContactCompany[]
  families         Family[]
  businessAccounts BusinessAccountCompany[]

  // Lead ingestion + classification (ADR 0023).
  leads            Lead[]                  @relation("LeadBrand")
  leadSources      LeadSource[]            @relation("LeadSourceBrand")
  brandDomainRules BrandDomainRule[]
  urlRules         UrlClassificationRule[] @relation("UrlRuleBrand")
  products         ProductCatalogueItem[]  @relation("ProductBrand")

  @@index([archivedAt])
}

enum ContactLinkRelation {
  parent_of
  child_of
  guardian_of
  sibling_of
  spouse_of
  partner_of
  caseworker_for
  tutor_of
  student_of
  other
}

// Free-form many-to-many between contacts (parent/child, sibling, caseworker,
// tutor, etc). Both sides are first-class so a list of "linked contacts"
// reads either direction. Reciprocal links are an application concern; the
// router writes the inverse where appropriate.
model ContactLink {
  id            String              @id
  fromContactId String
  toContactId   String
  relation      ContactLinkRelation
  notes         String?

  createdAt   DateTime @default(now())
  createdById String?

  fromContact Contact @relation("ContactLinkFrom", fields: [fromContactId], references: [id])
  toContact   Contact @relation("ContactLinkTo", fields: [toContactId], references: [id])

  @@unique([fromContactId, toContactId, relation])
  @@index([toContactId])
}

model Family {
  id                String       @id
  name              String?
  /// Legacy lifecycle enum. Retained per CLAUDE.md §19 forward-only rule.
  /// The canonical pipeline assignment is `stageId` (ADR 0015); this column
  /// is mirrored on a best-effort basis by `moveFamily` for backward
  /// compatibility with consumers that still read `state` (at-risk derivation,
  /// reconciliation, churn-score job).
  state             FamilyState  @default(lead)
  /// Dynamic pipeline stage (ADR 0015). Replaces the hardcoded `state`
  /// enum as the source of truth for pipeline position.
  stageId           String?
  billingParty      BillingParty @default(family)
  billingContactId  String?
  churnScore        Float?
  lastBookingSyncAt DateTime?

  /// Which sister-brand owns this family (Company table).
  companyId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  billingContact   Contact?                    @relation("BillingContact", fields: [billingContactId], references: [id])
  stage            PipelineStage?              @relation(fields: [stageId], references: [id], onDelete: SetNull)
  members          FamilyMember[]
  financialAccount FinancialAccount?
  interactions     Interaction[]               @relation("FamilyInteractions")
  /// Conversation heads (ADR 0020).
  conversations    Conversation[]              @relation("FamilyConversations")
  bookings         Booking[]
  subscriptions     StripeSubscription[]
  stripeCustomers   StripeCustomer[]
  mandates          GcMandate[]
  gcCustomers       GcCustomer[]
  mandateSetupLinks MandateSetupLink[]
  invoices         Invoice[]
  uploadedInvoices UploadedInvoice[]
  payments         Payment[]
  discrepancies    ReconciliationDiscrepancy[]
  tasks            Task[]
  company          Company?                    @relation(fields: [companyId], references: [id])

  @@index([state])
  @@index([companyId])
  @@index([stageId])
  @@index([billingContactId])
}

/// Operator-managed sales pipeline stage. ADR 0015. CEO and Senior Manager
/// can create, rename, reorder, and archive stages; all roles see the
/// current stage list. The legacy `Family.state` enum is mirrored on a
/// best-effort basis when a stage name matches an old enum value so
/// downstream consumers keep working during the transition.
model PipelineStage {
  id          String    @id
  name        String
  /// 1-based order. Only unique among non-archived stages per board — enforced
  /// by a partial unique index on (boardId, position) WHERE archivedAt IS NULL
  /// in the migration (ADR 0018).
  position    Int
  /// Tailwind token name (e.g. `blue-500`) or hex string. Rendered as the
  /// column accent (border + dot/badge) on the pipeline kanban.
  color       String
  /// Closed stages are terminal (the family has left the funnel). Rendered
  /// muted on the kanban with a "Closed" pill.
  isClosed    Boolean   @default(false)
  /// Board this stage belongs to (ADR 0018 multi-board). Nullable for
  /// backward compatibility; the data migration assigns all existing stages
  /// to the default board.
  boardId     String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  board        Board?             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  families     Family[]
  cards        Card[]
  quickActions BoardQuickAction[] @relation("QuickActionTargetStage")

  @@index([archivedAt])
  @@index([boardId])
}

/// Operator-managed board (ADR 0018). Each board owns its own set of
/// PipelineStages and Cards. The single legacy pipeline (ADR 0015) becomes
/// the default board. Board management is CEO + Senior Manager only.
model Board {
  id                String    @id
  name              String
  description       String?
  /// 1-based ordering among active (non-archived) boards. Partial unique
  /// index on (position) WHERE archivedAt IS NULL in the migration.
  position          Int
  /// Exactly one board may be the default. Enforced in app logic
  /// (ensureSingleDefault), not by a DB constraint, so swaps are atomic.
  isDefault         Boolean   @default(false)
  /// DEPRECATED — superseded by the BoardQuickAction multi-row catalogue.
  /// Retained per CLAUDE.md §19 forward-only; the old single-tick / single-X
  /// fallback is no longer rendered when the board has any BoardQuickAction
  /// rows.
  tickActionStageId String?
  xActionStageId    String?
  /// Operator-configurable "card face": which preview fields show on every
  /// card on this board (phone/email, subject, labels, note, scheduled call,
  /// priority, assignee, due date, last activity). JSON array of field keys
  /// (see apps/web/lib/board/card-face.ts). NULL = show all (back-compat);
  /// managers tune it from /boards/[id]/settings so they never need a code
  /// change to declutter a board.
  cardFields        Json?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?

  stages       PipelineStage[]
  cards        Card[]
  quickActions BoardQuickAction[]

  @@index([archivedAt])
}

/// Configurable per-board quick-action buttons. Replaces the legacy
/// `tickActionStageId` / `xActionStageId` pair: each row is one button
/// rendered on every card on the board, with its own label, colour, and
/// target stage. When `targetBoardId` is set the move is cross-board
/// (sends the card off to a stage on another pipeline). Optional
/// `commentTemplate` is appended as a card comment alongside the move so
/// the contact's timeline carries a record of "called once at 10:42".
///
/// Manager+ manages the catalogue; everyone with card-write permission
/// can trigger an action.
model BoardQuickAction {
  id              String  @id
  boardId         String
  label           String
  /// #RRGGBB. Drives the chip background; falls back to the target stage
  /// colour when null.
  color           String?
  targetStageId   String
  /// When set, the target stage is on a different board — moves the card
  /// cross-pipeline. When null, target is on the same board as the
  /// action.
  targetBoardId   String?
  /// Optional comment template added to the card (and recorded on the
  /// backing contact's timeline) when the action fires.
  commentTemplate String?
  sortOrder       Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  targetStage PipelineStage @relation("QuickActionTargetStage", fields: [targetStageId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([archivedAt])
  @@index([sortOrder])
}

/// A card on a board (ADR 0018). Backed by a Contact (lighter than a Family,
/// which remains the billing unit). Lives in exactly one stage of one board.
model Card {
  id          String    @id
  boardId     String
  stageId     String
  contactId   String
  subjectId   String?
  /// Free-text card description, editable inline from the card modal
  /// (sales_executive+). A change writes a `card_description_changed`
  /// Interaction on the backing Contact.
  description String?
  /// Optional CRM user assigned to the card. Surfaced as an avatar on
  /// the board and a picker in the modal side rail. Sales Executive+.
  assigneeId  String?
  /// Optional due date. Surfaced as a chip on the board (red when
  /// overdue) and editable from the modal side rail.
  dueAt       DateTime?
  /// Scheduled call date+time (UTC; the UI picks/renders in Europe/London).
  /// Distinct from `dueAt` — this is WHEN the agent will phone the contact,
  /// which is the whole point of the call-scheduling boards (CLAUDE.md §6.4:
  /// "Scheduled 9am-1pm / 1pm-4pm / 4pm-8pm"). Surfaced as a chip on the card
  /// and a datetime picker in the modal side rail.
  scheduledCallAt DateTime?
  /// Priority 1 (highest) – 4. Null when unset. Surfaced as a P-chip on
  /// the board and selectable from the modal side rail.
  priority    Int?
  /// 1-based order within (boardId, stageId).
  position    Int
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  board    Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  stage    PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact  Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  subject  Subject?      @relation(fields: [subjectId], references: [id])
  assignee User?         @relation("CardAssignee", fields: [assigneeId], references: [id])
  labels   CardLabel[]
  subtasks CardSubtask[]

  @@index([boardId, stageId, position])
  @@index([contactId])
  @@index([assigneeId])
  @@index([dueAt])
  @@index([scheduledCallAt])
}

/// A checklist item ON a card (Todoist-style sub-tasks). Distinct from the
/// CRM Task table and from contact-synced Asana tasks — these are
/// lightweight, card-local checkboxes the agent ticks off as they work the
/// card. No assignee / due date by design; if it needs those it should be a
/// real Task. Sales Executive+ manages them; the toggle is cheap and not
/// individually audited (the card itself carries the audit trail).
model CardSubtask {
  id        String  @id
  cardId    String
  title     String
  completed Boolean @default(false)
  /// 1-based order within the card's checklist.
  position  Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, position])
}

/// Coloured label that can be attached to cards (ADR 0018). Three defaults
/// seeded: B2C, B2B, Summer Camp.
model Label {
  id        String   @id
  name      String   @unique
  /// Tailwind token name, e.g. `blue-600`.
  color     String
  createdAt DateTime @default(now())

  cards CardLabel[]
}

/// Many-to-many junction between Card and Label (ADR 0018).
model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

/// Tutoring subject attached to a card (ADR 0018). Dynamically created via
/// pick-existing-or-create; `lastUsedAt` orders the picker.
model Subject {
  id          String    @id
  name        String    @unique
  lastUsedAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  cards    Card[]
  contacts ContactSubject[]

  @@index([archivedAt])
}

model FamilyMember {
  id        String @id
  familyId  String
  contactId String
  role      String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([familyId, contactId])
  @@index([contactId])
}

model FinancialAccount {
  id       String @id
  familyId String @unique
  status   String @default("ok")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Interactions (the timeline)
// -----------------------------------------------------------------------------

model Interaction {
  id         String          @id
  type       InteractionType
  contactId  String?
  familyId   String?
  /// Optional link to a B2B account, so notes / activity can hang off a
  /// School or Partnership the same way they do off a Contact.
  businessAccountId String?
  occurredAt DateTime
  summary    String?
  payload    Json

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// CLAUDE.md §21 retention. Soft-delete sets `softDeletedAt`; the row is
  /// then hard-deleted after `pendingHardDeleteAt` elapses (default 30d).
  softDeletedAt       DateTime?
  pendingHardDeleteAt DateTime?

  contact Contact? @relation("ContactInteractions", fields: [contactId], references: [id])
  family  Family?  @relation("FamilyInteractions", fields: [familyId], references: [id])
  businessAccount BusinessAccount? @relation("BusinessAccountInteractions", fields: [businessAccountId], references: [id])

  @@index([contactId, occurredAt])
  @@index([familyId, occurredAt])
  @@index([businessAccountId, occurredAt])
  @@index([type, occurredAt])
  @@index([pendingHardDeleteAt])
}

/// First-class conversation head for Trengo tickets (ADR 0020, Phase 2).
///
/// The polymorphic `Interaction` table stays the source of truth for
/// individual message bodies; this row carries the conversation's *current*
/// state as indexed columns so the inbox can answer "all unassigned open
/// WhatsApp conversations" with a single index hit. Upserted by the Trengo
/// webhook job on every event, and by the audited outbound when the CRM
/// initiates an action.
///
/// CLAUDE.md §11. Phase-2-additive — Phase 1 surfaces continue to derive
/// state from Interaction grouping until the comms-centre cutover.
model Conversation {
  id               String             @id
  /// ADR 0021 Phase 3a: provider that owns this conversation. Null means the
  /// row pre-dates the generalisation and is implicitly Trengo (only Trengo
  /// rows existed before). New rows always set this explicitly. Values:
  /// 'trengo' | 'email' | 'outlook' | 'imap' (future). Treat null = 'trengo'.
  provider         String?
  /// MailAccount this conversation belongs to (email-channel rows only).
  /// Null for Trengo and any non-mail provider.
  mailAccountId    String?
  /// External thread/message id from the owning provider — Gmail threadId,
  /// Outlook conversationId, IMAP thread root, etc. Combined with `provider`
  /// it uniquely identifies the conversation for the channel.
  externalThreadId String?
  /// Trengo's ticket id (Trengo-channel rows only). Unique when set.
  /// Nullable since ADR 0021 Phase 3a — email rows leave this null.
  trengoTicketId   Int?               @unique
  /// CRM Contact we resolved this conversation to (phone first, email
  /// second). Null when the inbound didn't match any contact yet.
  contactId        String?
  familyId         String?
  /// whatsapp | sms | email | web_chat. Null until the first event with a
  /// recognised channel arrives.
  channel          String?
  status           ConversationStatus @default(open)
  /// CRM user the conversation is assigned to (resolved from trengoAssigneeId
  /// once we add User.trengoUserId; null otherwise).
  assigneeUserId   String?
  /// Raw Trengo user id from `ticket.assigned` events. Retained even when we
  /// can resolve to a CRM user so the mapping is auditable.
  trengoAssigneeId Int?
  /// Newest of lastInboundAt / lastOutboundAt. Drives inbox ordering.
  lastMessageAt    DateTime
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  /// Cleared to 0 by any outbound; incremented by inbound. Bounded by the
  /// agent marking the conversation read in the comms centre.
  unreadCount      Int                @default(0)
  /// Optional subject from email channels; null otherwise.
  subject          String?
  /// Trengo labels as a flat string array. Maintained by label.added /
  /// label.removed webhooks.
  tags             String[]           @default([])
  /// First ~140 chars of the newest message body — the list-row preview the
  /// comms centre shows under the contact name (Trengo parity). Display
  /// convenience only; bodies live in Interaction.
  lastMessagePreview String?
  /// WhatsApp 24-hour reply window deadline derived from the most recent
  /// inbound on a whatsapp conversation. Null otherwise.
  replyDeadlineAt  DateTime?
  /// ADR 0020 Phase 6g — when a `snoozed` conversation should resurface into
  /// the active inbox. The `trengo/unsnooze-due` cron flips status back to
  /// `open` once this passes; a new inbound also resurfaces it immediately.
  /// Null when not snoozed.
  snoozedUntil     DateTime?
  /// ADR 0020 — last time the `trengo/reconcile-status` cron re-fetched this
  /// conversation's CURRENT state from Trengo and re-converged the head.
  /// Drives a fair round-robin cursor (oldest-checked first) so a dropped or
  /// unsubscribed lifecycle webhook can never leave the head permanently
  /// drifted from Trengo. Null = never reconciled (checked first).
  lastSyncCheckAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact     Contact?     @relation("ContactConversations", fields: [contactId], references: [id])
  family      Family?      @relation("FamilyConversations", fields: [familyId], references: [id])
  mailAccount MailAccount? @relation(fields: [mailAccountId], references: [id])

  @@unique([provider, externalThreadId])
  @@index([status, lastMessageAt])
  @@index([assigneeUserId, status])
  @@index([channel, status])
  @@index([contactId])
  @@index([familyId])
  @@index([unreadCount])
  @@index([mailAccountId, status])
  @@index([provider, channel])
  @@index([lastSyncCheckAt])
}

enum ConversationStatus {
  open
  closed
  snoozed
  archived
}

/// Pending contact-field edit suggested by an upstream provider.
/// ADR 0020 Phase 6c. CLAUDE.md §3 ("AI/automation suggests, humans confirm")
/// — we never silently overwrite a Contact field from a webhook; we record
/// the proposal here and surface it in the staff review queue.
///
/// Idempotency: keyed on `(source, sourceEventId, field)` so a webhook
/// replay does not duplicate. `superseded` is set when a newer suggestion
/// for the same `(contactId, field)` arrives before the first is reviewed,
/// so the queue never shows stale proposals.
model ContactFieldSuggestion {
  id              String                       @id
  contactId       String
  source          String
  sourceEventId   String
  field           String
  proposedValue   String?
  currentValue    String?
  status          ContactFieldSuggestionStatus @default(pending)
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([source, sourceEventId, field])
  @@index([status, createdAt])
  @@index([contactId, status])
}

enum ContactFieldSuggestionStatus {
  pending
  accepted
  rejected
  superseded
}

// -----------------------------------------------------------------------------
// Provider events and audit
// -----------------------------------------------------------------------------

model ProviderEvent {
  id          String    @id
  provider    String
  eventId     String
  type        String
  raw         Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([provider, type])
}

model AuditLogEntry {
  id           String    @id
  action       String
  actorId      String?
  targetType   String
  targetId     String
  requestId    String?
  purpose      String?
  before       Json?
  after        Json?
  occurredAt   DateTime  @default(now())
  archivedAt   DateTime?
  archiveS3Key String?

  @@index([targetType, targetId])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@index([archivedAt, occurredAt])
}

model RetentionPolicy {
  id            String  @id
  scope         String
  retentionDays Int
  contractId    String?
  notes         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// Safeguarding
// -----------------------------------------------------------------------------

model SafeguardingFlag {
  id                String                @id
  contactId         String
  state             SafeguardingFlagState @default(concern_logged)
  urgency           SafeguardingUrgency   @default(routine)
  dslUserId         String?
  raisedById        String?
  closedAt          DateTime?
  /// CLAUDE.md §42.2 — DSL acknowledgement / SLA tracking. `acknowledgedAt`
  /// is set when the assigned DSL takes any triage action that moves the
  /// flag out of `concern_logged`. Used by `safeguarding/sla-escalator`.
  acknowledgedAt    DateTime?
  /// SLA breach escalation: set once when the flag has been re-paged and
  /// reassigned to the current deputy DSL. Idempotency guard.
  escalatedAt       DateTime?
  escalatedToUserId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([state])
  @@index([dslUserId])
  @@index([escalatedAt])
}

model EncryptedField {
  id            String @id
  contactId     String
  column        String
  ciphertext    Bytes
  iv            Bytes
  dekCiphertext Bytes
  aad           Bytes
  keyVersion    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, column])
}

// -----------------------------------------------------------------------------
// Bookings
// -----------------------------------------------------------------------------

model Booking {
  id              String       @id
  familyId        String
  externalId      String       @unique
  state           BookingState @default(tentative)
  contractedHours Int          @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sessions    BookingSession[]
  allocations Allocation[]

  @@index([familyId])
  @@index([state])
}

model BookingSession {
  id              String       @id
  bookingId       String
  externalId      String       @unique
  scheduledAt     DateTime
  state           BookingState @default(tentative)
  hours           Int          @default(0)
  contractedHours Int          @default(0)
  scheduledHours  Int          @default(0)
  deliveredHours  Int          @default(0)
  correctedById   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  correctedBy BookingSession?  @relation("Correction", fields: [correctedById], references: [id])
  corrections BookingSession[] @relation("Correction")

  @@index([bookingId, scheduledAt])
  @@index([state])
}

// -----------------------------------------------------------------------------
// Booking site mirror (booking.studymind.co.uk) — student-centric (ADR 0029).
//
// The booking site is the source of truth for students, lessons, the
// hours-balance ledger and credits (CLAUDE.md §15). The CRM mirrors it
// read-only via an incremental pull (docs/api/booking-pull-api.md). A booking
// "student" maps to a Contact (kind = student) keyed on
// `Contact.bookingContactId`; the satellite rows below hang off that Contact so
// the hot Contact row stays lean. Nothing here writes back to the booking site.
//
// These tables coexist with the legacy family-centric Booking/BookingSession
// above, which the reconciliation engine still reads (CLAUDE.md §19
// forward-only). Wiring lessons into reconciliation is a documented follow-up.
// -----------------------------------------------------------------------------

/// Fixed set of credit products on the booking site's "Adjust Credits" panel.
enum BookingCreditKind {
  online_mmi
  in_person_mmi
  live_day
  in_person_live_day
}

/// 1:1 satellite of Contact holding the booking-site student snapshot — the
/// guardian/bill-payer, the hours balance summary (incl. premium hours + next
/// expiry) and current credit balances. Written only by the booking sync.
model ContactBookingProfile {
  contactId       String @id
  /// Integer student id staff recognise in the booking admin (e.g. 5).
  legacyStudentId Int?

  // Guardian / bill-payer ("Do you have a guardian or bill payer?").
  hasGuardian       Boolean?
  guardianName      String?
  guardianPhoneE164 String?
  guardianEmail     String?

  // Booking-site flags we surface but do not yet act on.
  receiveMarketingEmails Boolean?
  addedByAgent           Boolean?
  registeredAt           DateTime?

  // Hours balance summary (decimal hours, 2dp — booking shows e.g. 5.00).
  hoursAdded            Decimal?  @db.Decimal(8, 2)
  hoursUsed             Decimal?  @db.Decimal(8, 2)
  hoursDeducted         Decimal?  @db.Decimal(8, 2)
  hoursRemaining        Decimal?  @db.Decimal(8, 2)
  premiumHoursAdded     Decimal?  @db.Decimal(8, 2)
  premiumHoursUsed      Decimal?  @db.Decimal(8, 2)
  premiumHoursDeducted  Decimal?  @db.Decimal(8, 2)
  premiumHoursRemaining Decimal?  @db.Decimal(8, 2)
  /// Earliest unexpired hours bucket — drives an "expiring soon" nudge.
  nextHoursExpiryAt     DateTime?

  // Current credit balances per product.
  creditsOnlineMmi       Int @default(0)
  creditsInPersonMmi     Int @default(0)
  creditsLiveDay         Int @default(0)
  creditsInPersonLiveDay Int @default(0)

  /// Most recent successful student sync.
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([legacyStudentId])
}

/// One lesson from booking.studymind.co.uk `/admin/lessons/`, keyed on the
/// booking lesson id. The body also lands as a `booking` Interaction for the
/// timeline; this table is the queryable state layer (status / payment / tutor
/// / subject) — same split as Conversation vs Interaction (ADR 0020).
model BookingLesson {
  id         String @id
  externalId String @unique
  contactId  String

  tutorExternalId String?
  tutorName       String?
  subject         String?

  startsAt        DateTime
  endsAt          DateTime?
  durationMinutes Int       @default(0)

  /// Raw lowercase status from the booking site (`active`, `cancelled`, …).
  /// Stored as text — not a Postgres enum — until the booking team confirms
  /// the full value set (docs/api/booking-pull-api.md §2.3); validated
  /// fail-closed at the integration boundary.
  status  String
  /// Raw lowercase payment (`charged`, `no_fee`, …).
  payment String?

  isTrial             Boolean @default(false)
  trialFeedback       String?
  trialFeedbackStatus String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, startsAt])
  @@index([status])
}

/// One row of the booking site's Balance History (the hours ledger). Hours are
/// signed: positive = added, negative = used/deducted. Carries expiry + the
/// Stripe reference the booking team logs against manual adjustments.
model BookingHoursTransaction {
  id         String @id
  externalId String @unique
  contactId  String

  /// Signed hours (2dp). +5.00 added, -1.00 used.
  hours     Decimal @db.Decimal(8, 2)
  isPremium Boolean @default(false)

  /// Optional money tied to the movement, integer pence (CLAUDE.md §19).
  amountMinor     Int?
  stripeReference String?
  message         String?
  /// Raw lowercase ledger type (`purchase`, `usage`, `voided`, …) — text until
  /// the booking team confirms the set; validated fail-closed at the boundary.
  type            String

  adminExternalId String?
  adminName       String?

  occurredAt DateTime
  /// Hours expire on the booking site — surfaced so finance can see lapses.
  expiresAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, occurredAt])
  @@index([expiresAt])
}

/// One row of the booking site's Credit History (MMI / Live Day credits).
model BookingCreditTransaction {
  id         String @id
  externalId String @unique
  contactId  String

  creditKind BookingCreditKind
  /// Signed credit movement.
  credits    Int

  amountMinor     Int?
  stripeReference String?
  message         String?
  type            String

  adminExternalId String?
  adminName       String?

  occurredAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, occurredAt])
  @@index([creditKind])
}

/// Per-resource incremental-sync cursor for the booking pull. Global keyset
/// pagination on (updated_at, id) — we remember the high-water mark so each
/// poll asks "what changed since X?" (docs/api/booking-pull-api.md §2.5).
model BookingSyncCursor {
  /// One of 'students' | 'lessons' | 'balance_transactions' | 'credit_transactions'.
  resource     String    @id
  /// Highest `updated_at` we have fully processed.
  updatedSince DateTime?
  /// Opaque page cursor mid-walk (null between runs / once drained).
  cursor       String?
  lastRunAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Finance
// -----------------------------------------------------------------------------

model StripeCustomer {
  id               String @id
  familyId         String
  stripeCustomerId String @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model StripeSubscription {
  id               String            @id
  familyId         String
  stripeId         String            @unique
  state            SubscriptionState @default(unknown)
  currentPeriodEnd DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([state])
}

model GcMandate {
  id           String       @id
  /// Nullable since ADR 0038: the complete-mirror import stores every mandate
  /// at GoCardless, including ones whose customer is not yet linked to a
  /// Family. Reconciliation consumers filter `familyId: { not: null }`.
  familyId     String?
  gcMandateId  String       @unique
  state        MandateState @default(pending_submission)
  replacedById String?
  /// GoCardless customer id (`CU…`) this mandate belongs to (ADR 0038).
  /// Soft link — joined in JS via GcCustomer.gcCustomerId, not a DB FK, so
  /// webhook ordering can never violate a constraint.
  gcCustomerId String?
  /// Bank reference shown on the customer's statement.
  reference    String?
  /// Direct Debit scheme (bacs, sepa_core, …).
  scheme       String?
  nextPossibleChargeDate DateTime?
  gcCreatedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family     Family?     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  replacedBy GcMandate?  @relation("MandateChain", fields: [replacedById], references: [id])
  replaces   GcMandate[] @relation("MandateChain")

  @@index([familyId])
  @@index([state])
  @@index([gcCustomerId])
}

/// Complete mirror of a GoCardless customer (ADR 0038). The linkage unit for
/// the Direct Debit system: link the customer to a CRM Contact (and Family)
/// once, and every mandate / subscription / payment under it follows. The
/// import auto-links only on a single unambiguous email match — never
/// auto-merge (CLAUDE.md §3, §41.1); everything else waits for a human.
model GcCustomer {
  id           String  @id
  gcCustomerId String  @unique
  email        String?
  givenName    String?
  familyName   String?
  companyName  String?
  /// CRM links. Set by unambiguous email auto-match at import or by manual
  /// linking in the Direct Debit workspace. familyId follows the contact's
  /// family when one exists (finance stays Family-keyed, CLAUDE.md §6.1).
  contactId    String?
  familyId     String?
  gcCreatedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  family  Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([contactId])
  @@index([familyId])
}

/// Complete mirror of a GoCardless subscription — a recurring Direct Debit
/// plan (ADR 0038). Every status is kept, including `finished` and
/// `cancelled`, so the full history is visible in the CRM.
model GcSubscription {
  id               String              @id
  gcSubscriptionId String              @unique
  /// Provider-side links (soft, JS-joined — see GcMandate.gcCustomerId).
  gcMandateId      String?
  gcCustomerId     String?
  name             String?
  status           GcSubscriptionState @default(unknown)
  amountMinor      Int
  currency         String              @default("GBP")
  /// weekly | monthly | yearly — stored as normalised text (CLAUDE.md §15
  /// precedent) so a new provider value never blocks a sync.
  intervalUnit     String
  interval         Int                 @default(1)
  dayOfMonth       Int?
  startDate        DateTime?
  endDate          DateTime?
  /// Next charge date + amount from `upcoming_payments[0]`, refreshed on
  /// every sync. Null once the subscription is terminal.
  nextChargeAt     DateTime?
  nextChargeMinor  Int?
  /// GoCardless `count` — the total number of payments a fixed-length plan
  /// will ever collect. Null for open-ended plans. Lets us compute a plan's
  /// total contracted value (`count × amountMinor`) and, when a plan is
  /// cancelled/finished early, the collection shortfall (ADR 0038, §6.3).
  totalPaymentCount Int?
  metadata         Json?
  gcCreatedAt      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([status])
  @@index([gcCustomerId])
  @@index([gcMandateId])
}

/// Complete mirror of a GoCardless payment (ADR 0038). Wider population than
/// the reconciliation-facing `Payment` table: every payment at the provider
/// lands here regardless of whether its customer is linked to a Family.
/// `Payment` keeps its existing role (family-linked, drives reconciliation).
model GcPayment {
  id               String         @id
  gcPaymentId      String         @unique
  gcMandateId      String?
  gcCustomerId     String?
  gcSubscriptionId String?
  /// Payout this payment was settled in (links.payout, set once paid out).
  gcPayoutId       String?
  status           GcPaymentState @default(unknown)
  amountMinor      Int
  currency         String         @default("GBP")
  description      String?
  chargeDate       DateTime?
  gcCreatedAt      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([status])
  @@index([gcCustomerId])
  @@index([gcSubscriptionId])
  @@index([gcPayoutId])
  @@index([chargeDate])
}

/// Complete mirror of a GoCardless payout (ADR 0038): the batch transfer of
/// collected funds to the merchant bank account. Status is normalised text
/// (pending | paid | bounced — §15 precedent) so a new provider value never
/// blocks a sync. The payments inside a payout join via GcPayment.gcPayoutId.
model GcPayout {
  id                String  @id
  gcPayoutId        String  @unique
  status            String  @default("pending")
  amountMinor       Int
  currency          String  @default("GBP")
  deductedFeesMinor Int?
  reference         String?
  payoutType        String?
  arrivalDate       DateTime?
  gcCreatedAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([status])
  @@index([arrivalDate])
}

model Invoice {
  id          String    @id
  familyId    String
  externalId  String    @unique
  amountMinor Int
  currency    String    @default("GBP")
  issuedAt    DateTime
  dueAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([familyId])
}

model Payment {
  id          String    @id
  familyId    String
  invoiceId   String?
  externalId  String    @unique
  provider    String
  amountMinor Int
  currency    String    @default("GBP")
  receivedAt  DateTime
  confirmedAt DateTime?
  reverted    Boolean   @default(false)
  revertedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  allocations   Allocation[]
  refundIntents RefundIntent[]

  @@index([familyId])
  @@index([provider])
}

model Allocation {
  id          String  @id
  paymentId   String
  bookingId   String
  amountMinor Int
  /// Manual override rationale (CLAUDE.md §6.3, §9). Auto-allocations leave
  /// this null; agent-driven overrides require a short reason captured at
  /// upsert time and surfaced in the audit row.
  reason      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  /// Soft-delete only — historical allocations stay queryable. Hard-delete
  /// happens via the retention engine (CLAUDE.md §21).
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([bookingId])
}

// Audit-B2: agent-initiated Stripe Payment Link. CLAUDE.md §8.
// Persisted BEFORE the Stripe API call so the request is recoverable across
// crashes; idempotencyKey on Stripe binds to PaymentLinkIntent.id.
model PaymentLinkIntent {
  id                  String  @id
  familyId            String
  contactId           String?
  agentId             String
  amountMinor         Int
  currency            String  @default("gbp")
  reason              String
  stripePaymentLinkId String?
  url                 String?
  /// pending | created | completed | expired | cancelled
  status              String  @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([agentId])
  @@index([stripePaymentLinkId])
}

model RefundIntent {
  id             String             @id
  paymentId      String
  amountMinor    Int
  reasonCode     String
  status         RefundIntentStatus @default(pending)
  idempotencyKey String             @unique
  externalId     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model ReconciliationDiscrepancy {
  id           String                 @id
  familyId     String
  category     ReconciliationCategory
  summary      String
  payload      Json
  contextHash  String
  resolvedAt   DateTime?
  resolvedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, category, contextHash])
  @@index([familyId])
  @@index([category])
  @@index([resolvedAt])
}

enum UnresolvedPaymentStatus {
  pending
  resolved
  dismissed
}

/// A successful Stripe charge for a customer with no StripeCustomer→Family
/// mapping. We never auto-create a Family from a payment (CLAUDE.md §3); instead
/// the charge lands here for finance to link to a Family (human-confirmed) or
/// dismiss. Resolving creates the StripeCustomer mapping and records the
/// Payment, so future charges for that customer resolve automatically.
model UnresolvedStripePayment {
  id                String                  @id
  stripeChargeId    String                  @unique
  stripeCustomerId  String
  amountMinor       Int
  currency          String                  @default("GBP")
  receivedAt        DateTime
  customerEmail     String?
  customerName      String?
  description       String?
  productHandles    String[]                @default([])
  status            UnresolvedPaymentStatus @default(pending)
  resolvedFamilyId  String?
  resolvedPaymentId String?
  dismissReason     String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  resolvedAt   DateTime?
  resolvedById String?

  @@index([status])
  @@index([stripeCustomerId])
}

// -----------------------------------------------------------------------------
// Leads, tasks, tenders, LA
// -----------------------------------------------------------------------------

model Lead {
  id                   String    @id
  source               String
  rawPayload           Json
  email                String?
  phoneE164            String?
  name                 String?
  convertedToContactId String?
  /// Conversion timestamp — when the lead became (or attached to) a Contact.
  /// Marketing leads that did not convert age out after 12 months
  /// (CLAUDE.md §21).
  convertedAt          DateTime?

  // --- Dynamic ingestion + classification (ADR 0023) ------------------------
  // The universal /api/leads endpoint normalises any Contact-Form-7 / JSON /
  // form-encoded payload, then an Inngest job classifies it (brand, products,
  // categories, score) and routes it onto the Sales Pipeline. Everything below
  // is additive + nullable so the legacy /api/webhooks/lead path keeps working.

  /// LeadSource that authenticated this submission (per-website API key), if any.
  sourceId       String?
  /// Detected brand (Study Mind, Medic Mind, …) resolved to a Company row.
  brandCompanyId String?
  /// Landing-page intelligence (CLAUDE.md §16). Often more telling than the
  /// message body, so it drives classification first.
  landingDomain  String?
  landingUrl     String?
  landingSlug    String?
  formTitle      String?
  formId         String?
  referrer       String?
  /// Client IP the enquiry was submitted from (first X-Forwarded-For hop).
  /// Used to derive a country (and so a phone dial code) when the form has
  /// no country field. Subject to the same §21 lead retention.
  ip             String?
  /// ISO-3166-1 alpha-2 country, from the form's country field or IP geo.
  countryCode    String?
  /// utm_source / utm_medium / utm_campaign / utm_term / utm_content.
  utm            Json?

  /// Multi-category by design — a lead can be UCAT *and* Medicine Application
  /// *and* Interview at once (spec). Never force a single bucket.
  categories     String[]  @default([])
  /// Matched master-catalogue product handles (e.g. ucat-course, mmi-interview).
  productTags    String[]  @default([])
  /// AI/heuristic lead score 0-100. Recomputed by the classify job.
  score          Int?
  /// Full classifier output (brand reason, per-rule hits, confidence, AI notes).
  classification Json?
  classifiedAt   DateTime?
  /// Lightweight lifecycle: received → classified → onboarded | reenquiry |
  /// needs_triage | dismissed. Drives the Leads tray + dedupe (ADR 0023).
  status         String    @default("received")
  /// Card created on the pipeline for this submission, when one was made.
  cardId         String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// CLAUDE.md §21 retention. Soft-delete sets `softDeletedAt`; the row is
  /// hard-deleted after `pendingHardDeleteAt` elapses (default 30d grace).
  softDeletedAt       DateTime?
  pendingHardDeleteAt DateTime?

  source_     LeadSource?                    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  brand       Company?                       @relation("LeadBrand", fields: [brandCompanyId], references: [id], onDelete: SetNull)
  corrections LeadClassificationCorrection[]

  @@index([email])
  @@index([phoneE164])
  @@index([pendingHardDeleteAt])
  @@index([status])
  @@index([sourceId])
  @@index([brandCompanyId])
  @@index([createdAt])
}

/// Per-website / per-form API key for the universal POST /api/leads endpoint.
/// Lets ops onboard a new Contact-Form-7 site from the Integrations page
/// without a developer (CLAUDE.md §16). The raw key is shown once; we store
/// only its sha256 + last 4 chars.
model LeadSource {
  id             String    @id
  name           String
  slug           String    @unique
  keyHash        String    @unique
  keyLast4       String
  /// Forces this brand regardless of domain detection (optional override).
  defaultBrandId String?
  active         Boolean   @default(true)
  /// Denormalised counter for the Integrations dashboard.
  leadCount      Int       @default(0)
  lastLeadAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  defaultBrand Company? @relation("LeadSourceBrand", fields: [defaultBrandId], references: [id], onDelete: SetNull)
  leads        Lead[]

  @@index([active])
  @@index([defaultBrandId])
}

/// domain → Company. Editable from the CRM so a new sister brand routes
/// without code (spec: "no developer involvement to add new rules").
model BrandDomainRule {
  id        String  @id
  /// Host suffix, e.g. "medicmind.co.uk". Matched as host === pattern or
  /// host endsWith "." + pattern.
  pattern   String
  companyId String
  priority  Int     @default(100)
  active    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([companyId])
}

/// URL / slug / form-title pattern → product tags + categories (+ optional
/// brand). The configurable heart of the URL intelligence engine.
model UrlClassificationRule {
  id          String   @id
  label       String
  /// Lower-cased token matched against slug + URL + form title.
  pattern     String
  /// contains | equals | regex.
  matchType   String   @default("contains")
  productTags String[] @default([])
  categories  String[] @default([])
  brandId     String?
  priority    Int      @default(100)
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  brand Company? @relation("UrlRuleBrand", fields: [brandId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([brandId])
}

/// Master product catalogue (UCAT Course, MMI Interview, A-Level Biology, …).
/// Drives recognised product tags + the future recommendation engine.
model ProductCatalogueItem {
  id       String   @id
  brandId  String?
  /// Stable handle used in Lead.productTags (e.g. "ucat-course").
  handle   String   @unique
  name     String
  category String
  /// Synonyms / spellings that should match this product.
  aliases  String[] @default([])
  active   Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  brand Company? @relation("ProductBrand", fields: [brandId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([brandId])
  @@index([category])
}

/// Staff corrections to a lead's classification — the learning substrate.
/// Future passes use these to tune rules / few-shot the AI classifier.
model LeadClassificationCorrection {
  id        String   @id
  leadId    String
  /// brand | categories | productTags | score.
  field     String
  fromValue Json?
  toValue   Json
  actorId   String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([field])
}

model Task {
  id            String     @id
  title         String
  description   String?
  status        TaskStatus @default(open)
  assigneeId    String?
  /// Optional Team ownership so tasks can be scoped per ops squad as well
  /// as per assignee.
  teamId        String?
  familyId      String?
  /// Optional Contact linkage (CLAUDE.md §13 — Asana sync stores the CRM
  /// contact id in the `crm_contact_id` custom field on the Asana task).
  contactId     String?
  dueAt         DateTime?
  /// Asana task linkage (CLAUDE.md §13). Unique when set.
  asanaTaskId   String?
  /// Last writer attribution: "crm", "asana", or a user id. Used to avoid
  /// echo loops when both sides update the same field in quick succession.
  lastWrittenBy String?
  lastWrittenAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// Optional link to a B2B account so tasks can be raised against a School
  /// or Partnership, not only a Contact / Family.
  businessAccountId String?

  family Family? @relation(fields: [familyId], references: [id])
  team   Team?   @relation(fields: [teamId], references: [id])
  businessAccount BusinessAccount? @relation(fields: [businessAccountId], references: [id])
  complaint       Complaint?

  @@unique([asanaTaskId])
  @@index([assigneeId, status])
  @@index([familyId])
  @@index([contactId])
  @@index([businessAccountId])
  @@index([teamId, status])
}

// -----------------------------------------------------------------------------
// Teams — internal ops squads. Tasks can be assigned to a team in addition
// to (or instead of) a person. CEO + Senior Manager manage membership.
// -----------------------------------------------------------------------------

model Team {
  id          String  @id
  name        String  @unique
  color       String?
  description String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  members TeamMember[]
  tasks   Task[]
  /// ADR 0021: a shared team inbox can be tied to an ops Team (Admissions,
  /// Sales, …). Optional — a shared inbox may exist without a Team.
  mailAccounts MailAccount[]

  @@index([archivedAt])
}

model TeamMember {
  id     String @id
  teamId String
  userId String

  createdAt   DateTime @default(now())
  createdById String?

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Forwarding rules — configurable "Forward to <team>" quick actions on a
// contact. Each rule defines the recipients (to/cc/bcc) and the subject + body
// templates. Manager+ manages the catalogue; Sales Executive+ triggers sends.
// CLAUDE.md §20.1.
// -----------------------------------------------------------------------------

/// Canned reply / quick-reply template (ADR 0020 Phase 6h). A saved message
/// snippet an agent inserts into a conversation reply. Shared (team-wide)
/// when `ownerUserId` is null; the column is retained for a future personal
/// scope. `{{first_name}}` / `{{name}}` placeholders are substituted at
/// insert time with the contact's details.
model QuickReply {
  id          String  @id
  title       String
  body        String
  /// Optional channel filter — null = available on every channel.
  channel     String?
  /// null = shared (team-wide). Retained for future personal quick replies.
  ownerUserId String?
  sortOrder   Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  @@index([archivedAt, sortOrder])
  @@index([ownerUserId])
}

model ForwardingRule {
  id              String   @id
  // Stable identifier surfaced to code paths that need to refer to a rule by
  // name (defaults are seeded with keys like `ap_team`, `ceos`, `schools`).
  key             String   @unique
  label           String
  description     String?
  toAddresses     String[]
  ccAddresses     String[] @default([])
  bccAddresses    String[] @default([])
  subjectTemplate String
  bodyTemplate    String
  sortOrder       Int      @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  @@index([archivedAt])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// Call summary templates — admin-managed prefill templates for the contact
// page Call Summary panel (UCAT call, Medical Interview call, Dental
// Interview call, etc). Optionally carries an attached PDF (stored inline
// as bytes, same trade-off as ContactDocument / BrandingSetting per
// CLAUDE.md §4) which the caller can open while running the script. Manager+
// manages the catalogue; everyone reads.
// -----------------------------------------------------------------------------

model CallSummaryTemplate {
  id          String  @id
  name        String  @unique
  description String?
  /// The body shown in the textarea when the agent picks this template.
  /// Free-form markdown-ish text — same shape as the existing hardcoded
  /// quick-start fragments.
  body        String
  sortOrder   Int     @default(0)

  // Optional attached PDF. Same byte-storage approach as ContactDocument
  // and BrandingSetting — keeps self-hosted deploys S3-free. `pdfData` is
  // null when there's no attachment; the four fields are written together.
  pdfFileName    String?
  pdfContentType String?
  pdfByteSize    Int?
  pdfData        Bytes?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  @@index([archivedAt])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// Info pack / brochure document library (Settings → Documents). The PDFs the
// team attaches to call-summary emails (information packs, brochures, course
// guides). Stored inline like CallSummaryTemplate.pdfData so self-hosted
// deploys stay S3-free; served at /api/info-packs/[id]/file. Manager+ manages
// the catalogue; everyone reads + picks them in the call-summary email step.
// Deliberately NOT offered on the Trengo WhatsApp path — approved WhatsApp
// templates already carry the pack links, so attaching the PDF again would
// duplicate it.
// -----------------------------------------------------------------------------

model InfoPackDocument {
  id          String  @id
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)

  fileName    String
  contentType String
  byteSize    Int
  data        Bytes

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  @@index([archivedAt])
  @@index([sortOrder])
}

/// Operator-managed Slack channels that a call summary can be posted to as an
/// internal action point for virtual assistants (CLAUDE.md §10/§12). Replaces
/// the single env-configured SLACK_ALERTS_CHANNEL_ID for the call-summary
/// "Internal — Slack" section: the agent picks a channel from this list at
/// send time. Each option carries an optional set of deep-link action buttons
/// rendered as Block Kit buttons on the posted message — VAs click through to
/// the CRM (e.g. "Open in CRM", "Create follow-up task"). Editable from
/// Settings → Slack channels (Manager+). `channelId` is the Slack channel id
/// (Cxxxx). `actionButtons` is a JSON array validated by
/// `SlackActionButton` in packages/core/src/slack/types.ts.
model SlackChannelOption {
  id        String @id
  /// Friendly name shown in the picker, e.g. "VA action points".
  label     String
  /// Slack channel id (e.g. C0123456789). Unique so we never list the same
  /// channel twice.
  channelId String @unique
  /// Optional one-line description of what this channel is for.
  purpose   String?
  /// At most one option is the default; the picker pre-selects it.
  isDefault Boolean @default(false)
  /// Deep-link action buttons rendered on the Slack message. JSON array of
  /// { label, url } — `url` may contain {{contactUrl}} which is substituted
  /// at send time. Empty array = no buttons.
  actionButtons Json @default("[]")
  sortOrder Int    @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  routes SlackRoute[]

  @@index([archivedAt])
  @@index([sortOrder])
}

/// Notification routing (Settings → Slack channels → "Where notifications go").
/// Maps a code-defined notification topic (call summaries, Google Voice alerts,
/// finance alerts, security alerts, …) to a Slack channel, editable from the
/// app so changing where a kind of message goes needs no code change. Topic
/// keys are the registry in packages/core/src/slack/topics.ts. `enabled=false`
/// mutes the topic; when no row exists (or the channel is unset/archived),
/// senders fall back to their default channel → env.
model SlackRoute {
  id              String  @id
  /// Topic key from SLACK_TOPICS. Unique — one route per topic.
  topic           String  @unique
  /// Target channel from the SlackChannelOption catalogue; null = fall back.
  channelOptionId String?
  enabled         Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  channelOption SlackChannelOption? @relation(fields: [channelOptionId], references: [id], onDelete: SetNull)

  @@index([channelOptionId])
}

// -----------------------------------------------------------------------------
// B2B accounts — schools and partnership organisations we work with. Tracked
// as first-class records (name, contact info, lifecycle status, address,
// notes) with a many-to-many to Contact so each touch-point on the account
// (head teacher, SENCo, finance lead, partner manager…) lives as a normal
// Contact and surfaces on the account detail page.
//
// Mirrors the shape of `Company` (sister-brand tag) but for outward-facing
// B2B relationships. Manager+ manages the catalogue; everyone can view.
// -----------------------------------------------------------------------------

enum BusinessAccountKind {
  school
  partnership
}

enum BusinessAccountStatus {
  prospect
  active
  paused
  churned
}

model BusinessAccount {
  id          String                @id
  kind        BusinessAccountKind
  name        String
  /// URL-safe handle (e.g. `oakwood-primary`, `acme-tutors`). Unique per kind.
  slug        String
  /// #RRGGBB. Drives the chip + dot in the UI.
  color       String?
  description String?
  status      BusinessAccountStatus @default(prospect)

  // B2B coordinates — optional; the account may exist before we have full
  // contact details. Email + phone are the primary org-level points; for
  // per-person details, link a Contact via BusinessAccountContact.
  contactEmail String?
  contactPhone String?
  website      String?

  // Address — same shape as Contact for consistency.
  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String?
  country      String?

  notes String?

  /// Set when this account was imported from the B2B Invoices Platform and the
  /// auto-classifier could not confidently decide school vs B2B partner. Such
  /// accounts surface in the "Unsorted" tray with one-click classify buttons
  /// (CRM ↔ invoicing sync). Cleared once a human (or a confident rule) files
  /// it. Additive + nullable — forward-only (CLAUDE.md §19).
  needsClassification      Boolean @default(false)
  /// Why the classifier chose `kind` (or punted to the tray). Free text for the
  /// tray UI, e.g. "name contains 'School'", "domain .sch.uk", "no signal".
  classificationReason     String?
  /// 0..1 confidence from the classifier; null for hand-created accounts.
  classificationConfidence Float?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  contacts           BusinessAccountContact[]
  students           BusinessAccountStudent[]
  uploadedInvoices   UploadedInvoice[]
  companies          BusinessAccountCompany[]
  labels             BusinessAccountLabel[]
  interactions       Interaction[]            @relation("BusinessAccountInteractions")
  tasks              Task[]
  /// Mirror of customers on the B2B Invoices Platform (b2b.studymind.co.uk)
  /// that correlate to this account (schools, partnerships, AP/council).
  invoicingCustomers InvoicingCustomer[]

  @@unique([kind, slug])
  @@index([kind])
  @@index([status])
  @@index([archivedAt])
  @@index([needsClassification])
}

/// Shared, staff-curated label catalogue. Free-form, colour-coded tags applied
/// to BOTH B2B accounts (schools + partners) and B2C customers (Contacts) via
/// the two sibling junctions below — one catalogue, surfaced in the UI simply
/// as "Labels". Named `AccountLabel` for back-compat with the first migration
/// (forward-only, CLAUDE.md §19); the name is not customer-facing. Distinct
/// from `Label` (board cards, ADR 0018) and `Company` (brand tags) — those
/// carry their own semantics. Manager+ curates; Sales Executive+ applies.
model AccountLabel {
  id          String    @id
  name        String
  /// #RRGGBB. Drives the chip + dot in the UI (same convention as Company).
  color       String?
  description String?
  /// Orders the catalogue in pickers + the management table.
  sortOrder   Int       @default(0)
  archivedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  accounts BusinessAccountLabel[]
  contacts ContactLabel[]

  @@unique([name])
  @@index([archivedAt])
}

/// Many-to-many join: BusinessAccount ↔ AccountLabel. One row per applied label.
model BusinessAccountLabel {
  accountId String
  labelId   String

  createdAt   DateTime @default(now())
  createdById String?

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label   AccountLabel    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([accountId, labelId])
  @@index([labelId])
}

/// Many-to-many join: Contact ↔ AccountLabel (the shared label catalogue).
/// One row per applied label — the B2C customer counterpart of
/// BusinessAccountLabel.
model ContactLabel {
  contactId String
  labelId   String

  createdAt   DateTime @default(now())
  createdById String?

  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label   AccountLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([contactId, labelId])
  @@index([labelId])
}

/// Many-to-many: BusinessAccount ↔ Company (sister-brand tag). Mirrors
/// the ContactCompany shape so a school / partnership can be tagged with
/// every brand it works under (Medic Mind + Oxbridge Mind, etc).
model BusinessAccountCompany {
  accountId String
  companyId String

  createdAt   DateTime @default(now())
  createdById String?

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([accountId, companyId])
  @@index([companyId])
}

/// Many-to-many join: BusinessAccount ↔ Contact. The optional `role` text is
/// the contact's role at the account (e.g. "Head teacher", "SENCo",
/// "Finance contact", "Programme lead"). One row per link.
model BusinessAccountContact {
  accountId String
  contactId String
  role      String?

  createdAt   DateTime @default(now())
  createdById String?

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([accountId, contactId])
  @@index([contactId])
}

/// Students enrolled at a BusinessAccount (school / partnership) — what
/// they're getting from us. Each row is one (account, student-name) pair,
/// not a CRM Contact, so accounts can track cohorts without dragging every
/// pupil into the contact database. Hours are split into `contracted` and
/// `delivered`; the delivered figure is the column the booking site sync
/// will write into when wired (see `bookingStudentId` / `bookingLastSyncAt`).
model BusinessAccountStudent {
  id        String @id
  accountId String

  firstName   String
  lastName    String?
  yearGroup   String?
  dateOfBirth DateTime?

  /// What the student is getting — free-form text (e.g. "UCAT prep — 10
  /// sessions", "Medical interview package", "Maths weekly tutoring").
  program         String?
  /// Hours contracted under the current programme.
  hoursContracted Int?
  /// Hours delivered — synced from booking.studymind.co.uk when the
  /// integration is live. Manually editable until then.
  hoursDelivered  Int?
  startDate       DateTime?
  endDate         DateTime?
  status          BusinessAccountStudentStatus @default(active)

  /// Free-form text. Subjects + notes for at-a-glance triage.
  subjects String?
  notes    String?

  /// Booking site cross-reference. Populated once we hook up the
  /// booking.studymind.co.uk pull (CLAUDE.md §15). Sync writes
  /// `hoursDelivered` + `bookingLastSyncAt`; manual edits remain possible.
  bookingStudentId  String?
  bookingLastSyncAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  account BusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([archivedAt])
  @@index([bookingStudentId])
}

enum BusinessAccountStudentStatus {
  active
  paused
  completed
  withdrawn
}

// -----------------------------------------------------------------------------
// Uploaded invoices — manually uploaded invoice files attached to a
// BusinessAccount (B2B / Schools / Partners) OR a Family (normal customer)
// OR a Contact (lead / one-off). Different from the auto-mirrored `Invoice`
// table above which tracks Stripe / GoCardless reconciliation rows.
//
// The file lives inline as bytes (same trade-off as ContactDocument and
// CallSummaryTemplate per CLAUDE.md §4 — self-hosted installs need no S3).
// Cross-app connectivity with b2b.studymind.co.uk is a future extension;
// today this is the canonical place to drop a PDF and tag it.
// -----------------------------------------------------------------------------

enum UploadedInvoiceStatus {
  draft
  sent
  paid
  overdue
  void
}

model UploadedInvoice {
  id String @id

  // Polymorphic owner — exactly one of the three FKs is set. A DB check
  // constraint enforces that in the migration; the tRPC layer enforces
  // it at write time.
  businessAccountId String?
  contactId         String?
  familyId          String?

  invoiceNumber String?
  amountMinor   Int?
  currency      String                @default("GBP")
  issuedAt      DateTime?
  dueAt         DateTime?
  status        UploadedInvoiceStatus @default(draft)
  notes         String?

  // File payload — required.
  fileName    String
  contentType String
  byteSize    Int
  data        Bytes

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  archivedAt  DateTime?

  businessAccount BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  family          Family?          @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([businessAccountId])
  @@index([contactId])
  @@index([familyId])
  @@index([status])
  @@index([archivedAt])
}

// -----------------------------------------------------------------------------
// GoCardless mandate creation flow
// -----------------------------------------------------------------------------

model MandateIntent {
  id               String  @id
  familyId         String
  billingContactId String
  idempotencyKey   String  @unique
  redirectFlowId   String?
  redirectUrl      String?
  status           String  @default("pending")
  // Resolved GoCardless mandate id once the redirect flow completes.
  gcMandateId      String?
  /// Durable setup link (ADR 0038 amendment) this redirect flow was minted
  /// for, so completion can close the link and stop its reminders.
  setupLinkId      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([familyId])
  @@index([billingContactId])
  @@index([status])
  @@index([setupLinkId])
}

/// Durable Direct Debit sign-up link (ADR 0038 amendment). GoCardless
/// redirect flows expire after ~30 minutes, so we never email those: we email
/// a CRM-owned token URL instead, and mint a fresh redirect flow on every
/// click. The row also drives the automation: the setup email goes out on
/// issue, one reminder goes out automatically if the mandate is still not in
/// place, and the link auto-expires.
model MandateSetupLink {
  id        String @id
  /// Unguessable URL token (crypto-random, base64url).
  token     String @unique
  contactId String
  familyId  String
  /// Optional plan wording shown to the parent in the email + GoCardless page.
  description String?
  /// active | completed | revoked | expired
  status    String   @default("active")
  expiresAt DateTime

  /// Email automation state.
  emailTo        String?
  emailedAt      DateTime?
  reminderSentAt DateTime?

  /// Open tracking (no audit per open — stored on the row).
  lastOpenedAt DateTime?
  openCount    Int       @default(0)

  completedAt DateTime?
  /// The mandate that resulted, once completed.
  gcMandateId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([contactId])
  @@index([familyId])
}

// -----------------------------------------------------------------------------
// Trengo per-agent OAuth tokens (CLAUDE.md §11).
// Each agent's outbound goes through their own Trengo API token, KMS-
// encrypted at rest. Expiry is enforced fail-closed in outbound.ts.
// -----------------------------------------------------------------------------

model TrengoToken {
  /// User.id. One Trengo token per agent. (Pre-ADR-0010 this was a Clerk id.)
  agentId         String   @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([expiresAt])
}

/// Mirror of the Trengo workspace's USERS (agents) — so the CRM reflects the
/// Trengo team even for agents who never logged into the CRM. Drives the
/// assignee picker (assign to ANY Trengo agent), resolves assignee + sender
/// display names on conversations, and auto-links to a CRM User by email.
/// Synced from `GET /users` on the Trengo history import, a manual "Sync
/// Trengo team" button, and the recurring import. Idempotent on trengoUserId.
model TrengoUser {
  id           String   @id
  /// Trengo's numeric user id (the value `assignee_id` / message `user_id`
  /// carry). Unique — the upsert key.
  trengoUserId Int      @unique
  name         String?
  email        String?
  isActive     Boolean  @default(true)
  /// Linked CRM User (matched by email), when this agent also logs into the
  /// CRM. Null for Trengo-only agents — they still resolve to a name here.
  crmUserId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([crmUserId])
}

// -----------------------------------------------------------------------------
// Feature flags
// -----------------------------------------------------------------------------

model FeatureFlag {
  id          String  @id
  key         String  @unique
  enabled     Boolean @default(false)
  description String?
  payload     Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// Branding (CLAUDE.md §4). Optional custom logo, stored in Postgres so a
// self-hosted install needs no AWS/S3. Singleton row, id = "branding". The
// inline SVG brand mark stays as the fallback when no row exists.
// -----------------------------------------------------------------------------

model BrandingSetting {
  id              String  @id
  logoData        Bytes
  logoContentType String
  logoFileName    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// DSL rota (CLAUDE.md §42).
// One primary + one deputy per ISO week; raiseConcern resolves the on-duty
// DSL from this table at runtime. Empty rota → DEFAULT_DSL_USER_ID env.
// -----------------------------------------------------------------------------

enum DslRotaRole {
  primary
  deputy
}

model DslRota {
  id        String      @id
  userId    String
  weekStart DateTime
  weekEnd   DateTime
  role      DslRotaRole

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([weekStart, role])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Slice 7: Slack summary triage, Slack outbound idempotency, Asana webhook
// secrets, Gmail mailbox watch lifecycle, Gmail per-agent OAuth tokens.
// CLAUDE.md §12, §13, §14.
// -----------------------------------------------------------------------------

model UnassignedSummary {
  id           String    @id
  /// Slack message id (the `ts` field in a message event).
  slackTs      String
  channelId    String
  /// Output of the slack-summary AI prompt.
  parsed       Json
  confidence   Float
  /// Original Slack message + author, archived so the triage tray shows what
  /// was actually said and the record survives Slack's 90-day retention even
  /// before it is assigned to a contact (ADR 0034).
  messageText  String?
  senderName   String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@unique([slackTs, channelId])
  @@index([resolvedAt])
}

model SlackPost {
  /// Outbound idempotency key (CLAUDE.md §17). Repeat sends with the same
  /// key return the existing slackTs rather than double-posting.
  idempotencyKey String   @id
  slackTs        String
  channelId      String
  postedAt       DateTime @default(now())

  @@index([postedAt])
}

model AsanaWebhook {
  id            String @id
  projectId     String
  /// Secret Asana sends in the X-Hook-Secret header on creation; we echo it
  /// back to complete the handshake and store it for subsequent payload
  /// signature verification (CLAUDE.md §13).
  webhookSecret String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([projectId])
}

model GmailMailbox {
  /// cuid2. Multiple mailboxes can be connected per agent.
  id             String    @id
  /// User.id of the owning agent.
  agentId        String
  address        String    @unique
  historyId      String?
  watchExpiresAt DateTime?
  topicName      String?
  /// One mailbox per agent is the default outbound + drives Trengo/board
  /// senders. Only one row per agentId can be true at a time (app-level).
  isDefault      Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  /// ADR 0021 Communications Hub bridge. When this Gmail mailbox is surfaced
  /// as a provider-agnostic MailAccount, that row points back here (1:1) so the
  /// hub reuses the live Gmail sync without a destructive migration (§19.1).
  mailAccount MailAccount?

  @@index([agentId])
  @@index([watchExpiresAt])
}

// -----------------------------------------------------------------------------
// Slice 8: AI features — status summary, churn score, drift sampling.
// CLAUDE.md §18.
// -----------------------------------------------------------------------------

/// Two-line "Current Status" header for a Contact, refreshed every 30 min
/// for changed contacts. CLAUDE.md §17.1, §18. One row per contact.
model ContactStatusSummary {
  contactId     String   @id
  headerLine    String
  bodyLine      String
  generatedAt   DateTime @default(now())
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([generatedAt])
}

/// Family churn score, regenerated nightly by ai/score-churn-risk after
/// finance/reconcile.completed (CLAUDE.md §17.3). Score ∈ [0,1].
model ChurnScore {
  id            String   @id
  familyId      String
  score         Float
  drivers       Json
  rationale     String
  scoredAt      DateTime @default(now())
  promptVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, scoredAt])
}

/// 1% production sample of AI inputs/outputs for drift triage.
/// CLAUDE.md §18.3 — reviewed weekly; never store unredacted minor names
/// or full email addresses without clear need.
model DriftSample {
  id            String   @id
  task          String
  model         String
  promptVersion String
  input         Json
  output        Json
  costUsd       Float
  sampledAt     DateTime @default(now())
  reviewed      Boolean  @default(false)
  reviewerNote  String?

  @@index([task, sampledAt])
  @@index([reviewed])
}

// Audit-B2 Chunk 5: outbound Gmail send idempotency. CLAUDE.md §14.
// One row per outbound Gmail send. The unique key is (threadId, requestId)
// — replaying the same tRPC mutation must not send twice.
model OutboundEmailIntent {
  id             String   @id
  agentId        String
  threadId       String
  requestId      String
  gmailMessageId String?
  subject        String
  toAddresses    String[] @default([])
  ccAddresses    String[] @default([])
  bccAddresses   String[] @default([])
  /// pending | sent | failed
  status         String   @default("pending")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([threadId, requestId])
  @@index([agentId])
  @@index([gmailMessageId])
}

// -----------------------------------------------------------------------------
// Comprehensive customer view + 90-day historic backfill (ADR 0017).
// One row per (provider, agentId) initial-connect backfill so the UI can
// surface progress, and so an idempotent re-run is safe to attempt.
// -----------------------------------------------------------------------------

enum BackfillProvider {
  gmail
  aircall
  trengo
  slack
  gocardless
}

enum BackfillJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

model BackfillJob {
  id             String            @id
  provider       BackfillProvider
  /// Null for shared-token providers (Aircall, Slack). For per-agent
  /// providers (Gmail, Trengo) this is the User.id whose token drives the
  /// backfill.
  agentId        String?
  windowFrom     DateTime
  windowTo       DateTime
  status         BackfillJobStatus @default(pending)
  /// Optional grand-total (set by the worker once it has a count from the
  /// provider — `null` while we are still discovering pages).
  totalCount     Int?
  processedCount Int               @default(0)
  matchedCount   Int               @default(0)
  skippedCount   Int               @default(0)
  /// Provider-side cursor for resumability across step retries.
  lastEventId    String?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([provider, agentId, status])
  @@index([status, createdAt])
}

model GmailToken {
  /// User.id. Legacy refresh-token table; ADR 0012 migrated active rows to
  /// EncryptedField via User.gmailRefreshTokenCipherId. Kept for fallback.
  agentId         String    @id
  tokenCiphertext Bytes
  tokenIv         Bytes
  dekCiphertext   Bytes
  aad             Bytes
  keyVersion      Int
  expiresAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
}

// -----------------------------------------------------------------------------
// Communications Hub — multi-account email operating system (ADR 0021).
//
// `MailAccount` is the provider-agnostic unit of "a connected inbox",
// generalising the Gmail-only `GmailMailbox`. One row per connected email
// address — personal (one agent) or shared (a team inbox like info@ /
// admissions@) — across Gmail/Workspace/Outlook/Exchange/IMAP. Secrets (OAuth
// refresh tokens, IMAP passwords) are NEVER stored here; they live in
// `EncryptedField` (§21). For provider=gmail a row bridges to the legacy
// `GmailMailbox` via `gmailMailboxId`, so the hub reuses the live Gmail sync
// with no destructive migration (forward-only, §19.1).
// -----------------------------------------------------------------------------

enum MailProvider {
  gmail
  google_workspace
  outlook
  exchange
  imap
}

enum MailAccountOwnerKind {
  /// Belongs to one agent — their own mailbox.
  personal
  /// A team inbox (info@, admissions@, …) accessed by many agents via
  /// MailAccountMember rows.
  shared
}

enum MailAccountStatus {
  connected
  needs_reconnect
  disconnected
  error
}

model MailAccount {
  id          String               @id
  provider    MailProvider
  address     String               @unique
  displayName String?
  ownerKind   MailAccountOwnerKind @default(personal)
  /// Connecting/owning agent (User.id). For shared inboxes this is the user
  /// who connected it; access is governed by MailAccountMember. Plain column,
  /// matching the GmailMailbox.agentId / Conversation.assigneeUserId
  /// convention (not every userId is a FK in this schema).
  ownerUserId String?
  /// Optional owning ops Team for a shared inbox (Admissions, Sales, …).
  teamId      String?
  status      MailAccountStatus    @default(connected)
  /// Default send-from mailbox for the owning agent. App-level invariant: at
  /// most one personal account per ownerUserId is the default.
  isDefault   Boolean              @default(false)
  /// Generic provider sync cursor. Opaque string each provider interprets in
  /// its own terms (Gmail historyId, Graph deltaToken, IMAP UID).
  syncCursor  String?
  /// Push-subscription expiry (Gmail watch / Graph subscription). Null for
  /// poll-only providers (IMAP).
  watchExpiresAt DateTime?
  lastSyncedAt   DateTime?
  /// Bridge to the legacy per-agent Gmail row (provider=gmail only). 1:1.
  gmailMailboxId String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  team          Team?               @relation(fields: [teamId], references: [id])
  gmailMailbox  GmailMailbox?       @relation(fields: [gmailMailboxId], references: [id])
  members       MailAccountMember[]
  /// ADR 0021 Phase 3a: Conversation heads belonging to this account.
  conversations Conversation[]

  @@index([ownerUserId, deletedAt])
  @@index([ownerKind, status])
  @@index([teamId])
  @@index([provider])
}

/// Access grant to a shared mail account (team inbox). Mirrors TeamMember.
/// Personal accounts need no rows here — the owner is implicit.
model MailAccountMember {
  id            String @id
  mailAccountId String
  /// User.id (plain column, matching TeamMember.userId).
  userId        String
  /// agent (read + send) | viewer (read-only). App-enforced.
  access        String @default("agent")

  createdAt   DateTime @default(now())
  createdById String?

  mailAccount MailAccount @relation(fields: [mailAccountId], references: [id])

  @@unique([mailAccountId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// B2B Invoices Platform sync (b2b.studymind.co.uk). Live two-way mirror.
//
// We push writes via REST and receive changes via webhooks + SSE + a nightly
// events-feed reconcile. Every mirror row dedupes on the invoicing-side id
// (`invoicingId`) so all three inbound channels converge idempotently
// (CLAUDE.md §2 idempotency, §6 correlation, §19 money in minor units).
// -----------------------------------------------------------------------------

/// Customer categories on the invoicing platform ("partners" table). CRM
/// schools/partnerships map to `b2b`, individuals to `b2c`, AP/council to
/// `alt_provision`. Unknown values fail closed to `unknown` (CLAUDE.md §8).
enum InvoicingCustomerCategory {
  b2b
  b2c
  alt_provision
  unknown
}

enum InvoicingCustomerStatus {
  active
  on_hold
  archived
  unknown
}

enum InvoicingInvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
  unknown
}

enum InvoicingClientType {
  uk_b2b
  school
  summer_school
  international
  alt_provision
  unknown
}

/// Mirror of a customer on the invoicing platform. `invoicingId` is the dedup
/// key for every inbound channel. CRM correlation is via an optional
/// BusinessAccount (schools/partnerships/AP) or Contact (B2C individuals).
model InvoicingCustomer {
  id          String @id
  invoicingId String @unique

  category       InvoicingCustomerCategory @default(unknown)
  status         InvoicingCustomerStatus   @default(unknown)
  companyName    String
  contactName    String?
  contactEmail   String?
  contactEmailCc String?
  phone          String?
  address        String?
  country        String?
  vatNumber      String?
  service        String?
  tags           String[]                  @default([])
  notes          String?

  /// CRM correlation — at most one is set. Set on lookup-or-create so the two
  /// sides stay linked (CLAUDE.md task: persist the invoicing id on the row).
  businessAccountId String?
  contactId         String?

  /// Observability: when we last applied an event and what caused it
  /// (api | app | system). Helps debug echo-loop suppression.
  lastSyncedAt    DateTime?
  lastEventSource String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  businessAccount BusinessAccount?   @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  invoices        InvoicingInvoice[]

  @@index([businessAccountId])
  @@index([contactId])
  @@index([category])
  @@index([status])
}

/// Mirror of an invoice on the invoicing platform. Money is integer minor
/// units (pence) — the API's decimal strings/numbers are converted on the way
/// in and back out (CLAUDE.md §19, never floats for money).
model InvoicingInvoice {
  id            String  @id
  invoicingId   String  @unique
  /// Server-generated human number ("INV-1000"); persisted for correlation.
  invoiceNumber String?

  /// FK to our mirror customer plus the raw partner id, so an invoice that
  /// arrives before its customer still resolves once the customer syncs.
  customerId         String?
  invoicingPartnerId String?

  status     InvoicingInvoiceStatus @default(unknown)
  clientType InvoicingClientType    @default(unknown)
  currency   String                 @default("GBP")

  // Server-computed totals, mirrored in minor units.
  subtotalMinor   Int @default(0)
  vatTotalMinor   Int @default(0)
  grandTotalMinor Int @default(0)
  /// Sum of recorded payments in minor units (derived from payments[]).
  paidMinor       Int @default(0)

  pricesIncludeVat Boolean?
  issueDate        DateTime?
  dueDate          DateTime?
  paymentTerms     String?
  poNumber         String?
  paymentReference String?
  billToName       String?
  fromEmail        String?
  notes            String?
  internalNotes    String?
  lastEmailedAt    DateTime?
  /// When a payment reminder (chaser) was last sent from the CRM. Stamped by
  /// the `invoicing.invoices.sendReminder` outbound, mirroring `lastEmailedAt`
  /// for the initial send (the platform has no dedicated field for this).
  lastReminderAt   DateTime?

  lastSyncedAt    DateTime?
  lastEventSource String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  customer  InvoicingCustomer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineItems InvoicingLineItem[]
  payments  InvoicingPayment[]

  @@index([customerId])
  @@index([invoicingPartnerId])
  @@index([status])
  @@index([invoiceNumber])
}

/// Mirror of an invoice line item. `quantity` is kept as the raw decimal
/// string (hours can be fractional) to avoid float drift; `unitPriceMinor`
/// is money in pence.
model InvoicingLineItem {
  id          String @id
  /// Invoicing-side line id when present; else a deterministic
  /// `<invoiceInvoicingId>:<position>` composite so re-sync is idempotent.
  invoicingId String @unique
  invoiceId   String

  description    String
  quantity       String
  unitPriceMinor Int
  /// VAT rate as a percentage integer (e.g. 20). Null when not provided.
  vatRate        Int?
  position       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice InvoicingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Mirror of a payment recorded against an invoice. Dedupes on the
/// invoicing-side payment id so a webhook + our own POST never double-count
/// (CLAUDE.md acceptance: no double-payment).
model InvoicingPayment {
  id          String @id
  invoicingId String @unique
  invoiceId   String

  amountMinor Int
  currency    String    @default("GBP")
  method      String?
  reference   String?
  paidAt      DateTime?

  lastEventSource String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  invoice InvoicingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Singleton config for the invoicing integration. API key + webhook secret
/// are envelope-encrypted at rest (CLAUDE.md §21). Cursors let the SSE stream
/// and the nightly events-feed reconcile resume without gaps.
model InvoicingSetting {
  /// Always the literal "default" — single-tenant singleton.
  id String @id @default("default")

  /// Base URL of the invoicing API. Override only for staging.
  baseUrl String @default("https://b2b.studymind.co.uk")

  // Envelope-encrypted API key (sk_live_…). Null until configured.
  apiKeyCiphertext    Bytes?
  apiKeyIv            Bytes?
  apiKeyDekCiphertext Bytes?
  apiKeyAad           Bytes?
  apiKeyKeyVersion    Int?
  /// Last 4 chars of the key for the UI ("…a1b2"). Never the whole key.
  apiKeyLast4         String?

  // Envelope-encrypted webhook secret (whsec_…).
  webhookSecretCiphertext    Bytes?
  webhookSecretIv            Bytes?
  webhookSecretDekCiphertext Bytes?
  webhookSecretAad           Bytes?
  webhookSecretKeyVersion    Int?

  /// Events-feed cursor (GET /api/v1/events?since=). Persisted as we process.
  eventsCursor String?
  /// Highest SSE event id processed (GET /api/v1/stream?since=).
  streamCursor String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

// -----------------------------------------------------------------------------
// Internal team messaging (ADR 0022). A Slack-style workspace chat for staff:
// public/private channels, direct messages, threaded replies, @mentions of
// teammates, emoji reactions, and inline references to CRM entities (Contact,
// Family, Card, Task). This is staff↔staff communication — message bodies are
// deliberately kept OUT of the customer Interaction timeline and out of the
// 7-year compliance AuditLog (high-volume, non-compliance). Channel
// administration (create/archive/membership) IS audited at the tRPC layer.
// CLAUDE.md §4 (modern UI), §20 (RBAC), §45 (events).
// -----------------------------------------------------------------------------

enum ChatChannelKind {
  public
  private
  dm
}

model ChatChannel {
  id          String          @id
  /// Human name (also the slug) for public/private channels. Null for `dm`
  /// channels — their title is derived from their members at render time.
  name        String?
  topic       String?
  description String?
  kind        ChatChannelKind @default(public)
  /// The seeded company-wide channel everyone lands in. At most one row true.
  isGeneral   Boolean         @default(false)
  /// Stable dedupe key for direct messages: the sorted member user-ids joined
  /// by ':'. Makes "open DM with X" idempotent. Null for named channels.
  dmKey       String?         @unique

  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  members  ChatChannelMember[]
  messages ChatMessage[]

  // Name uniqueness is enforced in the domain layer (createChannel checks for
  // a non-archived clash), mirroring Board — a name can be reused once the old
  // channel is archived, which a DB-level unique constraint would forbid.
  @@index([name])
  @@index([kind, archivedAt])
}

model ChatChannelMember {
  id          String    @id
  channelId   String
  userId      String
  /// Slack-style read state: everything created at/before this instant is read.
  lastReadAt  DateTime?
  /// Per-channel notification preference: all | mentions | none.
  notifyLevel String    @default("all")
  /// member | admin. Channel admins (and Manager+) can edit/archive a channel.
  role        String    @default("member")
  /// Set when the member mutes the channel (no unread badge contribution).
  mutedAt     DateTime?

  createdAt   DateTime  @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String  @id
  channelId String
  authorId  String
  body      String
  /// Thread model (two-level, like Slack): null = a top-level channel message;
  /// set = a reply belonging to that root message's thread.
  parentId  String?
  /// Denormalised on the ROOT message for fast thread previews on the channel.
  replyCount  Int       @default(0)
  lastReplyAt DateTime?

  editedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel     ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent      ChatMessage?        @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ChatMessage[]       @relation("ChatThread")
  mentions    ChatMention[]
  refs        ChatMessageRef[]
  reactions   ChatReaction[]
  attachments ChatAttachment[]
  pins        ChatPin[]
  saves       ChatSavedItem[]

  /// Channel timeline (top-level rows have parentId IS NULL) ordered by recency.
  @@index([channelId, parentId, createdAt])
  /// Thread replies ordered oldest-first.
  @@index([parentId, createdAt])
  @@index([channelId, createdAt])
}

/// A file or image attached to a chat message (ADR 0022 — richer messages).
/// Bytes live in S3 with SSE:KMS (CLAUDE.md §21.1), never in Postgres; this row
/// holds the metadata + the S3 key. Uploaded in two phases: the bytes are
/// staged to S3 first (returning an attachmentId + s3Key), then the ids are
/// passed to `chat.send`, which creates these rows bound to the new message.
/// Cascades with the message (and so with the channel).
model ChatAttachment {
  id          String  @id
  messageId   String
  /// Original filename, sanitised for display.
  filename    String
  /// MIME type as reported at upload (sniffed/validated server-side).
  contentType String
  /// Byte size — surfaced in the UI and used to enforce the per-file ceiling.
  sizeBytes   Int
  /// S3 object key under chat/attachments/{messageId}/{id}/{filename}.
  s3Key       String
  /// Image pixel dimensions when known, so the client can reserve layout space
  /// and avoid CLS. Null for non-images.
  width       Int?
  height      Int?

  createdAt   DateTime @default(now())
  createdById String?

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// A pinned message in a channel (ADR 0022 — pins & saves). Shared, channel-
/// scoped (like Slack's Pins tab): any member can pin/unpin; everyone in the
/// channel sees the same set. One pin per message (a message is pinned or not).
/// Cascades with the message and the channel.
model ChatPin {
  id          String   @id
  messageId   String   @unique
  channelId   String
  /// Who pinned it, for the "pinned by …" line.
  pinnedById  String
  createdAt   DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

/// A personal saved/bookmarked message (ADR 0022 — pins & saves). Per-user and
/// private (like Slack's "Later" / saved items): only the owner sees their
/// saves. One save per (user, message). Cascades with the message.
model ChatSavedItem {
  id        String   @id
  userId    String
  messageId String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, createdAt])
}

model ChatMention {
  id        String    @id
  messageId String
  /// The mentioned teammate. (@channel/@here may later use sentinel ids.)
  userId    String
  /// Denormalised so "my mentions across all channels" is one index hit.
  channelId String
  /// Mention-specific read state — drives the "Mentions" inbox + bell badge.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

enum ChatRefType {
  contact
  family
  card
  task
}

model ChatMessageRef {
  id        String      @id
  messageId String
  refType   ChatRefType
  refId     String
  createdAt DateTime    @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([refType, refId])
  @@index([messageId])
}

model ChatReaction {
  id        String   @id
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// -----------------------------------------------------------------------------
// Weekly webinars / live classes (auto-enrollment system).
//
// Parents pay weekly for live subject classes (Biology / Chemistry / Physics /
// Maths at GCSE and A-Level) via Stripe subscriptions. The CRM detects those
// payers, organises them into the right class (deterministic matcher first,
// AI advisory only when the rules are unsure — CLAUDE.md §3, §18), then sends a
// weekly email carrying the Zoom link and a PDF schedule. When a subscription
// lapses the enrolment expires and the emails stop. All times are stored UTC;
// the wall-clock slot is held as a local weekday + minute + IANA timezone.
// -----------------------------------------------------------------------------

enum WebinarLevel {
  gcse
  a_level
}

enum WebinarCohortStatus {
  planning
  active
  archived
}

/// Enrolment lifecycle. `pending_review` = the matcher found a candidate but a
/// human has not confirmed it (low confidence, or policy requires review).
/// `active` = receiving weekly emails. `paused` = temporarily muted by staff.
/// `expired` = the backing Stripe subscription lapsed. `cancelled` = removed by
/// staff. Only `active` enrolments are emailed.
enum WebinarEnrollmentStatus {
  pending_review
  active
  paused
  expired
  cancelled
}

/// How the enrolment came to be. `auto_rule` = deterministic keyword matcher.
/// `ai_advisory` = the AI organiser suggested it (always lands as
/// `pending_review`). `manual` = a staff member added it by hand.
enum WebinarEnrollmentSource {
  auto_rule
  ai_advisory
  manual
}

/// Per-session, per-enrolment email log. Doubles as the idempotency guard so a
/// retried job never double-sends a week's email.
enum WebinarDispatchStatus {
  scheduled
  sent
  skipped_holiday
  skipped_inactive
  failed
}

/// An academic year of classes, e.g. "2026/2027". Holidays and classes hang off
/// it. Future cohorts are created ahead of time and flipped to `active` when the
/// year starts.
model WebinarCohort {
  id       String              @id
  /// Display name, unique. "2026/2027".
  name     String              @unique
  startsOn DateTime            @db.Date
  endsOn   DateTime            @db.Date
  status   WebinarCohortStatus @default(planning)
  /// IANA timezone the cohort's wall-clock slots are expressed in.
  timezone String              @default("Europe/London")
  notes    String?

  /// Per-cohort email template + send schedule (CLAUDE.md §47). Each cohort
  /// authors its own weekly reminder; classes inherit it. Null = fall back to
  /// the built-in default. `emailBodyHtml` is an optional rich/HTML version sent
  /// alongside the plaintext body.
  emailSubjectTemplate String?
  emailBodyTemplate    String?
  emailBodyHtml        String?
  fromName             String?
  /// Reminder send days (0=Mon..6=Sun, default Mon+Tue) and local send hour.
  sendDaysOfWeek       Int[]   @default([0, 1])
  sendHourLocal        Int     @default(9)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  holidays WebinarHoliday[]
  classes  WebinarClass[]

  @@index([status])
}

/// A break in a cohort during which no class emails are sent. Fully
/// customisable; the seed pre-fills the usual UK term breaks.
model WebinarHoliday {
  id       String   @id
  cohortId String
  name     String
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  cohort WebinarCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
}

/// One weekly class within a cohort (a subject at a level). Holds the
/// customisable Zoom link + rotation tracking, the weekly slot, the email
/// send-offset and template overrides, and either a generated syllabus
/// (WebinarSyllabusWeek rows) or an uploaded PDF.
model WebinarClass {
  id           String       @id
  cohortId     String
  /// Lower-case subject handle (biology, chemistry, …). Free string backed by
  /// the WebinarSubjectOption catalogue so admins add subjects with no migration.
  subject      String
  /// Lower-case level/type handle (gcse, a_level, ucat, gamsat, …). Free string
  /// backed by the WebinarLevelOption catalogue — admins add levels/types too.
  level        String
  title        String
  /// 0 = Monday … 6 = Sunday (matches CallPeakWindow's convention).
  dayOfWeek    Int
  /// Minutes from local midnight, e.g. 1080 = 18:00.
  startMinute  Int
  durationMins Int          @default(60)
  timezone     String       @default("Europe/London")

  /// Customisable join link. Rotated periodically; staff are reminded.
  zoomLink             String?
  zoomLinkUpdatedAt    DateTime?
  zoomRotateEveryWeeks Int       @default(4)
  /// When the link was generated by the Zoom integration (ADR 0035), the Zoom
  /// meeting id + host so we can fetch recordings / regenerate. Null for a
  /// hand-pasted link.
  zoomMeetingId        String?
  zoomHostEmail        String?

  /// Reminder send days, 0=Mon..6=Sun (default Mon+Tue). One email goes out on
  /// each listed day of the class's week, carrying that week's Zoom link + PDF.
  sendDaysOfWeek       Int[]   @default([0, 1])
  /// Local hour (0-23) on a send day from which the reminder may go out.
  sendHourLocal        Int     @default(9)
  /// DEPRECATED — superseded by sendDaysOfWeek/sendHourLocal. Retained
  /// forward-only (§19); no longer read by the dispatcher.
  sendOffsetHours      Int     @default(24)
  /// Per-class overrides; fall back to WebinarSettings when null.
  emailSubjectTemplate String?
  emailBodyTemplate    String?

  active Boolean @default(true)

  /// Optional uploaded syllabus PDF (admin-supplied). When present it is
  /// attached verbatim instead of the generated schedule. Stored in Postgres
  /// like CallSummaryTemplate so a self-hosted install needs no S3.
  syllabusPdfData        Bytes?
  syllabusPdfFileName    String?
  syllabusPdfContentType String?
  syllabusPdfByteSize    Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  cohort        WebinarCohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  syllabusWeeks WebinarSyllabusWeek[]
  enrollments   WebinarEnrollment[]
  dispatches    WebinarEmailDispatch[]

  @@unique([cohortId, subject, level])
  @@index([cohortId])
  @@index([active])
}

/// A single week of an app-generated syllabus. Drives the PDF schedule when no
/// uploaded PDF is attached.
model WebinarSyllabusWeek {
  id         String  @id
  classId    String
  weekNumber Int
  topic      String
  notes      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  webinarClass WebinarClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, weekNumber])
  @@index([classId])
}

/// A contact's enrolment in a class. `stripeSubscriptionId`/`stripeCustomerId`
/// are the EXTERNAL Stripe ids (not our mirror row ids) so the expiry walker
/// can resolve the live subscription without a hard FK into the finance mirror.
model WebinarEnrollment {
  id                   String                  @id
  classId              String
  contactId            String
  stripeSubscriptionId String?
  stripeCustomerId     String?
  status               WebinarEnrollmentStatus @default(pending_review)
  source               WebinarEnrollmentSource @default(manual)
  /// 0..1 matcher confidence; null for manual adds.
  matchConfidence      Float?
  matchReason          String?
  /// Mirrors the subscription's current_period_end. For a yearly subscription
  /// this is ~1 year from purchase (Stripe's period end), giving a year of
  /// access; for monthly it advances each renewal. Null = no known expiry.
  expiresAt            DateTime?
  /// Stripe billing interval: "month" | "year" (display + reasoning). Null for
  /// manual adds.
  billingInterval      String?
  /// When the enrolment first became `active`.
  enrolledAt           DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  webinarClass WebinarClass           @relation(fields: [classId], references: [id], onDelete: Cascade)
  contact      Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dispatches   WebinarEmailDispatch[]

  @@unique([classId, contactId])
  @@index([contactId])
  @@index([status])
  @@index([stripeSubscriptionId])
}

/// Per-reminder, per-enrolment email record. The unique
/// (enrollmentId, weekNumber, sendDayOfWeek) is the idempotency key — each
/// reminder day in a class-week sends at most once, however often the job runs.
model WebinarEmailDispatch {
  id           String                @id
  classId      String
  enrollmentId String
  weekNumber   Int
  /// Which reminder day this row covers (0=Mon..6=Sun).
  sendDayOfWeek Int                  @default(0)
  sessionAt    DateTime
  status       WebinarDispatchStatus @default(scheduled)
  gmailMessageId String?
  error          String?
  sentAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinarClass WebinarClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollment   WebinarEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, weekNumber, sendDayOfWeek])
  @@index([classId, weekNumber])
  @@index([status])
}

/// Singleton (id = "webinar") holding the system-wide email defaults and the
/// sending mailbox. Per-class fields override these.
model WebinarSettings {
  id                          String  @id
  /// User.id whose connected Gmail sends the weekly emails. Null = resolve the
  /// system mailbox (SYSTEM_GMAIL_EMAIL) at send time.
  senderMailboxUserId         String?
  /// Default reminder send days (0=Mon..6=Sun) and local send hour.
  defaultSendDaysOfWeek       Int[]   @default([0, 1])
  defaultSendHourLocal        Int     @default(9)
  /// DEPRECATED — superseded by the send-day model. Retained forward-only.
  defaultSendOffsetHours      Int     @default(24)
  defaultZoomRotateEveryWeeks Int     @default(4)
  emailSubjectTemplate        String
  emailBodyTemplate           String
  fromName                    String?

  /// Zoom integration (ADR 0035). When `zoomAutoCreate` is on, creating a class
  /// can generate its meeting automatically. `zoomSendRecordings` emails the
  /// cloud recording to the class list after each session; `zoomTrashAfterSend`
  /// then moves it to Zoom Trash (recoverable). Both default OFF. `zoomHostEmail`
  /// is the default Zoom host the meetings are created under.
  zoomAutoCreate      Boolean @default(false)
  zoomSendRecordings  Boolean @default(false)
  zoomTrashAfterSend  Boolean @default(false)
  zoomHostEmail       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

/// Per-occurrence log of a class recording emailed out (ADR 0035). The unique
/// (classId, occurrenceUuid) is the idempotency guard so a retried job never
/// re-emails or re-trashes the same recording.
model WebinarRecordingDispatch {
  id             String    @id
  classId        String
  occurrenceUuid String
  shareUrl       String?
  /// sent | failed | trashed
  status         String    @default("sent")
  recipientCount Int       @default(0)
  error          String?
  sentAt         DateTime?
  trashedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, occurrenceUuid])
  @@index([status])
}

/// Operator-managed catalogue of webinar subjects (Biology, Chemistry, …). The
/// "New class" workflow reads this for its Subject dropdown, and admins can add
/// new subjects without a code change (CLAUDE.md §47). `handle` is the stable
/// lower-case key stored on WebinarClass.subject; `aliases` are extra spellings
/// the Stripe matcher should also recognise for this subject.
model WebinarSubjectOption {
  id        String   @id
  handle    String   @unique
  label     String
  aliases   String[] @default([])
  sortOrder Int      @default(100)
  archivedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([archivedAt])
}

/// Operator-managed catalogue of webinar levels/types (GCSE, A-Level, UCAT,
/// GAMSAT, 11+, …). The "New class" workflow reads this for its Level dropdown,
/// and admins can add new levels/types without a code change. `handle` is the
/// stable lower-case key stored on WebinarClass.level; `aliases` are extra
/// spellings the Stripe matcher should also recognise.
model WebinarLevelOption {
  id        String   @id
  handle    String   @unique
  label     String
  aliases   String[] @default([])
  sortOrder Int      @default(100)
  archivedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([archivedAt])
}

/// A complaint logged against a customer (Contact). Surfaced on the contact
/// page and on the Active complaints queue. Follow-ups + action points hang
/// off it via ComplaintUpdate; it can be converted into a follow-up Task.
/// Status/severity are text (validated fail-closed in the app layer).
model Complaint {
  id          String  @id
  contactId   String
  title       String
  description String?
  /// open | in_progress | resolved | dismissed. "Active" = open | in_progress.
  status      String  @default("open")
  /// low | medium | high.
  severity    String  @default("medium")
  /// Free-text category (billing, scheduling, tutor, safeguarding, …).
  category    String?
  assigneeId  String?
  /// Optional link to a follow-up Task created from this complaint.
  taskId       String?   @unique
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contact Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  task    Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  updates ComplaintUpdate[]

  @@index([status])
  @@index([contactId, createdAt])
  @@index([assigneeId])
}

/// A follow-up note or action point on a complaint — the audit trail of how a
/// complaint was worked. Action points carry a done flag.
model ComplaintUpdate {
  id            String   @id
  complaintId   String
  body          String
  /// True when this update is an action point (a to-do) rather than a note.
  isActionPoint Boolean  @default(false)
  /// For action points: whether it has been completed.
  done          Boolean  @default(false)
  createdAt     DateTime @default(now())
  createdById   String?

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
}

/// Local edits to the imported Protocols & Policies knowledge base
/// (ADR 0040). Single row (id = "knowledge") holding the FULL live
/// knowledge JSON once it has been edited in-app; no row = the
/// checked-in baseline (crib-data.json + commonScenarios) is live.
/// AI proposes patches, a human (CEO / Senior Manager) confirms;
/// every apply / reset is audited (knowledge.updated / knowledge.reset).
model KnowledgeOverride {
  id          String   @id
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}
