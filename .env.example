# StudyMind All in One CRM - environment variables.
# Copy to .env.local and fill from 1Password vault "StudyMind CRM Dev".
# Never commit a real secret.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studymind_crm?schema=public"

# Redis (Inngest queue, rate limit, response cache)
REDIS_URL="redis://localhost:6379"

# Auth.js v5 (self-hosted; ADR 0010). Real wiring lands in chunk 5.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# When 'true', privileged roles (super_admin, admin, finance, dsl) are forced
# to set up TOTP before they can use the app — see CLAUDE.md §20. Default is
# unset (= disabled) so a fresh deploy can sign in without 2FA friction. Flip
# on once your team is ready to enrol.
MANDATORY_MFA_ENABLED=

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# GoCardless
GOCARDLESS_ACCESS_TOKEN="sandbox_replace_me"
GOCARDLESS_WEBHOOK_SECRET="replace_me"
GOCARDLESS_ENVIRONMENT="sandbox"

# Aircall
AIRCALL_API_ID="replace_me"
AIRCALL_API_TOKEN="replace_me"
AIRCALL_WEBHOOK_TOKEN="replace_me"

# Trengo
TRENGO_API_BASE_URL="https://app.trengo.com/api/v2"
TRENGO_WEBHOOK_SECRET="replace_me"

# Slack
SLACK_SIGNING_SECRET="replace_me"
SLACK_BOT_TOKEN="xoxb-replace_me"

# Asana
ASANA_PERSONAL_ACCESS_TOKEN="replace_me"
ASANA_WEBHOOK_SECRET="replace_me"

# Gmail (legacy names; kept for backwards compat with packages/integrations/gmail)
GMAIL_OAUTH_CLIENT_ID="replace_me"
GMAIL_OAUTH_CLIENT_SECRET="replace_me"
GMAIL_PUBSUB_TOPIC="projects/studymind/topics/gmail-watch"

# Gmail OAuth (per-agent flow — ADR 0012). Same client credentials as above
# but spelled with the Google convention; the OAuth route handlers read these.
GOOGLE_OAUTH_CLIENT_ID="replace_me"
GOOGLE_OAUTH_CLIENT_SECRET="replace_me"

# Public origin used to compute OAuth redirect URIs and email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External sister-app surfaces linked from the sidebar. Override to point
# at staging or self-hosted alternatives.
NEXT_PUBLIC_MAIN_PORTAL_URL="https://portal.studymind.co.uk"
NEXT_PUBLIC_INVOICE_SITE_URL="https://b2b.studymind.co.uk"

# Booking site
BOOKING_API_BASE_URL="https://booking.studymind.co.uk/api"
BOOKING_API_TOKEN="replace_me"

# B2B Invoices Platform (b2b.studymind.co.uk). Live two-way sync.
# These are FALLBACKS only — the preferred path is Settings → Invoicing, which
# stores the API key + webhook secret envelope-encrypted in InvoicingSetting.
# When the DB row is unset, the integration reads these instead.
INVOICING_API_BASE_URL="https://b2b.studymind.co.uk"
# Read+write API key minted by the invoicing team (sk_live_…).
INVOICING_API_KEY=""
# HMAC signing secret returned when you register this CRM's webhook receiver
# (whsec_…). The receiver lives at <origin>/api/webhooks/invoicing.
INVOICING_WEBHOOK_SECRET=""

# OpenAI
OPENAI_API_KEY="sk-replace_me"

# AWS KMS + S3
AWS_REGION="eu-west-2"
# Field-level encryption (Trengo/Gmail tokens — CLAUDE.md §21) prefers AWS KMS.
# If you are NOT running AWS, leave AWS_KMS_KEY_ID blank and the app falls back
# to a local AES-256 master key: set CRM_LOCAL_ENCRYPTION_KEY below, or (if even
# that is blank) the key is derived from AUTH_SECRET automatically.
AWS_KMS_KEY_ID="alias/crm-dev"
# Local field-encryption key for self-hosted installs without AWS KMS.
# 32 bytes, base64 or hex. Generate with: openssl rand -base64 32
# Leave blank to derive from AUTH_SECRET (do not rotate AUTH_SECRET afterwards
# without re-encrypting stored tokens).
CRM_LOCAL_ENCRYPTION_KEY=""
AWS_KMS_KEY_ARN="arn:aws:kms:eu-west-2:000000000000:alias/crm-dev"
S3_BUCKET="studymind-crm-dev"
# Bucket for Aircall recordings persisted before Aircall's retention window expires.
# CLAUDE.md §10. Server-side encryption uses AWS_KMS_KEY_ID.
S3_RECORDINGS_BUCKET="studymind-crm-dev-recordings"
# On-duty DSL fallback when the dsl_rota table has no current entry. CLAUDE.md §42.
DEFAULT_DSL_USER_ID=""

# Inngest
INNGEST_EVENT_KEY="replace_me"
INNGEST_SIGNING_KEY="signkey-replace_me"

# Observability
AXIOM_TOKEN="xaat-replace_me"
AXIOM_DATASET="studymind-crm-dev"
SENTRY_DSN="https://replace_me@sentry.io/replace_me"
NEXT_PUBLIC_SENTRY_DSN="https://replace_me@sentry.io/replace_me"
SENTRY_ENVIRONMENT="development"
SENTRY_AUTH_TOKEN="replace_me"
SENTRY_ORG="studymind"
SENTRY_PROJECT="crm"
# Railway sets this automatically per deploy; used as the Sentry release tag.
RAILWAY_GIT_COMMIT_SHA=""
# OpenTelemetry (chunk 3). Leave blank locally to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# Resend (transactional email)
RESEND_API_KEY="re_replace_me"

# Mailchimp (CLAUDE.md §16). When unset, the per-contact "Push to Mailchimp"
# button surfaces a friendly "not configured" error rather than failing the
# request silently. API key shape is `xxxxx-usN` — the datacenter is parsed
# off the suffix.
MAILCHIMP_API_KEY=""
MAILCHIMP_DEFAULT_LIST_ID=""

# Lead webhook (Zapier and partner ingest). The handler reads
# LEAD_WEBHOOK_BEARER_TOKEN first and falls back to LEAD_WEBHOOK_TOKEN
# for backward compatibility with older Railway environments.
LEAD_WEBHOOK_BEARER_TOKEN="replace_me"
LEAD_WEBHOOK_TOKEN="replace_me"
