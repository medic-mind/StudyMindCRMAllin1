# StudyMind All in One CRM - environment variables.
# Copy to .env.local and fill from 1Password vault "StudyMind CRM Dev".
# Never commit a real secret.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studymind_crm?schema=public"

# Redis (Inngest queue, rate limit, response cache)
REDIS_URL="redis://localhost:6379"

# Auth.js v5 (self-hosted; ADR 0010). Real wiring lands in chunk 5.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# When 'true', privileged roles (super_admin, admin, finance, dsl) are forced
# to set up TOTP before they can use the app — see CLAUDE.md §20. Default is
# unset (= disabled) so a fresh deploy can sign in without 2FA friction. Flip
# on once your team is ready to enrol.
MANDATORY_MFA_ENABLED=

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# GoCardless
GOCARDLESS_ACCESS_TOKEN="sandbox_replace_me"
GOCARDLESS_WEBHOOK_SECRET="replace_me"
GOCARDLESS_ENVIRONMENT="sandbox"

# Aircall
AIRCALL_API_ID="replace_me"
AIRCALL_API_TOKEN="replace_me"
AIRCALL_WEBHOOK_TOKEN="replace_me"

# Trengo
TRENGO_API_BASE_URL="https://app.trengo.com/api/v2"
TRENGO_WEBHOOK_SECRET="replace_me"

# Slack
SLACK_SIGNING_SECRET="replace_me"
SLACK_BOT_TOKEN="xoxb-replace_me"

# Asana
ASANA_PERSONAL_ACCESS_TOKEN="replace_me"
ASANA_WEBHOOK_SECRET="replace_me"

# Gmail (legacy names; kept for backwards compat with packages/integrations/gmail)
GMAIL_OAUTH_CLIENT_ID="replace_me"
GMAIL_OAUTH_CLIENT_SECRET="replace_me"
GMAIL_PUBSUB_TOPIC="projects/studymind/topics/gmail-watch"
# Pub/Sub push auth checked by the Gmail webhook (apps/web/.../webhooks/gmail):
# the OIDC token's audience must equal GMAIL_PUBSUB_AUDIENCE (set this to the
# webhook URL you configure on the push subscription), and — optionally — the
# signer's email must equal GMAIL_PUBSUB_SERVICE_ACCOUNT.
GMAIL_PUBSUB_AUDIENCE="https://crm.studymind.co.uk/api/webhooks/gmail"
GMAIL_PUBSUB_SERVICE_ACCOUNT=""

# Gmail OAuth (per-agent flow — ADR 0012). The connect/callback route AND the
# background refresh client (packages/integrations/gmail) both read these, so a
# refresh always uses the same OAuth client that minted the token (a mismatch
# would fail with invalid_client). Falls back to GOOGLE_CLIENT_ID/SECRET and
# GMAIL_OAUTH_CLIENT_ID/SECRET for older deployments — set ONE consistently.
GOOGLE_OAUTH_CLIENT_ID="replace_me"
GOOGLE_OAUTH_CLIENT_SECRET="replace_me"

# Public origin used to compute OAuth redirect URIs and email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External sister-app surfaces linked from the sidebar. Override to point
# at staging or self-hosted alternatives.
NEXT_PUBLIC_MAIN_PORTAL_URL="https://portal.studymind.co.uk"
NEXT_PUBLIC_INVOICE_SITE_URL="https://b2b.studymind.co.uk"

# Booking site (read-only student-centric pull — ADR 0029, docs/api/booking-pull-api.md).
# Leave BOOKING_API_TOKEN unset to keep the sync jobs dormant (they no-op).
BOOKING_API_BASE_URL="https://booking.studymind.co.uk/api/v1"
BOOKING_API_TOKEN=""

# Summer Camp app (camp.studymind.co.uk). Distinct from the booking site above.
# Inbound: the camp app pushes booking create/update/cancel to
# <origin>/api/webhooks/summer-camp, signed with an HMAC-SHA256 of the raw body
# (header x-summer-camp-signature). This secret must match the camp app's
# CRM_WEBHOOK_SECRET.
SUMMER_CAMP_WEBHOOK_SECRET=""
# Outbound: the read-only feeds the CRM pulls for the live "Summer Camps" view.
# SUMMER_CAMP_API_URL is the camp app base URL; SUMMER_CAMP_API_KEY is the
# bearer token the camp app expects (its CRM_READ_API_KEY). Unset → the
# Summer Camps page shows a "not connected" state.
SUMMER_CAMP_API_URL="https://camp.studymind.co.uk"
SUMMER_CAMP_API_KEY=""
# How far back the recurring summer-camp/sync-bookings cron re-pulls each run
# (days). Idempotent, so overlap is cheap; default 3.
SUMMER_CAMP_SYNC_LOOKBACK_DAYS="3"

# B2B Invoices Platform (b2b.studymind.co.uk). Live two-way sync.
# These are FALLBACKS only — the preferred path is Settings → Invoicing, which
# stores the API key + webhook secret envelope-encrypted in InvoicingSetting.
# When the DB row is unset, the integration reads these instead.
INVOICING_API_BASE_URL="https://b2b.studymind.co.uk"
# Read+write API key minted by the invoicing team (sk_live_…).
INVOICING_API_KEY=""
# HMAC signing secret returned when you register this CRM's webhook receiver
# (whsec_…). The receiver lives at <origin>/api/webhooks/invoicing.
INVOICING_WEBHOOK_SECRET=""

# AI provider (ADR 0028). All AI on the site runs through packages/ai. Default
# is Gemini (then OpenAI). Anthropic (Claude) is available but OPT-IN ONLY: set
# AI_PROVIDER=anthropic to use it. Auto-select never picks Claude.
AI_PROVIDER="gemini"

# Google Gemini (default provider). Both quality tiers default to 2.5 Flash
# ("flash for most"); override either tier without touching code. Transcription
# (Aircall fallback) also runs on Gemini multimodal.
GEMINI_API_KEY="replace_me"
# GEMINI_MODEL_MINI="gemini-2.5-flash"        # high-volume classification/summaries
# GEMINI_MODEL_STANDARD="gemini-2.5-flash"    # set to gemini-2.5-pro for higher-quality drafts
# GEMINI_MODEL_TRANSCRIBE="gemini-2.5-flash"

# OpenAI (fallback provider; used when AI_PROVIDER=openai or no GEMINI_API_KEY).
OPENAI_API_KEY="sk-replace_me"
# OPENAI_MODEL_MINI="gpt-4o-mini"
# OPENAI_MODEL_STANDARD="gpt-4o"
# OPENAI_MODEL_TRANSCRIBE="whisper-1"

# Anthropic (Claude) — OPT-IN fallback. Only used when AI_PROVIDER=anthropic
# (never auto-selected). Models are env-overridable; Claude has no audio
# transcription, so the Aircall-fallback transcribe path uses Gemini/OpenAI.
ANTHROPIC_API_KEY="sk-ant-replace_me"
# ANTHROPIC_MODEL_MINI="claude-haiku-4-5-20251001"   # high-volume classification/extraction
# ANTHROPIC_MODEL_STANDARD="claude-sonnet-4-6"       # quality drafts

# AWS KMS + S3
AWS_REGION="eu-west-2"
# Field-level encryption (Trengo/Gmail tokens, invoicing API key — CLAUDE.md
# §21). AWS KMS is OPTIONAL. If you are not running AWS, LEAVE AWS_KMS_KEY_ID
# BLANK (as below) — the app then uses a local AES-256 key, derived
# automatically from AUTH_SECRET, with no AWS account required. Only set
# AWS_KMS_KEY_ID if you have a real CMK; a placeholder value makes the app try
# (and fail) to reach KMS.
AWS_KMS_KEY_ID=""
# Local field-encryption key for self-hosted installs without AWS KMS.
# 32 bytes, base64 or hex. Generate with: openssl rand -base64 32
# Leave blank to derive from AUTH_SECRET (do not rotate AUTH_SECRET afterwards
# without re-encrypting stored tokens).
CRM_LOCAL_ENCRYPTION_KEY=""
AWS_KMS_KEY_ARN=""
S3_BUCKET="studymind-crm-dev"
# Bucket for Aircall recordings persisted before Aircall's retention window expires.
# CLAUDE.md §10. Server-side encryption uses AWS_KMS_KEY_ID.
S3_RECORDINGS_BUCKET="studymind-crm-dev-recordings"
# On-duty DSL fallback when the dsl_rota table has no current entry. CLAUDE.md §42.
DEFAULT_DSL_USER_ID=""

# Inngest
INNGEST_EVENT_KEY="replace_me"
INNGEST_SIGNING_KEY="signkey-replace_me"

# Observability
AXIOM_TOKEN="xaat-replace_me"
AXIOM_DATASET="studymind-crm-dev"
SENTRY_DSN="https://replace_me@sentry.io/replace_me"
NEXT_PUBLIC_SENTRY_DSN="https://replace_me@sentry.io/replace_me"
SENTRY_ENVIRONMENT="development"
SENTRY_AUTH_TOKEN="replace_me"
SENTRY_ORG="studymind"
SENTRY_PROJECT="crm"
# Railway sets this automatically per deploy; used as the Sentry release tag.
RAILWAY_GIT_COMMIT_SHA=""
# OpenTelemetry (chunk 3). Leave blank locally to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""

# System / transactional email is sent via Gmail (Google OAuth) — never a
# third-party email API. The account below must have connected Gmail in
# Settings → My mailboxes; all system email (account welcome, password reset,
# verification, "forward to team") is sent from it, using the same Gmail OAuth
# credentials as the per-agent flow above. CLAUDE.md §14.
SYSTEM_GMAIL_EMAIL="info@studymind.co.uk"

# Mailchimp (CLAUDE.md §16). When unset, the per-contact "Push to Mailchimp"
# button surfaces a friendly "not configured" error rather than failing the
# request silently. API key shape is `xxxxx-usN` — the datacenter is parsed
# off the suffix.
MAILCHIMP_API_KEY=""
MAILCHIMP_DEFAULT_LIST_ID=""

# Lead capture. Two endpoints share this token:
#   - POST /api/leads        — universal Contact-Form-7 / JSON ingest (ADR 0023).
#                              Prefer per-site LeadSource API keys minted in
#                              Settings → Integrations → Lead webhook; this token
#                              is the optional zero-config global fallback key.
#   - POST /api/webhooks/lead — legacy Zapier bearer endpoint (docs/api/lead-webhook.md).
# The handlers read LEAD_WEBHOOK_BEARER_TOKEN first, then LEAD_WEBHOOK_TOKEN
# for backward compatibility with older Railway environments.
LEAD_WEBHOOK_BEARER_TOKEN="replace_me"
LEAD_WEBHOOK_TOKEN="replace_me"

# Medi Platform (Medic Mind UCAT portal) account sync (ADR 0037). The portal
# POSTs `user.registered` to POST /api/contacts with `Authorization: Bearer
# <this token>` whenever someone creates an account; we onboard them as a
# Contact (no board card / pipeline entry) and dedupe so later leads/calls
# annotate the same record. The receiver reads MEDI_SYNC_TOKEN first, then
# falls back to LEAD_WEBHOOK_BEARER_TOKEN / LEAD_WEBHOOK_TOKEN so ops can reuse
# one secret. Set the SAME value as the portal's CRM_API_KEY. Fails closed:
# with no token set, the endpoint rejects everything (401).
MEDI_SYNC_TOKEN="replace_me"

# Zoom (Server-to-Server OAuth) — webinar link generation + recordings (ADR 0035)
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_WEBHOOK_SECRET_TOKEN=""
